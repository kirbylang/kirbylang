== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_TRUE
0003    | OP_JUMP_IF_FALSE    3 -> 9
0006    | OP_JUMP             6 -> 11
0009    | OP_POP
0010    | OP_FALSE
0011    | OP_CALL             1
0013    | OP_POP
0014    2 OP_NIL
0015    | OP_RETURN
