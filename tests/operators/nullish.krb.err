== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== should_not_call ==
0000    6 OP_CONSTANT         0 'Should not print'
0002    | OP_PRINT
0003    7 OP_NIL
0004    | OP_RETURN
== returns_nil ==
0000   18 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    7 OP_CLOSURE          1 <fn should_not_call>
0002    | OP_DEFINE_GLOBAL    0 'should_not_call'
0004   19 OP_CLOSURE          3 <fn returns_nil>
0006    | OP_DEFINE_GLOBAL    2 'returns_nil'
0008    1 OP_NIL
0009    | OP_JUMP_IF_NOT_NIL    9 -> 15
0012    | OP_POP
0013    | OP_CONSTANT         4 '123.000000'
0015    | OP_PRINT
0016    2 OP_NIL
0017    | OP_JUMP_IF_NOT_NIL   17 -> 28
0020    | OP_POP
0021    | OP_NIL
0022    | OP_JUMP_IF_NOT_NIL   22 -> 28
0025    | OP_POP
0026    | OP_CONSTANT         5 '456.000000'
0028    | OP_PRINT
0029    3 OP_CONSTANT         6 '789.000000'
0031    | OP_JUMP_IF_NOT_NIL   31 -> 37
0034    | OP_POP
0035    | OP_CONSTANT         7 '0.000000'
0037    | OP_PRINT
0038    9 OP_CONSTANT         8 'Hello World'
0040    | OP_JUMP_IF_NOT_NIL   40 -> 48
0043    | OP_POP
0044    | OP_GET_GLOBAL       9 'should_not_call'
0046    | OP_CALL             0
0048    | OP_PRINT
0049   11 OP_FALSE
0050    | OP_JUMP_IF_NOT_NIL   50 -> 58
0053    | OP_POP
0054    | OP_GET_GLOBAL      10 'should_not_call'
0056    | OP_CALL             0
0058    | OP_JUMP_IF_FALSE   58 -> 68
0061    | OP_POP
0062   12 OP_CONSTANT        11 'True condition met'
0064    | OP_PRINT
0065   13 OP_JUMP            65 -> 72
0068    | OP_POP
0069   14 OP_CONSTANT        12 'False condition met'
0071    | OP_PRINT
0072   21 OP_GET_GLOBAL      13 'returns_nil'
0074    | OP_CALL             0
0076    | OP_JUMP_IF_NOT_NIL   76 -> 81
0079    | OP_POP
0080    | OP_TRUE
0081    | OP_JUMP_IF_FALSE   81 -> 91
0084    | OP_POP
0085   22 OP_CONSTANT        14 'True condition met'
0087    | OP_PRINT
0088   23 OP_JUMP            88 -> 95
0091    | OP_POP
0092   24 OP_CONSTANT        15 'False condition met'
0094    | OP_PRINT
0095   25 OP_NIL
0096    | OP_RETURN
