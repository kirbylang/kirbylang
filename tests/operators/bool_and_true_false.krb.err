== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_TRUE
0003    | OP_JUMP_IF_FALSE    3 -> 8
0006    | OP_POP
0007    | OP_FALSE
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_TRUE
0014    | OP_JUMP_IF_FALSE   14 -> 19
0017    | OP_POP
0018    | OP_FALSE
0019    | OP_CALL             1
0021    | OP_POP
0022    3 OP_NIL
0023    | OP_RETURN
