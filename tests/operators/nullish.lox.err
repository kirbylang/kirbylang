== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== should_not_call ==
0000    6 OP_CONSTANT         0 'Should not print'
0002    | OP_PRINT
0003    7 OP_NIL
0004    | OP_RETURN
== returns_nil ==
0000   18 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_NIL
0001    | OP_JUMP_IF_NOT_NIL    1 -> 7
0004    | OP_POP
0005    | OP_CONSTANT         0 '123.000000'
0007    | OP_PRINT
0008    2 OP_NIL
0009    | OP_JUMP_IF_NOT_NIL    9 -> 20
0012    | OP_POP
