0026    | OP_POP
0027    | OP_CONSTANT         3 '0.000000'
0029    | OP_PRINT
0030    7 OP_CLOSURE          5 <fn should_not_call>
0032    | OP_DEFINE_GLOBAL    4 'should_not_call'
0034    9 OP_CONSTANT         6 'Hello World'
0036    | OP_JUMP_IF_NOT_NIL   36 -> 44
0039    | OP_POP
0040    | OP_GET_GLOBAL       7 'should_not_call'
0042    | OP_CALL             0
0044    | OP_PRINT
0045   11 OP_FALSE
0046    | OP_JUMP_IF_NOT_NIL   46 -> 54
0049    | OP_POP
0050    | OP_GET_GLOBAL       8 'should_not_call'
0052    | OP_CALL             0
0054    | OP_JUMP_IF_FALSE   54 -> 64
0057    | OP_POP
0058   12 OP_CONSTANT         9 'True condition met'
0060    | OP_PRINT
0061   13 OP_JUMP            61 -> 68
0064    | OP_POP
0065   14 OP_CONSTANT        10 'False condition met'
0067    | OP_PRINT
0068   19 OP_CLOSURE         12 <fn returns_nil>
0070    | OP_DEFINE_GLOBAL   11 'returns_nil'
0072   21 OP_GET_GLOBAL      13 'returns_nil'
0074    | OP_CALL             0
0076    | OP_JUMP_IF_NOT_NIL   76 -> 81
0079    | OP_POP
0080    | OP_TRUE
0081    | OP_JUMP_IF_FALSE   81 -> 91
0084    | OP_POP
0085   22 OP_CONSTANT        14 'True condition met'
0087    | OP_PRINT
