== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    3 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       1 'Point'
0006    4 OP_NIL
0007    | OP_FIELD            2 'x' public
0010    5 OP_POP
0011    7 OP_GET_GLOBAL       3 'Point'
0013    8 OP_CLOSURE          5 <fn new>
0015    | OP_METHOD           4 'new'
0017    9 OP_POP
0018   11 OP_GET_GLOBAL       7 'Point'
0020    | OP_CONSTANT         9 '3.000000'
0022    | OP_INVOKE        (1 args)    8 'new'
0025    | OP_DEFINE_GLOBAL    6 'p'
0027   12 OP_GET_GLOBAL      10 'p'
0029    | OP_GET_PROPERTY    11 'x'
0031    | OP_PRINT
0032   13 OP_NIL
0033    | OP_RETURN
== new ==
0000    8 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
