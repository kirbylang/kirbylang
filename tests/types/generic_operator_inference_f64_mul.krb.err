== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          1 <fn mul>
0002    | OP_DEFINE_GLOBAL    0 'mul'
0004    3 OP_GET_GLOBAL       2 'mul'
0006    | OP_CONSTANT         3 '10.000000'
0008    | OP_CONSTANT         4 '20.000000'
0010    | OP_CALL             2
0012    | OP_PRINT
0013    4 OP_NIL
0014    | OP_RETURN
== mul ==
0000    1 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_MULTIPLY
0005    | OP_RETURN
