0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== map ==
0000   14 OP_GET_GLOBAL       0 'Box'
0002    | OP_GET_LOCAL        1
0004    | OP_GET_LOCAL        0
0006    | OP_GET_PROPERTY     2 'value'
