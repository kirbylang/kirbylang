== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000   17 OP_CLOSURE          1 <fn double>
0002    | OP_DEFINE_GLOBAL    0 'double'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       3 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            4 'value' public
0014    3 OP_POP
0015    5 OP_GET_GLOBAL       5 'Box'
0017    6 OP_CLOSURE          7 <fn new>
0019    | OP_METHOD           6 'new'
0021   14 OP_CLOSURE          9 <fn map>
0023    | OP_METHOD           8 'map'
0025   15 OP_POP
0026   19 OP_GET_GLOBAL      11 'Box'
0028    | OP_CONSTANT        13 '5.000000'
0030    | OP_INVOKE        (1 args)   12 'new'
0033    | OP_DEFINE_GLOBAL   10 'box_a'
0035   20 OP_GET_GLOBAL      15 'box_a'
0037    | OP_GET_GLOBAL      17 'double'
0039    | OP_INVOKE        (1 args)   16 'map'
0042    | OP_DEFINE_GLOBAL   14 'box_b'
0044   21 OP_GET_GLOBAL      18 'box_b'
0046    | OP_GET_PROPERTY    19 'value'
0048    | OP_PRINT
0049   22 OP_NIL
0050    | OP_RETURN
== double ==
0000   17 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '2.000000'
0004    | OP_MULTIPLY
0005    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
