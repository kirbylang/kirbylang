trait Display {
    fun toString(self): string;
}

struct Point {
    pub var x: f64;
    pub var y: f64;
}

impl Display for Point {
    pub fun toString(self): string = "Point";
}

impl Eq for Point {
    pub fun equals(self, other: Self): bool = self.x == other.x and self.y == other.y;
}

var a = Point { x: 1, y: 2 };

print a.toString();
print a.equals(a);
