struct Box[T] {
  pub var value: T;
}

impl Box[T] {
  pub fun new(value: T): Self[T] = Self { value: value };

  // `map`'s own generic param `U` is unrelated to the struct's `T`.
  // Calling `map` on an already-instantiated `Box[f64]` substitutes T
  // for f64 in its signature -- U must survive that substitution so the
  // call below still dispatches through generic-call unification instead
  // of a plain (and wrong) structural type-equality check.
  pub fun map[U](self, transform: fun (T) => U): Self[U] =
    Self.new(transform(self.value));
}

fun double(value: f64): f64 = value * 2;

let box_a = Box.new(5);
let box_b = box_a.map(double);
print box_b.value;
