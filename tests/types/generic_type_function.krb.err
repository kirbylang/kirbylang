== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          1 <fn identity>
0002    | OP_DEFINE_GLOBAL    0 'identity'
0004    3 OP_GET_GLOBAL       2 'identity'
0006    | OP_CONSTANT         3 'Hello'
0008    | OP_CONSTANT         4 'World'
0010    | OP_ARRAY            2
0012    | OP_CALL             1
0014    | OP_PRINT
0015    4 OP_NIL
0016    | OP_RETURN
== identity ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
