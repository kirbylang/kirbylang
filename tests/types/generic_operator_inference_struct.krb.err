== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000   10 OP_CLOSURE          1 <fn sum>
0002    | OP_DEFINE_GLOBAL    0 'sum'
0004    1 OP_STRUCT           2 'Vector2'
0006    | OP_DEFINE_GLOBAL    2 'Vector2'
0008    | OP_GET_GLOBAL       3 'Vector2'
0010    2 OP_NIL
0011    | OP_FIELD            4 'x' public
0014    3 OP_POP
0015    5 OP_GET_GLOBAL       5 'Vector2'
0017    6 OP_CLOSURE          7 <fn add>
0019    | OP_METHOD           6 'add'
0021    7 OP_POP
0022    9 OP_GET_GLOBAL       9 'sum'
0024    | OP_GET_GLOBAL      10 'Vector2'
0026    | OP_CONSTANT        11 'x'
0028    | OP_CONSTANT        12 '1.000000'
0030    | OP_STRUCT_INIT      1
0032    | OP_GET_GLOBAL      13 'Vector2'
0034    | OP_CONSTANT        14 'x'
0036    | OP_CONSTANT        15 '2.000000'
0038    | OP_STRUCT_INIT      1
0040    | OP_CALL             2
0042    | OP_DEFINE_GLOBAL    8 'r'
0044   12 OP_GET_GLOBAL      16 'r'
0046    | OP_GET_PROPERTY    17 'x'
0048    | OP_PRINT
0049   13 OP_NIL
0050    | OP_RETURN
== sum ==
0000   10 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
== add ==
0000    6 OP_GET_GLOBAL       0 'Vector2'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        0
0006    | OP_GET_PROPERTY     2 'x'
0008    | OP_GET_LOCAL        1
0010    | OP_GET_PROPERTY     3 'x'
0012    | OP_ADD
0013    | OP_STRUCT_INIT      1
0015    | OP_RETURN
