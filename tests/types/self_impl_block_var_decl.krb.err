== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Struct'
0002    | OP_DEFINE_GLOBAL    0 'Struct'
0004    | OP_GET_GLOBAL       1 'Struct'
0006    2 OP_NIL
0007    | OP_FIELD            2 'value' private
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       3 'Struct'
0013   14 OP_CLOSURE          5 <fn new>
0015    | OP_METHOD           4 'new'
0017   15 OP_POP
0018    | OP_NIL
0019    | OP_RETURN
== new ==
0000    7 OP_GET_GLOBAL       0 'Struct'
0002    8 OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    9 OP_STRUCT_INIT      1
0008   11 OP_GET_LOCAL        2
0010   13 OP_GET_LOCAL        3
0012    | OP_RETURN
