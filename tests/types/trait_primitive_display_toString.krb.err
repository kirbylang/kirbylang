0006    | OP_PRINT
0007    2 OP_GET_GLOBAL       2 '@string.Display.toString'
0009    | OP_CONSTANT         3 'hello'
0011    | OP_CALL             1
0013    | OP_PRINT
0014    3 OP_GET_GLOBAL       4 '@bool.Display.toString'
0016    | OP_TRUE
