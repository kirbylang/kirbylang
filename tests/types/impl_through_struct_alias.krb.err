== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       1 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            2 'x' public
0010    3 OP_POP
0011    7 OP_GET_GLOBAL       3 'Point'
0013    8 OP_CLOSURE          5 <fn getX>
0015    | OP_METHOD           4 'getX'
0017    9 OP_POP
0018   11 OP_GET_GLOBAL       7 'Point'
0020    | OP_CONSTANT         8 'x'
0022    | OP_CONSTANT         9 '42.000000'
0024    | OP_STRUCT_INIT      1
0026    | OP_DEFINE_GLOBAL    6 'p'
0028   12 OP_GET_GLOBAL      10 'p'
0030    | OP_INVOKE        (0 args)   11 'getX'
0033    | OP_PRINT
0034   13 OP_NIL
0035    | OP_RETURN
== getX ==
0000    8 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_RETURN
