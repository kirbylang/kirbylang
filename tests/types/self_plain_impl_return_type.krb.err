== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Struct'
0002    | OP_DEFINE_GLOBAL    0 'Struct'
0004    | OP_GET_GLOBAL       0 'Struct'
0006    3 OP_POP
0007    5 OP_GET_GLOBAL       0 'Struct'
0009    6 OP_CLOSURE          2 <fn new>
0011    | OP_METHOD           1 'new'
0013    7 OP_POP
0014    9 OP_GET_GLOBAL       0 'Struct'
0016    | OP_INVOKE        (0 args)    1 'new'
0019    | OP_DEFINE_GLOBAL    3 's'
0021   10 OP_GET_GLOBAL       3 's'
0023    | OP_PRINT
0024   11 OP_NIL
0025    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Struct'
0002    | OP_STRUCT_INIT      0
0004    | OP_RETURN
