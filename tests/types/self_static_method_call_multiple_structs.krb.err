0013    | OP_DEFINE_GLOBAL    2 'Bag'
0015    | OP_GET_GLOBAL       2 'Bag'
0017   11 OP_NIL
0018    | OP_FIELD            3 'items' public
0021   12 OP_POP
0022    5 OP_GET_GLOBAL       0 'Box'
0024    6 OP_CLOSURE          5 <fn wrap>
0026    | OP_METHOD           4 'wrap'
0028    7 OP_CLOSURE          7 <fn zero>
0030    | OP_METHOD           6 'zero'
0032    8 OP_POP
0033   14 OP_GET_GLOBAL       2 'Bag'
0035   15 OP_CLOSURE          9 <fn of>
0037    | OP_METHOD           8 'of'
0039   16 OP_CLOSURE         11 <fn empty>
0041    | OP_METHOD          10 'empty'
0043   17 OP_POP
0044   19 OP_GET_GLOBAL       0 'Box'
0046    | OP_INVOKE        (0 args)    6 'zero'
0049    | OP_DEFINE_GLOBAL   12 'b1'
0051   20 OP_GET_GLOBAL       2 'Bag'
0053    | OP_INVOKE        (0 args)   10 'empty'
0056    | OP_DEFINE_GLOBAL   13 'b2'
