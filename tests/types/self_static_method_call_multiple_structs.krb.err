== wrap ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== zero ==
0000    7 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         2 '0'
0004    | OP_INVOKE        (1 args)    1 'wrap'
0007    | OP_RETURN
== of ==
0000   15 OP_GET_GLOBAL       0 'Bag'
0002    | OP_CONSTANT         1 'items'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== empty ==
0000   16 OP_GET_GLOBAL       0 'Bag'
