struct Vector2 {
    pub var x: f64;
    pub var y: f64;
}

impl Add for Vector2 {
    pub fun add(self, other: Vector2): Vector2 =
        Vector2 { x: self.x + other.x, y: self.y + other.y };
}

var a = Vector2 { x: 1.0, y: 2.0 };
var b = Vector2 { x: 3.0, y: 4.0 };
var c = a + b;
print c.x;
print c.y;
