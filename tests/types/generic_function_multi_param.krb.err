== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          1 <fn first>
0002    | OP_DEFINE_GLOBAL    0 'first'
0004    2 OP_GET_GLOBAL       2 'first'
0006    | OP_CONSTANT         3 '1.000000'
0008    | OP_CONSTANT         4 'two'
0010    | OP_CALL             2
0012    | OP_PRINT
0013    3 OP_NIL
0014    | OP_RETURN
== first ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
