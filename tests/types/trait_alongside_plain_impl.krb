trait Display {
    fun toString(self): string;
}

struct Counter {
    pub var count: f64;
}

impl Counter {
    pub fun increment(self): unit {
        self.count = self.count + 1;
    }
}

impl Display for Counter {
    pub fun toString(self): string = "Counter";
}

var c = Counter { count: 0 };
c.increment();
c.increment();

print c.count;
print c.toString();
