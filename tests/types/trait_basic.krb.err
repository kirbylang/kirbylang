== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       1 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            2 'x' public
0010    3 OP_NIL
0011    | OP_FIELD            3 'y' public
0014    4 OP_POP
0015    6 OP_GET_GLOBAL       4 'Point'
0017    7 OP_CLOSURE          6 <fn toString>
0019    | OP_METHOD           5 'toString'
0021    8 OP_POP
0022   10 OP_GET_GLOBAL       8 'Point'
0024    | OP_CONSTANT         9 'x'
0026    | OP_CONSTANT        10 '1.000000'
0028    | OP_CONSTANT        11 'y'
0030    | OP_CONSTANT        12 '2.000000'
0032    | OP_STRUCT_INIT      2
0034    | OP_DEFINE_GLOBAL    7 'p'
0036   11 OP_GET_GLOBAL      13 'p'
0038    | OP_INVOKE        (0 args)   14 'toString'
0041    | OP_PRINT
0042   12 OP_NIL
0043    | OP_RETURN
== toString ==
0000    7 OP_CONSTANT         0 'Point'
0002    | OP_RETURN
