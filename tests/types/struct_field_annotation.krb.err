== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       1 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            2 'x' public
0010    3 OP_NIL
0011    | OP_FIELD            3 'y' public
0014    4 OP_POP
0015    6 OP_GET_GLOBAL       4 'Point'
0017    7 OP_CLOSURE          6 <fn new>
0019    | OP_METHOD           5 'new'
0021    8 OP_POP
0022   10 OP_GET_GLOBAL       8 'Point'
0024    | OP_CONSTANT        10 '1.000000'
0026    | OP_CONSTANT        11 '2.000000'
0028    | OP_INVOKE        (2 args)    9 'new'
0031    | OP_DEFINE_GLOBAL    7 'p'
0033   11 OP_GET_GLOBAL      12 'p'
0035    | OP_GET_PROPERTY    13 'x'
0037    | OP_PRINT
0038   12 OP_GET_GLOBAL      14 'p'
0040    | OP_GET_PROPERTY    15 'y'
0042    | OP_PRINT
0043   13 OP_NIL
0044    | OP_RETURN
== new ==
0000    7 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_CONSTANT         2 'y'
0008    | OP_GET_LOCAL        2
0010    | OP_STRUCT_INIT      2
0012    | OP_RETURN
