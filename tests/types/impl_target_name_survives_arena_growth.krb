struct Point {
  pub var x: f64;
  pub var y: f64;
}

impl Point {
  pub fun new(x: f64, y: f64): Self = Self { x: x, y: y };
}

impl Display for Point {
  fun toString(self): string = "(" + numberToString(self.x) + "," + numberToString(self.y) + ")";
}

impl Eq for Point {
  fun equals(self, other: Self): bool = self.x == other.x;
}

impl Default for Point {
  fun default(): Self = Self { x: 0, y: 0 };
}

