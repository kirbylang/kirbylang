fun branches(condition: bool): f64 {
    if (condition) {
        return 1;
    } else {
        return 2;
    }
}

fun trailingValue(): f64 {
    let doubled = 2 * 2;
    doubled
}

fun afterALoop(): string {
    for (var i = 0; i < 3; i = i + 1) {
        @println(i);
    }

    return "done";
}

fun returnsUnit(): unit {
    @println("nothing to return");
}

@println(branches(true));
@println(branches(false));
@println(trailingValue());
@println(afterALoop());
returnsUnit();
