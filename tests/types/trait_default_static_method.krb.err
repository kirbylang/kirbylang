== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' public
0010    3 OP_NIL
0011    | OP_FIELD            2 'y' public
0014    4 OP_POP
0015    6 OP_GET_GLOBAL       0 'Point'
0017    7 OP_CLOSURE          4 <fn default>
0019    | OP_METHOD           3 'default'
0021    8 OP_POP
0022   10 OP_GET_GLOBAL       0 'Point'
0024    | OP_INVOKE        (0 args)    3 'default'
0027    | OP_DEFINE_GLOBAL    5 'origin'
0029   11 OP_GET_GLOBAL       6 '@println'
0031    | OP_GET_GLOBAL       5 'origin'
0033    | OP_GET_PROPERTY     1 'x'
0035    | OP_CALL             1
0037    | OP_POP
0038   12 OP_GET_GLOBAL       6 '@println'
0040    | OP_GET_GLOBAL       5 'origin'
0042    | OP_GET_PROPERTY     2 'y'
0044    | OP_CALL             1
0046    | OP_POP
0047   13 OP_NIL
0048    | OP_RETURN
== default ==
0000    7 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_CONSTANT         2 '0'
0006    | OP_CONSTANT         3 'y'
0008    | OP_CONSTANT         2 '0'
0010    | OP_STRUCT_INIT      2
0012    | OP_RETURN
