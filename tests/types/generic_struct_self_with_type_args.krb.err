== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Box'
0002    | OP_DEFINE_GLOBAL    0 'Box'
0004    | OP_GET_GLOBAL       1 'Box'
0006    2 OP_NIL
0007    | OP_FIELD            2 'value' public
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       3 'Box'
0013   10 OP_CLOSURE          5 <fn new>
0015    | OP_METHOD           4 'new'
0017   11 OP_POP
0018   13 OP_GET_GLOBAL       7 'Box'
0020    | OP_CONSTANT         9 '5.000000'
0022    | OP_INVOKE        (1 args)    8 'new'
0025    | OP_DEFINE_GLOBAL    6 'b'
0027   14 OP_GET_GLOBAL      10 'b'
0029    | OP_GET_PROPERTY    11 'value'
0031    | OP_PRINT
0032   15 OP_NIL
0033    | OP_RETURN
== new ==
0000    8 OP_GET_GLOBAL       0 'Box'
0002    9 OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006   10 OP_STRUCT_INIT      1
0008    | OP_RETURN
