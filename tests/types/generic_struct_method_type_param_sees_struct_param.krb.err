== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Box'
0002    | OP_DEFINE_GLOBAL    0 'Box'
0004    | OP_GET_GLOBAL       1 'Box'
0006    2 OP_NIL
0007    | OP_FIELD            2 'value' public
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       3 'Box'
0013    6 OP_CLOSURE          5 <fn get>
0015    | OP_METHOD           4 'get'
0017   10 OP_CLOSURE          7 <fn echo>
0019    | OP_METHOD           6 'echo'
0021   11 OP_POP
0022   13 OP_GET_GLOBAL       9 'Box'
0024    | OP_CONSTANT        10 'value'
0026    | OP_CONSTANT        11 '5.000000'
0028    | OP_STRUCT_INIT      1
0030    | OP_DEFINE_GLOBAL    8 'b'
0032   14 OP_GET_GLOBAL      12 'b'
0034    | OP_INVOKE        (0 args)   13 'get'
0037    | OP_PRINT
0038   15 OP_NIL
0039    | OP_RETURN
== get ==
0000    6 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
== echo ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
