== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    7 OP_CLOSURE          1 <fn add>
0002    | OP_DEFINE_GLOBAL    0 'add'
0004    3 OP_CONSTANT         3 '5.000000'
0006    | OP_DEFINE_GLOBAL    2 'x'
0008    5 OP_GET_GLOBAL       4 'x'
0010    | OP_PRINT
0011    9 OP_GET_GLOBAL       5 'add'
0013    | OP_CONSTANT         6 '1.000000'
0015    | OP_CONSTANT         7 '2.000000'
0017    | OP_CALL             2
0019    | OP_PRINT
0020   10 OP_NIL
0021    | OP_RETURN
== add ==
0000    7 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
