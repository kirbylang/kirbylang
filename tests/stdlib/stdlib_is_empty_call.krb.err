== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strIsEmpty'
0004    | OP_CONSTANT         2 ''
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 '@strIsEmpty'
0015    | OP_CONSTANT         3 'Hello World'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    3 OP_NIL
0023    | OP_RETURN
