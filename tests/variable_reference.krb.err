0006    | OP_DEFINE_GLOBAL    2 'name'
0008    4 OP_GET_GLOBAL       4 '@strConcat'
0010    | OP_GET_GLOBAL       0 'greeting'
0012    | OP_CONSTANT         5 ' '
0014    | OP_GET_GLOBAL       2 'name'
