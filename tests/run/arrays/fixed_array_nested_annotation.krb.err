== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_ARRAY            2
0010    | OP_CONSTANT         5 '3'
0012    | OP_CONSTANT         6 '4'
0014    | OP_ARRAY            2
0016    | OP_ARRAY            2
0018    | OP_DEFINE_GLOBAL    2 'm'
0020    3 OP_NIL
0021    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'm'
0004    | OP_CONSTANT         2 '1'
0006    | OP_GET_INDEX
0007    | OP_CONSTANT         2 '1'
0009    | OP_GET_INDEX
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
