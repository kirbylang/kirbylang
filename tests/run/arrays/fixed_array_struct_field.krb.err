== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Grid'
0006    | OP_DEFINE_GLOBAL    2 'Grid'
0008    | OP_GET_GLOBAL       2 'Grid'
0010    2 OP_NIL
0011    | OP_FIELD            3 'cells' public mutable
0015    3 OP_POP
0016    4 OP_GET_GLOBAL       2 'Grid'
0018    | OP_CONSTANT         3 'cells'
0020    | OP_CONSTANT         5 '4'
0022    | OP_CONSTANT         6 '5'
0024    | OP_ARRAY            2
0026    | OP_STRUCT_INIT      1
0028    | OP_DEFINE_GLOBAL    4 'g'
0030    7 OP_NIL
0031    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 'g'
0002    | OP_GET_PROPERTY     1 'cells'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '6'
0008    | OP_SET_INDEX
0009    | OP_POP
0010    6 OP_GET_GLOBAL       4 '@println'
0012    | OP_GET_GLOBAL       0 'g'
0014    | OP_GET_PROPERTY     1 'cells'
0016    | OP_CALL             1
0018    | OP_POP
0019    | OP_NIL
0020    | OP_RETURN
