== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_ARRAY            2
0010    | OP_CONSTANT         5 '3'
0012    | OP_CONSTANT         6 '4'
0014    | OP_ARRAY            2
0016    | OP_ARRAY            2
0018    | OP_DEFINE_GLOBAL    2 'm'
0020    6 OP_NIL
0021    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 'm'
0002    | OP_CONSTANT         1 '0'
0004    | OP_GET_INDEX
0005    | OP_CONSTANT         2 '1'
0007    | OP_CONSTANT         3 '9'
0009    | OP_SET_INDEX
0010    | OP_POP
0011    3 OP_GET_GLOBAL       4 '@println'
0013    | OP_GET_GLOBAL       0 'm'
0015    | OP_CONSTANT         1 '0'
0017    | OP_GET_INDEX
0018    | OP_CONSTANT         2 '1'
0020    | OP_GET_INDEX
0021    | OP_CALL             1
0023    | OP_POP
0024    4 OP_GET_GLOBAL       4 '@println'
0026    | OP_GET_GLOBAL       0 'm'
0028    | OP_CONSTANT         2 '1'
0030    | OP_GET_INDEX
0031    | OP_CONSTANT         1 '0'
0033    | OP_GET_INDEX
0034    | OP_CALL             1
0036    | OP_POP
0037    5 OP_GET_GLOBAL       4 '@println'
0039    | OP_GET_GLOBAL       0 'm'
0041    | OP_CALL             1
0043    | OP_POP
0044    | OP_NIL
0045    | OP_RETURN
