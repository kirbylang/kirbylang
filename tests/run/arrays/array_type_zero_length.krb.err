== <script> ==
0000    1 OP_CLOSURE          1 <fn f>
0002    | OP_DEFINE_GLOBAL    0 'f'
0004    2 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    3 OP_NIL
0009    | OP_RETURN
== f ==
0000    1 OP_NIL
0001    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'ok'
0004    | OP_CALL             1
0006    | OP_POP
0007    | OP_NIL
0008    | OP_RETURN
