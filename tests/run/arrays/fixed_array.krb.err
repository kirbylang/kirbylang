== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    5 OP_NIL
0015    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 'a'
0002    | OP_CONSTANT         1 '0'
0004    | OP_CONSTANT         2 '9'
0006    | OP_SET_INDEX
0007    | OP_POP
0008    3 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_GLOBAL       0 'a'
0012    | OP_CONSTANT         1 '0'
0014    | OP_GET_INDEX
0015    | OP_CALL             1
0017    | OP_POP
0018    4 OP_GET_GLOBAL       3 '@println'
0020    | OP_GET_GLOBAL       0 'a'
0022    | OP_CALL             1
0024    | OP_POP
0025    | OP_NIL
0026    | OP_RETURN
