0016    | OP_SET_INDEX
0017    | OP_POP
0018    3 OP_GET_GLOBAL       6 '@println'
0020    | OP_GET_GLOBAL       0 'a'
0022    | OP_CONSTANT         4 '0'
0024    | OP_GET_INDEX
