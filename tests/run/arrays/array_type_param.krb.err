== <script> ==
0000    3 OP_CLOSURE          1 <fn first>
0002    | OP_DEFINE_GLOBAL    0 'first'
0004    4 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    5 OP_NIL
0009    | OP_RETURN
== first ==
0000    2 OP_CONSTANT         0 '0'
0002    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'ok'
0004    | OP_CALL             1
0006    | OP_POP
0007    | OP_NIL
0008    | OP_RETURN
