== <script> ==
0000    3 OP_CLOSURE          1 <fn first>
0002    | OP_DEFINE_GLOBAL    0 'first'
0004    4 OP_GET_GLOBAL       2 '@println'
0006    | OP_CONSTANT         3 'ok'
0008    | OP_CALL             1
0010    | OP_POP
0011    5 OP_NIL
0012    | OP_RETURN
== first ==
0000    2 OP_CONSTANT         0 '0'
0002    | OP_RETURN
