== <script> ==
0000    3 OP_CLOSURE          1 <fn f>
0002    | OP_DEFINE_GLOBAL    0 'f'
0004    6 OP_CLOSURE          3 <fn g>
0006    | OP_DEFINE_GLOBAL    2 'g'
0008    7 OP_GET_GLOBAL       4 '@println'
0010    | OP_CONSTANT         5 'ok'
0012    | OP_CALL             1
0014    | OP_POP
0015    8 OP_NIL
0016    | OP_RETURN
== f ==
0000    2 OP_GET_LOCAL        1
0002    | OP_RETURN
== g ==
0000    5 OP_GET_GLOBAL       0 'f'
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
