== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    9 OP_NIL
0015    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@arrReverse'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CALL             1
0006    3 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_LOCAL        1
0010    | OP_CONSTANT         3 '0'
0012    | OP_GET_INDEX
0013    | OP_CALL             1
0015    | OP_POP
0016    4 OP_GET_GLOBAL       2 '@println'
0018    | OP_GET_GLOBAL       4 '@arrContains'
0020    | OP_GET_GLOBAL       1 'a'
0022    | OP_CONSTANT         5 '2'
0024    | OP_CALL             2
0026    | OP_CALL             1
0028    | OP_POP
0029    5 OP_GET_GLOBAL       2 '@println'
0031    | OP_GET_GLOBAL       6 '@arrEqual'
0033    | OP_GET_GLOBAL       1 'a'
0035    | OP_GET_LOCAL        1
0037    | OP_CALL             2
0039    | OP_CALL             1
0041    | OP_POP
0042    6 OP_GET_GLOBAL       7 '@arrToList'
0044    | OP_GET_GLOBAL       1 'a'
0046    | OP_CALL             1
0048    7 OP_GET_GLOBAL       8 '@listPush'
0050    | OP_GET_LOCAL        2
0052    | OP_CONSTANT         9 '4'
0054    | OP_CALL             2
0056    | OP_POP
0057    8 OP_GET_GLOBAL       2 '@println'
0059    | OP_GET_GLOBAL      10 '@listLen'
0061    | OP_GET_LOCAL        2
0063    | OP_CALL             1
0065    | OP_CALL             1
0067    | OP_POP
0068    | OP_NIL
0069    | OP_RETURN
