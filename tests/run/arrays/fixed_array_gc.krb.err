== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'keep'
0014    7 OP_NIL
0015    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         0 '0'
0002    | OP_GET_LOCAL        1
0004    | OP_CONSTANT         1 '10000'
0006    | OP_LESS
0007    | OP_JUMP_IF_FALSE    7 -> 58
0010    | OP_POP
0011    | OP_JUMP            11 -> 25
0014    | OP_GET_LOCAL        1
0016    | OP_CONSTANT         2 '1'
0018    | OP_ADD
0019    | OP_SET_LOCAL        1
0021    | OP_POP
0022    | OP_LOOP            22 -> 2
0025    3 OP_GET_LOCAL        1
0027    | OP_GET_LOCAL        1
0029    | OP_GET_LOCAL        1
0031    | OP_ARRAY            3
0033    4 OP_GET_LOCAL        2
0035    | OP_CONSTANT         0 '0'
0037    | OP_GET_INDEX
0038    | OP_CONSTANT         2 '1'
0040    | OP_ARRAY            2
0042    | OP_GET_LOCAL        2
0044    | OP_CONSTANT         2 '1'
0046    | OP_GET_INDEX
0047    | OP_CONSTANT         3 '2'
0049    | OP_ARRAY            2
0051    | OP_ARRAY            2
0053    5 OP_POP
0054    | OP_POP
0055    | OP_LOOP            55 -> 14
0058    | OP_POP
0059    | OP_POP
0060    6 OP_GET_GLOBAL       4 '@println'
0062    | OP_GET_GLOBAL       5 'keep'
0064    | OP_CALL             1
0066    | OP_POP
0067    | OP_NIL
0068    | OP_RETURN
