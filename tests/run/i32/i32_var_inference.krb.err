== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '123'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    2 OP_CONSTANT         5 '2147483647'
0010    | OP_DEFINE_GLOBAL    4 'max'
0012    5 OP_NIL
0013    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CALL             1
0006    | OP_POP
0007    4 OP_GET_GLOBAL       0 '@println'
0009    | OP_GET_GLOBAL       2 'max'
0011    | OP_CALL             1
0013    | OP_POP
0014    | OP_NIL
0015    | OP_RETURN
