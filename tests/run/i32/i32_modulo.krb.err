== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    6 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '7'
0004    | OP_CONSTANT         2 '3'
0006    | OP_MODULO
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_CONSTANT         3 '10'
0012    | OP_NEGATE
0013    | OP_CAST          i32
0015    3 OP_GET_GLOBAL       0 '@println'
0017    | OP_GET_LOCAL        1
0019    | OP_CONSTANT         2 '3'
0021    | OP_MODULO
0022    | OP_CALL             1
0024    | OP_POP
0025    4 OP_CONSTANT         4 '2147483648'
0027    | OP_NEGATE
0028    | OP_CAST          i32
0030    5 OP_GET_GLOBAL       0 '@println'
0032    | OP_GET_LOCAL        2
0034    | OP_CONSTANT         1 '7'
0036    | OP_MODULO
0037    | OP_CALL             1
0039    | OP_POP
0040    | OP_NIL
0041    | OP_RETURN
