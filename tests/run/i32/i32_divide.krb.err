== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '7'
0004    | OP_CONSTANT         2 '2'
0006    | OP_DIVIDE
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_CONSTANT         3 '10'
0012    | OP_NEGATE
0013    | OP_CAST          i32
0015    3 OP_GET_GLOBAL       0 '@println'
0017    | OP_GET_LOCAL        1
0019    | OP_CONSTANT         4 '3'
0021    | OP_DIVIDE
0022    | OP_CALL             1
0024    | OP_POP
0025    4 OP_CONSTANT         5 '2147483648'
0027    | OP_NEGATE
0028    | OP_CAST          i32
0030    5 OP_CONSTANT         6 '1'
0032    | OP_NEGATE
0033    | OP_CAST          i32
0035    6 OP_GET_GLOBAL       0 '@println'
0037    | OP_GET_LOCAL        2
0039    | OP_GET_LOCAL        3
0041    | OP_MODULO
0042    | OP_CALL             1
0044    | OP_POP
0045    | OP_NIL
0046    | OP_RETURN
