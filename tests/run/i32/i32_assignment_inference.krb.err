== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_DEFINE_GLOBAL    2 'x'
0008    4 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         1 '2147483647'
0002    | OP_SET_GLOBAL       0 'x'
0004    | OP_POP
0005    3 OP_GET_GLOBAL       2 '@println'
0007    | OP_GET_GLOBAL       0 'x'
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
