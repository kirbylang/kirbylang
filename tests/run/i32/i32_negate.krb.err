== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '7'
0006    | OP_DEFINE_GLOBAL    2 'y'
0008    9 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'y'
0004    | OP_NEGATE
0005    | OP_CALL             1
0007    | OP_POP
0008    4 OP_CONSTANT         2 '-2147483647'
0010    5 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_LOCAL        1
0014    | OP_NEGATE
0015    | OP_CALL             1
0017    | OP_POP
0018    7 OP_GET_GLOBAL       1 'y'
0020    | OP_CONSTANT         3 '1'
0022    | OP_ADD
0023    | OP_NEGATE
0024    8 OP_GET_GLOBAL       0 '@println'
0026    | OP_GET_LOCAL        2
0028    | OP_CALL             1
0030    | OP_POP
0031    | OP_NIL
0032    | OP_RETURN
