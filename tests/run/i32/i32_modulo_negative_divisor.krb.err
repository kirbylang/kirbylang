== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_CONSTANT         0 '2147483648'
0002    | OP_NEGATE
0003    | OP_CAST          i32
0005    2 OP_CONSTANT         1 '1'
0007    | OP_NEGATE
0008    | OP_CAST          i32
0010    3 OP_CONSTANT         2 '2'
0012    | OP_NEGATE
0013    | OP_CAST          i32
0015    4 OP_GET_GLOBAL       3 '@println'
0017    | OP_GET_LOCAL        1
0019    | OP_GET_LOCAL        2
0021    | OP_MODULO
0022    | OP_CALL             1
0024    | OP_POP
0025    5 OP_GET_GLOBAL       3 '@println'
0027    | OP_CONSTANT         4 '7'
0029    | OP_GET_LOCAL        3
0031    | OP_MODULO
0032    | OP_CALL             1
0034    | OP_POP
0035    6 OP_GET_GLOBAL       3 '@println'
0037    | OP_CONSTANT         4 '7'
0039    | OP_GET_LOCAL        3
0041    | OP_DIVIDE
0042    | OP_CALL             1
0044    | OP_POP
0045    | OP_NIL
0046    | OP_RETURN
