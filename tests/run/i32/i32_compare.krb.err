== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '5'
0004    | OP_CONSTANT         2 '10'
0006    | OP_LESS
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       0 '@println'
0012    | OP_CONSTANT         2 '10'
0014    | OP_CONSTANT         1 '5'
0016    | OP_LESS
0017    | OP_CALL             1
0019    | OP_POP
0020    3 OP_GET_GLOBAL       0 '@println'
0022    | OP_CONSTANT         3 '200'
0024    | OP_CONSTANT         4 '100'
0026    | OP_GREATER
0027    | OP_CALL             1
0029    | OP_POP
0030    4 OP_GET_GLOBAL       0 '@println'
0032    | OP_CONSTANT         1 '5'
0034    | OP_CONSTANT         1 '5'
0036    | OP_LESS_EQUAL
0037    | OP_CALL             1
0039    | OP_POP
0040    5 OP_GET_GLOBAL       0 '@println'
0042    | OP_CONSTANT         5 '6'
0044    | OP_CONSTANT         6 '7'
0046    | OP_GREATER_EQUAL
0047    | OP_CALL             1
0049    | OP_POP
0050    6 OP_GET_GLOBAL       0 '@println'
0052    | OP_CONSTANT         5 '6'
0054    | OP_CONSTANT         5 '6'
0056    | OP_GREATER_EQUAL
0057    | OP_CALL             1
0059    | OP_POP
0060    | OP_NIL
0061    | OP_RETURN
