== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '-5'
0006    | OP_DEFINE_GLOBAL    2 'x'
0008    9 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'x'
0004    | OP_CALL             1
0006    | OP_POP
0007    4 OP_CONSTANT         2 '-2147483648'
0009    5 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_LOCAL        1
0013    | OP_CALL             1
0015    | OP_POP
0016    7 OP_CONSTANT         3 '3'
0018    8 OP_GET_GLOBAL       0 '@println'
0020    | OP_GET_GLOBAL       4 '@typeof'
0022    | OP_GET_LOCAL        2
0024    | OP_NEGATE
0025    | OP_CALL             1
0027    | OP_CALL             1
0029    | OP_POP
0030    | OP_NIL
0031    | OP_RETURN
