== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    3 OP_CLOSURE          1 <fn gt>
0002    | OP_DEFINE_GLOBAL    0 'gt'
0004    5 OP_GET_GLOBAL       0 'gt'
0006    | OP_CONSTANT         3 '3'
0008    | OP_CALL             1
0010    | OP_DEFINE_GLOBAL    2 'greaterThanThree'
0012    7 OP_GET_GLOBAL       4 '@println'
0014    | OP_GET_GLOBAL       2 'greaterThanThree'
0016    | OP_CONSTANT         5 '5'
0018    | OP_CALL             1
0020    | OP_CALL             1
0022    | OP_POP
0023    8 OP_GET_GLOBAL       4 '@println'
0025    | OP_GET_GLOBAL       2 'greaterThanThree'
0027    | OP_CONSTANT         6 '1'
0029    | OP_CALL             1
0031    | OP_CALL             1
0033    | OP_POP
0034    9 OP_NIL
0035    | OP_RETURN
== gt ==
0000    2 OP_CLOSURE          0 <fn lambda0x1>
0002      |                     local 1
0004    | OP_RETURN
== lambda0x1 ==
0000    2 OP_GET_LOCAL        1
0002    | OP_GET_UPVALUE      0
0004    | OP_GREATER
0005    | OP_RETURN
