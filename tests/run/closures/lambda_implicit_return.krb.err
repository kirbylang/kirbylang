== <script> ==
0000    3 OP_CLOSURE          1 <fn gt>
0002    | OP_DEFINE_GLOBAL    0 'gt'
0004    8 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    9 OP_NIL
0009    | OP_RETURN
== gt ==
0000    2 OP_CLOSURE          0 <fn lambda0x1>
0002      |                     local 1
0004    | OP_RETURN
== lambda0x1 ==
0000    2 OP_GET_LOCAL        1
0002    | OP_GET_UPVALUE      0
0004    | OP_GREATER
0005    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 'gt'
0002    | OP_CONSTANT         1 '3'
0004    | OP_CALL             1
0006    7 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_LOCAL        1
0010    | OP_CONSTANT         3 '5'
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017    8 OP_GET_GLOBAL       2 '@println'
0019    | OP_GET_LOCAL        1
0021    | OP_CONSTANT         4 '1'
0023    | OP_CALL             1
0025    | OP_CALL             1
0027    | OP_POP
0028    | OP_NIL
0029    | OP_RETURN
