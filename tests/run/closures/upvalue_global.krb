var globalSet: fun () => unit = fun (): unit {};
var globalGet: fun () => unit = fun (): unit {};

fun setup(): unit {
  var a = "initial";

  fun set(): unit { a = "updated"; }
  fun get(): unit { @println(a); }

  globalSet = set;
  globalGet = get;
}

fun main(): unit {
  setup();
  globalSet();
  globalGet();
}
