== <script> ==
0000    7 OP_CLOSURE          1 <fn outer>
0002    | OP_DEFINE_GLOBAL    0 'outer'
0004    8 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    9 OP_NIL
0009    | OP_RETURN
== outer ==
0000    2 OP_CONSTANT         0 'outside'
0002    5 OP_CLOSURE          1 <fn inner>
0004      |                     local 1
0006    6 OP_GET_LOCAL        2
0008    | OP_CALL             0
0010    | OP_POP
0011    7 OP_NIL
0012    | OP_RETURN
== inner ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_UPVALUE      0
0004    | OP_CALL             1
0006    | OP_POP
0007    5 OP_NIL
0008    | OP_RETURN
== main ==
0000    8 OP_GET_GLOBAL       0 'outer'
0002    | OP_CALL             0
0004    | OP_POP
0005    | OP_NIL
0006    | OP_RETURN
