== <script> ==
0000    9 OP_CLOSURE          1 <fn outer>
0002    | OP_DEFINE_GLOBAL    0 'outer'
0004   11 OP_GET_GLOBAL       0 'outer'
0006    | OP_CALL             0
0008    | OP_DEFINE_GLOBAL    2 'inner'
0010   13 OP_GET_GLOBAL       3 '@println'
0012    | OP_GET_GLOBAL       2 'inner'
0014    | OP_CALL             0
0016    | OP_CALL             1
0018    | OP_POP
0019   14 OP_NIL
0020    | OP_RETURN
== outer ==
0000    2 OP_CONSTANT         0 '123'
0002    6 OP_CLOSURE          1 <fn inner>
0004      |                     local 1
0006    8 OP_GET_LOCAL        2
0008    | OP_RETURN
== inner ==
0000    5 OP_GET_UPVALUE      0
0002    | OP_RETURN
