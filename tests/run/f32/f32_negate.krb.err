== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '2.5'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_NEGATE
0005    | OP_CALL             1
0007    | OP_POP
0008    3 OP_GET_GLOBAL       0 '@println'
0010    | OP_GET_GLOBAL       2 '@typeof'
0012    | OP_GET_GLOBAL       1 'a'
0014    | OP_NEGATE
0015    | OP_CALL             1
0017    | OP_CALL             1
0019    | OP_POP
0020    4 OP_CONSTANT         3 '0'
0022    5 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_LOCAL        1
0026    | OP_NEGATE
0027    | OP_CALL             1
0029    | OP_POP
0030    | OP_NIL
0031    | OP_RETURN
