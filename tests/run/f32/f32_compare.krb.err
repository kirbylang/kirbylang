== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '0.1'
0004    | OP_CONSTANT         2 '0.2'
0006    | OP_LESS
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       0 '@println'
0012    | OP_CONSTANT         2 '0.2'
0014    | OP_CONSTANT         1 '0.1'
0016    | OP_LESS
0017    | OP_CALL             1
0019    | OP_POP
0020    3 OP_GET_GLOBAL       0 '@println'
0022    | OP_CONSTANT         1 '0.1'
0024    | OP_CONSTANT         1 '0.1'
0026    | OP_EQUAL
0027    | OP_CALL             1
0029    | OP_POP
0030    4 OP_GET_GLOBAL       0 '@println'
0032    | OP_CONSTANT         1 '0.1'
0034    | OP_CONSTANT         2 '0.2'
0036    | OP_GREATER
0037    | OP_CALL             1
0039    | OP_POP
0040    5 OP_GET_GLOBAL       0 '@println'
0042    | OP_CONSTANT         1 '0.1'
0044    | OP_CONSTANT         1 '0.1'
0046    | OP_GREATER_EQUAL
0047    | OP_CALL             1
0049    | OP_POP
0050    6 OP_GET_GLOBAL       0 '@println'
0052    | OP_CONSTANT         1 '0.1'
0054    | OP_CONSTANT         1 '0.1'
0056    | OP_CONSTANT         3 '0'
0058    | OP_ADD
0059    | OP_EQUAL
0060    | OP_CALL             1
0062    | OP_POP
0063    | OP_NIL
0064    | OP_RETURN
