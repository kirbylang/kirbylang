== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1.5'
0006    | OP_DEFINE_GLOBAL    2 'x'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'x'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '2'
0008    | OP_ADD
0009    | OP_ADD
0010    | OP_CALL             1
0012    | OP_POP
0013    4 OP_GET_GLOBAL       0 '@println'
0015    | OP_GET_GLOBAL       4 '@typeof'
0017    | OP_GET_GLOBAL       1 'x'
0019    | OP_CONSTANT         3 '2'
0021    | OP_CONSTANT         2 '1'
0023    | OP_SUBTRACT
0024    | OP_MULTIPLY
0025    | OP_CALL             1
0027    | OP_CALL             1
0029    | OP_POP
0030    5 OP_GET_GLOBAL       0 '@println'
0032    | OP_CONSTANT         5 '10'
0034    | OP_CONSTANT         6 '4'
0036    | OP_DIVIDE
0037    | OP_GET_GLOBAL       1 'x'
0039    | OP_ADD
0040    | OP_CALL             1
0042    | OP_POP
0043    | OP_NIL
0044    | OP_RETURN
