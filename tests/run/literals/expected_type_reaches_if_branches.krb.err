== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   13 OP_CLOSURE          3 <fn pick>
0006    | OP_DEFINE_GLOBAL    2 'pick'
0008    1 OP_TRUE
0009    | OP_DEFINE_GLOBAL    4 'wide'
0011   14 OP_NIL
0012    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'wide'
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    | OP_CONSTANT         1 '1'
0008    | OP_JUMP             8 -> 14
0011    | OP_POP
0012    | OP_CONSTANT         2 '2'
0014    4 OP_GET_GLOBAL       3 '@println'
0016    | OP_GET_LOCAL        1
0018    | OP_CALL             1
0020    | OP_POP
0021    5 OP_GET_GLOBAL       3 '@println'
0023    | OP_GET_GLOBAL       4 '@typeof'
0025    | OP_GET_LOCAL        1
0027    | OP_CALL             1
0029    | OP_CALL             1
0031    | OP_POP
0032    7 OP_GET_GLOBAL       0 'wide'
0034    | OP_JUMP_IF_FALSE   34 -> 48
0037    | OP_POP
0038    | OP_CONSTANT         5 '10'
0040    | OP_CONSTANT         6 '4'
0042    | OP_DIVIDE
0043    | OP_CLOSE_BLOCK_EXPR    0
0045    | OP_JUMP            45 -> 53
0048    | OP_POP
0049    | OP_CONSTANT         7 '0'
0051    | OP_CLOSE_BLOCK_EXPR    0
0053    8 OP_GET_GLOBAL       3 '@println'
0055    | OP_GET_LOCAL        2
0057    | OP_CALL             1
0059    | OP_POP
0060   11 OP_GET_GLOBAL       3 '@println'
0062    | OP_GET_GLOBAL       8 'pick'
0064    | OP_FALSE
0065    | OP_CALL             1
0067    | OP_CALL             1
0069    | OP_POP
0070    | OP_NIL
0071    | OP_RETURN
== pick ==
0000   13 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    | OP_CONSTANT         0 '1'
0008    | OP_JUMP             8 -> 14
0011    | OP_POP
0012    | OP_CONSTANT         1 '2'
0014    | OP_RETURN
