== <script> ==
0000   12 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_TRUE
0005    | OP_DEFINE_GLOBAL    2 'flag'
0007    2 OP_CONSTANT         4 '1.5'
0009    | OP_DEFINE_GLOBAL    3 'x'
0011   13 OP_NIL
0012    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 'flag'
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    | OP_GET_GLOBAL       1 'x'
0008    | OP_JUMP             8 -> 14
0011    | OP_POP
0012    | OP_CONSTANT         2 '2'
0014    5 OP_GET_GLOBAL       3 '@println'
0016    | OP_GET_GLOBAL       4 '@typeof'
0018    | OP_GET_LOCAL        1
0020    | OP_CALL             1
0022    | OP_CALL             1
0024    | OP_POP
0025    7 OP_GET_GLOBAL       0 'flag'
0027    | OP_JUMP_IF_FALSE   27 -> 36
0030    | OP_POP
0031    | OP_CONSTANT         2 '2'
0033    | OP_JUMP            33 -> 39
0036    | OP_POP
0037    | OP_GET_GLOBAL       1 'x'
0039    8 OP_GET_GLOBAL       3 '@println'
0041    | OP_GET_GLOBAL       4 '@typeof'
0043    | OP_GET_LOCAL        2
0045    | OP_CALL             1
0047    | OP_CALL             1
0049    | OP_POP
0050   10 OP_GET_GLOBAL       0 'flag'
0052    | OP_JUMP_IF_FALSE   52 -> 61
0055    | OP_POP
0056    | OP_CONSTANT         5 '1'
0058    | OP_JUMP            58 -> 64
0061    | OP_POP
0062    | OP_CONSTANT         6 '0.5'
0064   11 OP_GET_GLOBAL       3 '@println'
0066    | OP_GET_LOCAL        3
0068    | OP_CALL             1
0070    | OP_POP
0071   12 OP_GET_GLOBAL       3 '@println'
0073    | OP_GET_GLOBAL       4 '@typeof'
0075    | OP_GET_LOCAL        3
0077    | OP_CALL             1
0079    | OP_CALL             1
0081    | OP_POP
0082    | OP_NIL
0083    | OP_RETURN
