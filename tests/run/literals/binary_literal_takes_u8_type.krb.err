== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '250'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CONSTANT         2 '5'
0006    | OP_ADD
0007    | OP_CALL             1
0009    | OP_POP
0010    3 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       1 'a'
0014    | OP_CONSTANT         3 '2'
0016    | OP_DIVIDE
0017    | OP_CALL             1
0019    | OP_POP
0020    4 OP_GET_GLOBAL       0 '@println'
0022    | OP_GET_GLOBAL       4 '@typeof'
0024    | OP_GET_GLOBAL       1 'a'
0026    | OP_CONSTANT         2 '5'
0028    | OP_ADD
0029    | OP_CALL             1
0031    | OP_CALL             1
0033    | OP_POP
0034    | OP_NIL
0035    | OP_RETURN
