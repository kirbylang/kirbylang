== <script> ==
0000    1 OP_CONSTANT         1 '250'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    2 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'a'
0008    | OP_CONSTANT         3 '5'
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_POP
0014    3 OP_GET_GLOBAL       2 '@println'
0016    | OP_GET_GLOBAL       0 'a'
0018    | OP_CONSTANT         4 '2'
0020    | OP_DIVIDE
0021    | OP_CALL             1
0023    | OP_POP
0024    4 OP_GET_GLOBAL       2 '@println'
0026    | OP_GET_GLOBAL       5 '@typeof'
0028    | OP_GET_GLOBAL       0 'a'
0030    | OP_CONSTANT         3 '5'
0032    | OP_ADD
0033    | OP_CALL             1
0035    | OP_CALL             1
