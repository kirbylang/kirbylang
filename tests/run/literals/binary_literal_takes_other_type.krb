let a: u8 = 5;
@println(a + 2);
@println(2 + a);
@println(a * 3);
@println(a - 1);
@println(a / 2);
@println(a % 3);
@println(a < 10);
@println(10 > a);
@println(a == 5);
@println(5 != a);
let b: i32 = 7;
@println(b / 2);
@println(b - 10);
let c: f32 = 1.5f32;
@println(c * 2);
let d: i64 = 9007199254740992;
@println(d + 1);
let x: f64 = 2.5;
@println(x * 2);
@println(1 + 2);
@println(@typeof(1 + 2));
@println(@typeof(b + 1));
