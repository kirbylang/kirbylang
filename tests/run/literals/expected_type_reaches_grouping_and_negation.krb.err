== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '3'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008   12 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CALL             1
0006    | OP_POP
0007    4 OP_CONSTANT         2 '1'
0009    | OP_CONSTANT         3 '2'
0011    | OP_ADD
0012    | OP_NEGATE
0013    | OP_CONSTANT         3 '2'
0015    | OP_DIVIDE
0016    5 OP_GET_GLOBAL       0 '@println'
0018    | OP_GET_LOCAL        1
0020    | OP_CALL             1
0022    | OP_POP
0023    7 OP_CONSTANT         4 '-128'
0025    8 OP_GET_GLOBAL       0 '@println'
0027    | OP_GET_LOCAL        2
0029    | OP_CALL             1
0031    | OP_POP
0032   10 OP_CONSTANT         2 '1'
0034    | OP_CONSTANT         2 '1'
0036    | OP_ADD
0037    | OP_CONSTANT         5 '3'
0039    | OP_MULTIPLY
0040   11 OP_GET_GLOBAL       0 '@println'
0042    | OP_GET_LOCAL        3
0044    | OP_CALL             1
0046    | OP_POP
0047    | OP_NIL
0048    | OP_RETURN
