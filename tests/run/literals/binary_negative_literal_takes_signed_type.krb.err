== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '7'
0006    | OP_DEFINE_GLOBAL    2 'b'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'b'
0004    | OP_CONSTANT         2 '-1'
0006    | OP_ADD
0007    | OP_CALL             1
0009    | OP_POP
0010    3 OP_GET_GLOBAL       0 '@println'
0012    | OP_CONSTANT         2 '-1'
0014    | OP_GET_GLOBAL       1 'b'
0016    | OP_ADD
0017    | OP_CALL             1
0019    | OP_POP
0020    4 OP_CONSTANT         3 '1.5'
0022    5 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_LOCAL        1
0026    | OP_CONSTANT         4 '-2'
0028    | OP_MULTIPLY
0029    | OP_CALL             1
0031    | OP_POP
0032    | OP_NIL
0033    | OP_RETURN
