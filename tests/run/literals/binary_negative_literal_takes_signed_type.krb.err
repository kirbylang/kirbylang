== <script> ==
0000    1 OP_CONSTANT         1 '7'
0002    | OP_DEFINE_GLOBAL    0 'b'
0004    2 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'b'
0008    | OP_CONSTANT         3 '-1'
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_POP
0014    3 OP_GET_GLOBAL       2 '@println'
0016    | OP_CONSTANT         3 '-1'
0018    | OP_GET_GLOBAL       0 'b'
0020    | OP_ADD
0021    | OP_CALL             1
0023    | OP_POP
0024    4 OP_CONSTANT         5 '1.5'
0026    | OP_DEFINE_GLOBAL    4 'f'
0028    5 OP_GET_GLOBAL       2 '@println'
0030    | OP_GET_GLOBAL       4 'f'
0032    | OP_CONSTANT         6 '-2'
0034    | OP_MULTIPLY
0035    | OP_CALL             1
0037    | OP_POP
0038    6 OP_NIL
0039    | OP_RETURN
