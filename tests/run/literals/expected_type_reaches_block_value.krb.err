== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         0 '1'
0002    3 OP_CONSTANT         1 '3'
0004    | OP_CONSTANT         2 '2'
0006    | OP_DIVIDE
0007    4 OP_CLOSE_BLOCK_EXPR    1
0009    5 OP_GET_GLOBAL       3 '@println'
0011    | OP_GET_LOCAL        1
0013    | OP_CALL             1
0015    | OP_POP
0016    6 OP_GET_GLOBAL       3 '@println'
0018    | OP_GET_GLOBAL       4 '@typeof'
0020    | OP_GET_LOCAL        1
0022    | OP_CALL             1
0024    | OP_CALL             1
0026    | OP_POP
0027    | OP_NIL
0028    | OP_RETURN
