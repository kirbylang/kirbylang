== <script> ==
0000    3 OP_CLOSURE          1 <fn gt>
0002    | OP_DEFINE_GLOBAL    0 'gt'
0004    5 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    6 OP_NIL
0009    | OP_RETURN
== gt ==
0000    2 OP_CLOSURE          0 <fn lambda0x1>
0002      |                     local 1
0004    | OP_RETURN
== lambda0x1 ==
0000    2 OP_GET_LOCAL        1
0002    | OP_GET_UPVALUE      0
0004    | OP_GREATER
0005    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'gt'
0004    | OP_CONSTANT         2 '10'
0006    | OP_CALL             1
0008    | OP_CONSTANT         3 '100'
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_POP
0015    | OP_NIL
0016    | OP_RETURN
