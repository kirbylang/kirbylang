== <script> ==
0000    3 OP_CLOSURE          1 <fn sum>
0002    | OP_DEFINE_GLOBAL    0 'sum'
0004    5 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'sum'
0008    | OP_CONSTANT         3 '1'
0010    | OP_CONSTANT         4 '2'
0012    | OP_CALL             2
0014    | OP_CALL             1
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
== sum ==
0000    2 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
