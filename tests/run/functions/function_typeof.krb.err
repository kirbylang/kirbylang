== <script> ==
0000    1 OP_CLOSURE          1 <fn function>
0002    | OP_DEFINE_GLOBAL    0 'function'
0004    3 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    4 OP_NIL
0009    | OP_RETURN
== function ==
0000    1 OP_NIL
0001    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@typeof'
0004    | OP_GET_GLOBAL       2 'function'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
