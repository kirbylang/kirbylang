== <script> ==
0000    3 OP_CLOSURE          1 <fn sum>
0002    | OP_DEFINE_GLOBAL    0 'sum'
0004    5 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_CONSTANT         5 '10'
0010    | OP_DEFINE_GLOBAL    4 'n'
0012    6 OP_NIL
0013    | OP_RETURN
== sum ==
0000    3 OP_GET_LOCAL        1
0002    | OP_GET_GLOBAL       0 'n'
0004    | OP_ADD
0005    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'sum'
0004    | OP_CONSTANT         2 '50'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
