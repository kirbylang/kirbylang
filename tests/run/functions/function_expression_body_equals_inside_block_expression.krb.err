== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    9 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_CLOSURE          0 <fn map>
0002    3 OP_CLOSURE          1 <fn pow>
0004    5 OP_GET_LOCAL        1
0006    | OP_CONSTANT         2 '10'
0008    | OP_GET_LOCAL        2
0010    | OP_CALL             2
0012    6 OP_CLOSE_BLOCK_EXPR    2
0014    8 OP_GET_GLOBAL       3 '@println'
0016    | OP_GET_LOCAL        1
0018    | OP_CALL             1
0020    | OP_POP
0021    | OP_NIL
0022    | OP_RETURN
== map ==
0000    2 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
== pow ==
0000    3 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        1
0004    | OP_MULTIPLY
0005    | OP_RETURN
