== <script> ==
0000    1 OP_CLOSURE          1 <fn isEven>
0002    | OP_DEFINE_GLOBAL    0 'isEven'
0004    2 OP_CLOSURE          3 <fn isOdd>
0006    | OP_DEFINE_GLOBAL    2 'isOdd'
0008    5 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012    6 OP_NIL
0013    | OP_RETURN
== isEven ==
0000    1 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '0'
0004    | OP_EQUAL
0005    | OP_JUMP_IF_FALSE    5 -> 14
0008    | OP_POP
0009    | OP_TRUE
0010    | OP_RETURN
0011    | OP_JUMP            11 -> 15
0014    | OP_POP
0015    | OP_GET_GLOBAL       1 'isOdd'
0017    | OP_GET_LOCAL        1
0019    | OP_CONSTANT         2 '1'
0021    | OP_SUBTRACT
0022    | OP_CALL             1
0024    | OP_RETURN
== isOdd ==
0000    2 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '0'
0004    | OP_EQUAL
0005    | OP_JUMP_IF_FALSE    5 -> 14
0008    | OP_POP
0009    | OP_FALSE
0010    | OP_RETURN
0011    | OP_JUMP            11 -> 15
0014    | OP_POP
0015    | OP_GET_GLOBAL       1 'isEven'
0017    | OP_GET_LOCAL        1
0019    | OP_CONSTANT         2 '1'
0021    | OP_SUBTRACT
0022    | OP_CALL             1
0024    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'isEven'
0004    | OP_CONSTANT         2 '10'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    5 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       3 'isOdd'
0015    | OP_CONSTANT         4 '7'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
