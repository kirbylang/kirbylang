== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    3 OP_CLOSURE          1 <fn function>
0002    | OP_DEFINE_GLOBAL    0 'function'
0004    5 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'function'
0008    | OP_CALL             1
0010    | OP_POP
0011    7 OP_GET_GLOBAL       2 '@println'
0013    | OP_GET_GLOBAL       0 'function'
0015    | OP_CALL             0
0017    | OP_CALL             1
0019    | OP_POP
0020    8 OP_NIL
0021    | OP_RETURN
== function ==
0000    2 OP_NIL
0001    | OP_RETURN
