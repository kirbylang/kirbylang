== <script> ==
0000    3 OP_CLOSURE          1 <fn function>
0002    | OP_DEFINE_GLOBAL    0 'function'
0004    7 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    8 OP_NIL
0009    | OP_RETURN
== function ==
0000    2 OP_NIL
0001    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'function'
0004    | OP_CALL             1
0006    | OP_POP
0007    7 OP_GET_GLOBAL       0 '@println'
0009    | OP_GET_GLOBAL       1 'function'
0011    | OP_CALL             0
0013    | OP_CALL             1
0015    | OP_POP
0016    | OP_NIL
0017    | OP_RETURN
