// The `pub` on `label` must not leak to the field declared after it.
struct Config {
    pub label: string;
    token: string;
}

impl Config {
    pub fun new(label: string, token: string): Config = Config {
        label: label,
        token: token,
    };
}

var c = Config.new("visible", "hidden");

@println(c.label);
@println(c.token);
