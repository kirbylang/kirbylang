== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Holder'
0006    | OP_DEFINE_GLOBAL    2 'Holder'
0008    | OP_GET_GLOBAL       2 'Holder'
0010    2 OP_NIL
0011    | OP_FIELD            3 'callback' public immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Holder'
0018    6 OP_CONSTANT         3 'callback'
0020    | OP_CLOSURE          5 <fn lambda0x1>
0022    7 OP_STRUCT_INIT      1
0024    | OP_DEFINE_GLOBAL    4 'h'
0026   10 OP_NIL
0027    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'h'
0004    | OP_INVOKE        (0 args)    2 'callback'
0007    | OP_CALL             1
0009    | OP_POP
0010    | OP_NIL
0011    | OP_RETURN
== lambda0x1 ==
0000    6 OP_CONSTANT         0 'called'
0002    | OP_RETURN
