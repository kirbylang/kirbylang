== <script> ==
0000   17 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Struct'
0013   10 OP_CLOSURE          4 <fn printSelf>
0015    | OP_METHOD           3 'printSelf'
0017   11 OP_POP
0018   13 OP_GET_GLOBAL       2 'Struct'
0020    | OP_STRUCT_INIT      0
0022    | OP_DEFINE_GLOBAL    5 'instance'
0024   18 OP_NIL
0025    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 'instance'
0002    | OP_INVOKE        (0 args)    1 'printSelf'
0005   17 OP_GET_LOCAL        1
0007    | OP_CALL             0
0009    | OP_POP
0010    | OP_NIL
0011    | OP_RETURN
== printSelf ==
0000    7 OP_CLOSURE          0 <fn innerClosure>
0002      |                     local 0
0004    9 OP_GET_LOCAL        1
0006    | OP_RETURN
== innerClosure ==
0000    6 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_UPVALUE      0
0004    | OP_CALL             1
0006    | OP_POP
0007    7 OP_NIL
0008    | OP_RETURN
