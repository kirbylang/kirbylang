== <script> ==
0000   15 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   23 OP_CLOSURE          3 <fn hello>
0006    | OP_DEFINE_GLOBAL    2 'hello'
0008    3 OP_STRUCT           4 'Struct'
0010    | OP_DEFINE_GLOBAL    4 'Struct'
0012    | OP_GET_GLOBAL       4 'Struct'
0014    4 OP_NIL
0015    | OP_FIELD            5 'fn' public immutable
0019    5 OP_POP
0020    7 OP_GET_GLOBAL       4 'Struct'
0022   10 OP_CLOSURE          7 <fn new>
0024    | OP_METHOD           6 'new'
0026   11 OP_POP
0027   24 OP_NIL
0028    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 'Struct'
0002    | OP_GET_GLOBAL       2 'hello'
0004    | OP_INVOKE        (1 args)    1 'new'
0007   15 OP_GET_LOCAL        1
0009    | OP_INVOKE        (0 args)    3 'fn'
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
== hello ==
0000   22 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'Hello World'
0004    | OP_CALL             1
0006    | OP_POP
0007   23 OP_NIL
0008    | OP_RETURN
== new ==
0000    8 OP_GET_GLOBAL       0 'Struct'
0002    9 OP_CONSTANT         1 'fn'
0004    | OP_GET_LOCAL        1
0006   10 OP_STRUCT_INIT      1
0008    | OP_RETURN
