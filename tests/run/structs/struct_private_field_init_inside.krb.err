== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Account'
0006    | OP_DEFINE_GLOBAL    2 'Account'
0008    | OP_GET_GLOBAL       2 'Account'
0010    2 OP_NIL
0011    | OP_FIELD            3 '_balance' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Account'
0018    6 OP_CLOSURE          5 <fn withBalance>
0020    | OP_METHOD           4 'withBalance'
0022    8 OP_CLOSURE          7 <fn balance>
0024    | OP_METHOD           6 'balance'
0026    9 OP_POP
0027   12 OP_NIL
0028    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Account'
0004    | OP_CONSTANT         3 '250'
0006    | OP_INVOKE        (1 args)    2 'withBalance'
0009    | OP_INVOKE        (0 args)    4 'balance'
0012    | OP_CALL             1
0014    | OP_POP
0015    | OP_NIL
0016    | OP_RETURN
== withBalance ==
0000    6 OP_GET_GLOBAL       0 'Account'
0002    | OP_CONSTANT         1 '_balance'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== balance ==
0000    8 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 '_balance'
0004    | OP_RETURN
