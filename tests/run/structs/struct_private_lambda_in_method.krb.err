== <script> ==
0000   16 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Counter'
0006    | OP_DEFINE_GLOBAL    2 'Counter'
0008    | OP_GET_GLOBAL       2 'Counter'
0010    2 OP_NIL
0011    | OP_FIELD            3 'count' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Counter'
0018    6 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022   13 OP_CLOSURE          7 <fn read>
0024    | OP_METHOD           6 'read'
0026   14 OP_POP
0027   17 OP_NIL
0028    | OP_RETURN
== main ==
0000   16 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Counter'
0004    | OP_INVOKE        (0 args)    2 'new'
0007    | OP_INVOKE        (0 args)    3 'read'
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Counter'
0002    | OP_CONSTANT         1 'count'
0004    | OP_CONSTANT         2 '7'
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== read ==
0000   10 OP_CLOSURE          0 <fn lambda0x1>
0002      |                     local 0
0004   12 OP_GET_LOCAL        1
0006    | OP_CALL             0
0008    | OP_RETURN
== lambda0x1 ==
0000   10 OP_GET_UPVALUE      0
0002    | OP_GET_PROPERTY     0 'count'
0004    | OP_RETURN
