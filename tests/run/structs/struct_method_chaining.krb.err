== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Chain'
0002    | OP_DEFINE_GLOBAL    0 'Chain'
0004    | OP_GET_GLOBAL       0 'Chain'
0006    2 OP_NIL
0007    | OP_FIELD            1 'value' private mutable
0011    3 OP_POP
0012    5 OP_GET_GLOBAL       0 'Chain'
0014    6 OP_CLOSURE          3 <fn new>
0016    | OP_METHOD           2 'new'
0018    8 OP_CLOSURE          5 <fn plus>
0020    | OP_METHOD           4 'plus'
0022   10 OP_CLOSURE          7 <fn get>
0024    | OP_METHOD           6 'get'
0026   11 OP_POP
0027   13 OP_GET_GLOBAL       8 '@println'
0029    | OP_GET_GLOBAL       0 'Chain'
0031    | OP_CONSTANT         9 '1'
0033    | OP_INVOKE        (1 args)    2 'new'
0036    | OP_CONSTANT        10 '2'
0038    | OP_INVOKE        (1 args)    4 'plus'
0041    | OP_CONSTANT        11 '3'
0043    | OP_INVOKE        (1 args)    4 'plus'
0046    | OP_INVOKE        (0 args)    6 'get'
0049    | OP_CALL             1
0051    | OP_POP
0052   14 OP_NIL
0053    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Chain'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== plus ==
0000    8 OP_GET_GLOBAL       0 'Chain'
0002    | OP_GET_LOCAL        0
0004    | OP_GET_PROPERTY     2 'value'
0006    | OP_GET_LOCAL        1
0008    | OP_ADD
0009    | OP_INVOKE        (1 args)    1 'new'
0012    | OP_RETURN
== get ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
