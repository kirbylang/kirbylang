== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Chain'
0006    | OP_DEFINE_GLOBAL    2 'Chain'
0008    | OP_GET_GLOBAL       2 'Chain'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Chain'
0018    6 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022    8 OP_CLOSURE          7 <fn plus>
0024    | OP_METHOD           6 'plus'
0026   10 OP_CLOSURE          9 <fn get>
0028    | OP_METHOD           8 'get'
0030   11 OP_POP
0031   14 OP_NIL
0032    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Chain'
0004    | OP_CONSTANT         3 '1'
0006    | OP_INVOKE        (1 args)    2 'new'
0009    | OP_CONSTANT         5 '2'
0011    | OP_INVOKE        (1 args)    4 'plus'
0014    | OP_CONSTANT         6 '3'
0016    | OP_INVOKE        (1 args)    4 'plus'
0019    | OP_INVOKE        (0 args)    7 'get'
0022    | OP_CALL             1
0024    | OP_POP
0025    | OP_NIL
0026    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Chain'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== plus ==
0000    8 OP_GET_GLOBAL       0 'Chain'
0002    | OP_GET_LOCAL        0
0004    | OP_GET_PROPERTY     2 'value'
0006    | OP_GET_LOCAL        1
0008    | OP_ADD
0009    | OP_INVOKE        (1 args)    1 'new'
0012    | OP_RETURN
== get ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
