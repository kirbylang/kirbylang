== <script> ==
0000   15 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    8 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022   10 OP_CLOSURE          7 <fn get>
0024    | OP_METHOD           6 'get'
0026   11 OP_POP
0027   16 OP_NIL
0028    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         2 '100'
0004    | OP_INVOKE        (1 args)    1 'new'
0007   15 OP_GET_GLOBAL       3 '@println'
0009    | OP_GET_LOCAL        1
0011    | OP_INVOKE        (0 args)    4 'get'
0014    | OP_CALL             1
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    7 OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    8 OP_STRUCT_INIT      1
0008    | OP_RETURN
== get ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
