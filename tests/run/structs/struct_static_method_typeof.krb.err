== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Struct'
0013    4 OP_CLOSURE          4 <fn hello>
0015    | OP_METHOD           3 'hello'
0017    5 OP_POP
0018    8 OP_NIL
0019    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@typeof'
0004    | OP_GET_GLOBAL       2 'Struct'
0006    | OP_GET_PROPERTY     3 'hello'
0008    | OP_CALL             1
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
== hello ==
0000    4 OP_NIL
0001    | OP_RETURN
