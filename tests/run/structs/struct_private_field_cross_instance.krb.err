== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Point'
0018    6 OP_CLOSURE          5 <fn at>
0020    | OP_METHOD           4 'at'
0022   10 OP_CLOSURE          7 <fn sum>
0024    | OP_METHOD           6 'sum'
0026   11 OP_POP
0027   14 OP_NIL
0028    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Point'
0004    | OP_CONSTANT         3 '3'
0006    | OP_INVOKE        (1 args)    2 'at'
0009    | OP_GET_GLOBAL       1 'Point'
0011    | OP_CONSTANT         5 '4'
0013    | OP_INVOKE        (1 args)    2 'at'
0016    | OP_INVOKE        (1 args)    4 'sum'
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
== at ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== sum ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'x'
0008    | OP_ADD
0009    | OP_RETURN
