== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' private mutable
0011    3 OP_POP
0012    5 OP_GET_GLOBAL       0 'Point'
0014    6 OP_CLOSURE          3 <fn at>
0016    | OP_METHOD           2 'at'
0018   10 OP_CLOSURE          5 <fn sum>
0020    | OP_METHOD           4 'sum'
0022   11 OP_POP
0023   13 OP_GET_GLOBAL       6 '@println'
0025    | OP_GET_GLOBAL       0 'Point'
0027    | OP_CONSTANT         7 '3'
0029    | OP_INVOKE        (1 args)    2 'at'
0032    | OP_GET_GLOBAL       0 'Point'
0034    | OP_CONSTANT         8 '4'
0036    | OP_INVOKE        (1 args)    2 'at'
0039    | OP_INVOKE        (1 args)    4 'sum'
0042    | OP_CALL             1
0044    | OP_POP
0045   14 OP_NIL
0046    | OP_RETURN
== at ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== sum ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'x'
0008    | OP_ADD
0009    | OP_RETURN
