== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' private
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       0 'Point'
0013    6 OP_CLOSURE          3 <fn at>
0015    | OP_METHOD           2 'at'
0017   10 OP_CLOSURE          5 <fn sum>
0019    | OP_METHOD           4 'sum'
0021   11 OP_POP
0022   13 OP_GET_GLOBAL       6 '@println'
0024    | OP_GET_GLOBAL       0 'Point'
0026    | OP_CONSTANT         7 '3'
0028    | OP_INVOKE        (1 args)    2 'at'
0031    | OP_GET_GLOBAL       0 'Point'
0033    | OP_CONSTANT         8 '4'
0035    | OP_INVOKE        (1 args)    2 'at'
0038    | OP_INVOKE        (1 args)    4 'sum'
0041    | OP_CALL             1
0043    | OP_POP
0044   14 OP_NIL
0045    | OP_RETURN
== at ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== sum ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'x'
0008    | OP_ADD
0009    | OP_RETURN
