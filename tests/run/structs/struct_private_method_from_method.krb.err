== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Greeter'
0006    | OP_DEFINE_GLOBAL    2 'Greeter'
0008    | OP_GET_GLOBAL       2 'Greeter'
0010    2 OP_NIL
0011    | OP_FIELD            3 'name' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Greeter'
0018    6 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022    8 OP_CLOSURE          7 <fn subject>
0024    | OP_METHOD           6 'subject'
0026   10 OP_CLOSURE          9 <fn greet>
0028    | OP_METHOD           8 'greet'
0030   11 OP_POP
0031   14 OP_NIL
0032    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Greeter'
0004    | OP_INVOKE        (0 args)    2 'new'
0007    | OP_INVOKE        (0 args)    3 'greet'
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Greeter'
0002    | OP_CONSTANT         1 'name'
0004    | OP_CONSTANT         2 'World'
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== subject ==
0000    8 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'name'
0004    | OP_RETURN
== greet ==
0000   10 OP_CONSTANT         0 'Hello '
0002    | OP_GET_LOCAL        0
0004    | OP_INVOKE        (0 args)    1 'subject'
0007    | OP_ADD
0008    | OP_RETURN
