== <script> ==
0000   18 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' private immutable
0015    3 OP_POP
0016   11 OP_GET_GLOBAL       2 'Box'
0018   12 OP_CLOSURE          5 <fn toString>
0020    | OP_METHOD           4 'toString'
0022   13 OP_POP
0023    5 OP_GET_GLOBAL       2 'Box'
0025    6 OP_CLOSURE          7 <fn new>
0027    | OP_METHOD           6 'new'
0029    8 OP_CLOSURE          8 <fn toString>
0031    | OP_METHOD           4 'toString'
0033    9 OP_POP
0034   19 OP_NIL
0035    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         2 '100'
0004    | OP_INVOKE        (1 args)    1 'new'
0007   16 OP_GET_LOCAL        1
0009    | OP_INVOKE        (0 args)    3 'toString'
0012   18 OP_GET_GLOBAL       4 '@println'
0014    | OP_GET_LOCAL        2
0016    | OP_CALL             1
0018    | OP_POP
0019    | OP_NIL
0020    | OP_RETURN
== toString ==
0000   12 OP_CONSTANT         0 'Hello World'
0002    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== toString ==
0000    8 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
