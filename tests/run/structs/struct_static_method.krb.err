== <script> ==
0000   15 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public immutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'y' public immutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Point'
0023    7 OP_CLOSURE          6 <fn new>
0025    | OP_METHOD           5 'new'
0027    9 OP_CLOSURE          8 <fn origin>
0029    | OP_METHOD           7 'origin'
0031   10 OP_POP
0032   16 OP_NIL
0033    | OP_RETURN
== main ==
0000   12 OP_GET_GLOBAL       0 'Point'
0002    | OP_INVOKE        (0 args)    1 'origin'
0005   14 OP_GET_GLOBAL       2 '@println'
0007    | OP_GET_LOCAL        1
0009    | OP_GET_PROPERTY     3 'x'
0011    | OP_CALL             1
0013    | OP_POP
0014   15 OP_GET_GLOBAL       2 '@println'
0016    | OP_GET_LOCAL        1
0018    | OP_GET_PROPERTY     4 'y'
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
== new ==
0000    7 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_CONSTANT         2 'y'
0008    | OP_GET_LOCAL        2
0010    | OP_STRUCT_INIT      2
0012    | OP_RETURN
== origin ==
0000    9 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         2 '0'
0004    | OP_CONSTANT         2 '0'
0006    | OP_INVOKE        (2 args)    1 'new'
0009    | OP_RETURN
