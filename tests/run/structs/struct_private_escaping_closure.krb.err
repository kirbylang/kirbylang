== <script> ==
0000   16 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Counter'
0006    | OP_DEFINE_GLOBAL    2 'Counter'
0008    | OP_GET_GLOBAL       2 'Counter'
0010    2 OP_NIL
0011    | OP_FIELD            3 'count' public immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Counter'
0018   11 OP_CLOSURE          5 <fn reader>
0020    | OP_METHOD           4 'reader'
0022   12 OP_POP
0023   17 OP_NIL
0024    | OP_RETURN
== main ==
0000   14 OP_GET_GLOBAL       0 'Counter'
0002    | OP_CONSTANT         1 'count'
0004    | OP_CONSTANT         2 '7'
0006    | OP_STRUCT_INIT      1
0008    | OP_INVOKE        (0 args)    3 'reader'
0011   16 OP_GET_GLOBAL       4 '@println'
0013    | OP_GET_LOCAL        1
0015    | OP_CALL             0
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
== reader ==
0000    8 OP_CLOSURE          0 <fn lambda0x1>
0002      |                     local 0
0004   10 OP_GET_LOCAL        1
0006    | OP_RETURN
== lambda0x1 ==
0000    8 OP_GET_UPVALUE      0
0002    | OP_GET_PROPERTY     0 'count'
0004    | OP_RETURN
