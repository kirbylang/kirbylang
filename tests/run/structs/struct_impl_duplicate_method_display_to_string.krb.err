== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Struct'
0013    4 OP_CLOSURE          4 <fn toString>
0015    | OP_TRAIT_METHOD     3 'toString'    5 'Display.toString'
0018    5 OP_POP
0019    7 OP_GET_GLOBAL       2 'Struct'
0021    8 OP_CLOSURE          6 <fn toString>
0023    | OP_METHOD           3 'toString'
0025    9 OP_POP
0026   12 OP_NIL
0027    | OP_RETURN
== main ==
0000   11 OP_NIL
0001    | OP_RETURN
== toString ==
0000    4 OP_CONSTANT         0 'Struct'
0002    | OP_RETURN
== toString ==
0000    8 OP_CONSTANT         0 'Struct!'
0002    | OP_RETURN
