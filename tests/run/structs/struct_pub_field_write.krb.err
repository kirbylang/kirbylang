== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Point'
0018    | OP_CONSTANT         3 'x'
0020    | OP_CONSTANT         5 '1'
0022    | OP_STRUCT_INIT      1
0024    | OP_DEFINE_GLOBAL    4 'p'
0026   10 OP_NIL
0027    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 'p'
0002    | OP_CONSTANT         2 '9'
0004    | OP_SET_PROPERTY     1 'x'
0006    | OP_POP
0007    9 OP_GET_GLOBAL       3 '@println'
0009    | OP_GET_GLOBAL       0 'p'
0011    | OP_GET_PROPERTY     1 'x'
0013    | OP_CALL             1
0015    | OP_POP
0016    | OP_NIL
0017    | OP_RETURN
