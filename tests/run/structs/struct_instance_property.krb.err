== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    2 OP_NIL
0011    | OP_FIELD            3 'hello' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Struct'
0018    6 OP_CONSTANT         3 'hello'
0020    | OP_CONSTANT         5 'Hello'
0022    7 OP_STRUCT_INIT      1
0024    | OP_DEFINE_GLOBAL    4 'instance'
0026   12 OP_NIL
0027    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 'instance'
0002    | OP_CONSTANT         2 'World'
0004    | OP_SET_PROPERTY     1 'hello'
0006    | OP_POP
0007   11 OP_GET_GLOBAL       3 '@println'
0009    | OP_GET_GLOBAL       0 'instance'
0011    | OP_GET_PROPERTY     1 'hello'
0013    | OP_CALL             1
0015    | OP_POP
0016    | OP_NIL
0017    | OP_RETURN
