== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    | OP_CONSTANT         3 'value'
0020    | OP_CONSTANT         5 '100'
0022    | OP_STRUCT_INIT      1
0024    | OP_DEFINE_GLOBAL    4 'box'
0026    9 OP_NIL
0027    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'box'
0004    | OP_GET_PROPERTY     2 'value'
0006    | OP_CALL             1
0008    | OP_POP
0009    | OP_NIL
0010    | OP_RETURN
