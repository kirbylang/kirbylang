== <script> ==
0000   16 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Struct'
0013    6 OP_CLOSURE          4 <fn init>
0015    | OP_METHOD           3 'init'
0017   10 OP_CLOSURE          6 <fn init2>
0019    | OP_METHOD           5 'init2'
0021   11 OP_POP
0022   13 OP_GET_GLOBAL       2 'Struct'
0024    | OP_STRUCT_INIT      0
0026    | OP_DEFINE_GLOBAL    7 'instance'
0028   17 OP_NIL
0029    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'instance'
0004    | OP_INVOKE        (0 args)    2 'init'
0007    | OP_CALL             1
0009    | OP_POP
0010   16 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       3 'Struct'
0014    | OP_INVOKE        (0 args)    4 'init2'
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
== init ==
0000    5 OP_CONSTANT         0 'instance method'
0002    | OP_RETURN
== init2 ==
0000    9 OP_CONSTANT         0 'static method'
0002    | OP_RETURN
