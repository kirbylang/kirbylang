== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Struct'
0013    6 OP_CLOSURE          4 <fn hello>
0015    | OP_METHOD           3 'hello'
0017    7 OP_POP
0018   12 OP_NIL
0019    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 'Struct'
0002    | OP_GET_PROPERTY     1 'hello'
0004   11 OP_GET_LOCAL        1
0006    | OP_CALL             0
0008    | OP_POP
0009    | OP_NIL
0010    | OP_RETURN
== hello ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'Hello World'
0004    | OP_CALL             1
0006    | OP_POP
0007    6 OP_NIL
0008    | OP_RETURN
