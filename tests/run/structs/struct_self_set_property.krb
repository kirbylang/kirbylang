struct Struct {
     var value: string;
}

impl Struct {
    pub fun set(self, value: string): unit {
        self.value = value;
    }

    pub fun get(self): string = self.value;
}

impl Default for Struct {
    fun default(): Self = Self { value: "" };
}

fun main(): unit { var instance = Struct.default();

instance.set("Hello");

@println(instance.get());

instance.set("World");

@println(instance.get()); }
