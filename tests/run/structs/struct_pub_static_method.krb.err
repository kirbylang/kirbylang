== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' public mutable
0011    3 OP_POP
0012    5 OP_GET_GLOBAL       0 'Point'
0014    6 OP_CLOSURE          3 <fn origin>
0016    | OP_METHOD           2 'origin'
0018    7 OP_POP
0019    9 OP_GET_GLOBAL       4 '@println'
0021    | OP_GET_GLOBAL       0 'Point'
0023    | OP_INVOKE        (0 args)    2 'origin'
0026    | OP_GET_PROPERTY     1 'x'
0028    | OP_CALL             1
0030    | OP_POP
0031   10 OP_NIL
0032    | OP_RETURN
== origin ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_CONSTANT         2 '0'
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
