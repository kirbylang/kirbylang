== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Point'
0018    6 OP_CLOSURE          5 <fn origin>
0020    | OP_METHOD           4 'origin'
0022    7 OP_POP
0023   10 OP_NIL
0024    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Point'
0004    | OP_INVOKE        (0 args)    2 'origin'
0007    | OP_GET_PROPERTY     3 'x'
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== origin ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_CONSTANT         2 '0'
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
