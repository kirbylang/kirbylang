== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 '_x' private immutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Point'
0018    6 OP_CLOSURE          5 <fn make>
0020    | OP_METHOD           4 'make'
0022    8 OP_CLOSURE          7 <fn origin>
0024    | OP_METHOD           6 'origin'
0026   10 OP_CLOSURE          9 <fn x>
0028    | OP_METHOD           8 'x'
0030   11 OP_POP
0031   14 OP_NIL
0032    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Point'
0004    | OP_INVOKE        (0 args)    2 'origin'
0007    | OP_INVOKE        (0 args)    3 'x'
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
== make ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 '_x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== origin ==
0000    8 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         2 '0'
0004    | OP_INVOKE        (1 args)    1 'make'
0007    | OP_RETURN
== x ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 '_x'
0004    | OP_RETURN
