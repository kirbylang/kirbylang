== <script> ==
0000   12 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public immutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'y' public immutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Point'
0023    7 OP_CONSTANT         3 'x'
0025    | OP_CONSTANT         6 '1'
0027    8 OP_CONSTANT         4 'y'
0029    | OP_CONSTANT         7 '2'
0031    9 OP_STRUCT_INIT      2
0033    | OP_DEFINE_GLOBAL    5 'p'
0035   13 OP_NIL
0036    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'p'
0004    | OP_GET_PROPERTY     2 'x'
0006    | OP_CALL             1
0008    | OP_POP
0009   12 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       1 'p'
0013    | OP_GET_PROPERTY     3 'y'
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
