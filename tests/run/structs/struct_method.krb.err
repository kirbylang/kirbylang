== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Greeter'
0006    | OP_DEFINE_GLOBAL    2 'Greeter'
0008    | OP_GET_GLOBAL       2 'Greeter'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Greeter'
0013    6 OP_CLOSURE          4 <fn greet>
0015    | OP_METHOD           3 'greet'
0017    7 OP_POP
0018    9 OP_GET_GLOBAL       2 'Greeter'
0020    | OP_STRUCT_INIT      0
0022    | OP_DEFINE_GLOBAL    5 'greeter'
0024   14 OP_NIL
0025    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'greeter'
0004    | OP_GET_PROPERTY     2 'greet'
0006    | OP_CALL             1
0008    | OP_POP
0009   13 OP_GET_GLOBAL       1 'greeter'
0011    | OP_CONSTANT         3 'World'
0013    | OP_INVOKE        (1 args)    2 'greet'
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
== greet ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'Hello '
0004    | OP_GET_LOCAL        1
0006    | OP_ADD
0007    | OP_CALL             1
0009    | OP_POP
0010    6 OP_NIL
0011    | OP_RETURN
