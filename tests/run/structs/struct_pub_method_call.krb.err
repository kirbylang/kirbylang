== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Greeter'
0006    | OP_DEFINE_GLOBAL    2 'Greeter'
0008    | OP_GET_GLOBAL       2 'Greeter'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Greeter'
0013    4 OP_CLOSURE          4 <fn greet>
0015    | OP_METHOD           3 'greet'
0017    5 OP_POP
0018    8 OP_NIL
0019    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Greeter'
0004    | OP_STRUCT_INIT      0
0006    | OP_INVOKE        (0 args)    2 'greet'
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== greet ==
0000    4 OP_CONSTANT         0 'Hello World'
0002    | OP_RETURN
