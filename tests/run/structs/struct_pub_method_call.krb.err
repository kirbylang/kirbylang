== <script> ==
0000    1 OP_STRUCT           0 'Greeter'
0002    | OP_DEFINE_GLOBAL    0 'Greeter'
0004    | OP_GET_GLOBAL       0 'Greeter'
0006    | OP_POP
0007    3 OP_GET_GLOBAL       0 'Greeter'
0009    4 OP_CLOSURE          2 <fn greet>
0011    | OP_METHOD           1 'greet'
0013    5 OP_POP
0014    7 OP_GET_GLOBAL       3 '@println'
0016    | OP_GET_GLOBAL       0 'Greeter'
0018    | OP_STRUCT_INIT      0
0020    | OP_INVOKE        (0 args)    1 'greet'
0023    | OP_CALL             1
0025    | OP_POP
0026    8 OP_NIL
0027    | OP_RETURN
== greet ==
0000    4 OP_CONSTANT         0 'Hello World'
0002    | OP_RETURN
