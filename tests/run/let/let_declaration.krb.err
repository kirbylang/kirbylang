== <script> ==
0000    1 OP_CONSTANT         1 'John'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    2 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'name'
0008    | OP_CALL             1
0010    | OP_POP
0011    4 OP_CONSTANT         4 '42'
0013    | OP_DEFINE_GLOBAL    3 'n'
0015    5 OP_GET_GLOBAL       2 '@println'
0017    | OP_GET_GLOBAL       3 'n'
0019    | OP_CALL             1
0021    | OP_POP
0022    7 OP_TRUE
0023    | OP_DEFINE_GLOBAL    5 'flag'
0025    8 OP_GET_GLOBAL       2 '@println'
0027    | OP_GET_GLOBAL       5 'flag'
0029    | OP_CALL             1
0031    | OP_POP
0032    9 OP_NIL
0033    | OP_RETURN
