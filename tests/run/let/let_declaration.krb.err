== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'John'
0006    | OP_DEFINE_GLOBAL    2 'name'
0008    9 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'name'
0004    | OP_CALL             1
0006    | OP_POP
0007    4 OP_CONSTANT         2 '42'
0009    5 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_LOCAL        1
0013    | OP_CALL             1
0015    | OP_POP
0016    7 OP_TRUE
0017    8 OP_GET_GLOBAL       0 '@println'
0019    | OP_GET_LOCAL        2
0021    | OP_CALL             1
0023    | OP_POP
0024    | OP_NIL
0025    | OP_RETURN
