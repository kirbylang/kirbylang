== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '10'
0006    | OP_DEFINE_GLOBAL    2 'b'
0008   10 OP_NIL
0009    | OP_RETURN
== main ==
0000    4 OP_CONSTANT         0 '20'
0002    5 OP_CONSTANT         1 '21'
0004    | OP_SET_LOCAL        1
0006    | OP_POP
0007    6 OP_GET_GLOBAL       2 '@println'
0009    | OP_GET_LOCAL        1
0011    | OP_CALL             1
0013    | OP_POP
0014    7 OP_POP
0015    9 OP_GET_GLOBAL       2 '@println'
0017    | OP_GET_GLOBAL       3 'b'
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
