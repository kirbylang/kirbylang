== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '9223372036854775807'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_NEGATE
0005    | OP_CALL             1
0007    | OP_POP
0008    3 OP_CONSTANT         2 '-9223372036854775807'
0010    4 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_LOCAL        1
0014    | OP_NEGATE
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
