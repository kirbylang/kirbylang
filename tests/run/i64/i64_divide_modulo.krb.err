== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '-9223372036854775808'
0006    | OP_DEFINE_GLOBAL    2 'min'
0008    2 OP_CONSTANT         5 '-1'
0010    | OP_DEFINE_GLOBAL    4 'negOne'
0012    3 OP_CONSTANT         7 '-2'
0014    | OP_DEFINE_GLOBAL    6 'negTwo'
0016   10 OP_NIL
0017    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
