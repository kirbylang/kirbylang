== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    6 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'before'
0004    | OP_CALL             1
0006    | OP_POP
0007    3 OP_GET_GLOBAL       2 '@exit'
0009    | OP_CONSTANT         3 '3'
0011    | OP_CALL             1
0013    | OP_POP
0014    4 OP_GET_GLOBAL       0 '@println'
0016    | OP_CONSTANT         4 'after'
0018    | OP_CALL             1
0020    | OP_POP
0021    5 OP_NIL
0022    | OP_RETURN
