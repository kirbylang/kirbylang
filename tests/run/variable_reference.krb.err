== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'Hello'
0006    | OP_DEFINE_GLOBAL    2 'greeting'
0008    2 OP_CONSTANT         5 'World'
0010    | OP_DEFINE_GLOBAL    4 'name'
0012    4 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_GET_GLOBAL       2 'greeting'
0006    | OP_CONSTANT         3 ' '
0008    | OP_GET_GLOBAL       4 'name'
0010    | OP_LIST             3
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
