== <script> ==
0000    1 OP_CLOSURE          1 <fn first>
0002    | OP_DEFINE_GLOBAL    0 'first'
0004    2 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    3 OP_NIL
0009    | OP_RETURN
== first ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'first'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 'two'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
