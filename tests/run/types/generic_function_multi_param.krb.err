== <script> ==
0000    1 OP_CLOSURE          1 <fn first>
0002    | OP_DEFINE_GLOBAL    0 'first'
0004    2 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'first'
0008    | OP_CONSTANT         3 '1'
0010    | OP_CONSTANT         4 'two'
0012    | OP_CALL             2
0014    | OP_CALL             1
0016    | OP_POP
0017    3 OP_NIL
0018    | OP_RETURN
== first ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
