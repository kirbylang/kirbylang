== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          1 <fn ceil>
0002    | OP_DEFINE_GLOBAL    0 'ceil'
0004    3 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'ceil'
0008    | OP_CONSTANT         3 'hello'
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_POP
0015    4 OP_GET_GLOBAL       2 '@println'
0017    | OP_GET_GLOBAL       4 '@ceil'
0019    | OP_CONSTANT         5 '2.5'
0021    | OP_CALL             1
0023    | OP_CALL             1
0025    | OP_POP
0026    5 OP_NIL
0027    | OP_RETURN
== ceil ==
0000    1 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '!'
0004    | OP_ADD
0005    | OP_RETURN
