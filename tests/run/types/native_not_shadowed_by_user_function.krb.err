== <script> ==
0000    1 OP_CLOSURE          1 <fn ceil>
0002    | OP_DEFINE_GLOBAL    0 'ceil'
0004    4 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    5 OP_NIL
0009    | OP_RETURN
== ceil ==
0000    1 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '!'
0004    | OP_ADD
0005    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'ceil'
0004    | OP_CONSTANT         2 'hello'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    4 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       3 '@ceil'
0015    | OP_CONSTANT         4 '2.5'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
