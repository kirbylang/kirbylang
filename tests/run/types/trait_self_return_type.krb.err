0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    6 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    7 OP_NIL
0016    | OP_FIELD            4 'y' public mutable
0020    8 OP_POP
0021   10 OP_GET_GLOBAL       2 'Point'
0023   11 OP_CLOSURE          6 <fn clone>
0025    | OP_METHOD           5 'clone'
0027   12 OP_POP
0028   14 OP_GET_GLOBAL       2 'Point'
0030    | OP_CONSTANT         3 'x'
