0034    | OP_CONSTANT         4 'y'
0036    | OP_CONSTANT         9 '4'
0038    | OP_STRUCT_INIT      2
0040    | OP_DEFINE_GLOBAL    7 'p'
0042   18 OP_NIL
0043    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 'p'
0002    | OP_INVOKE        (0 args)    1 'clone'
0005   16 OP_GET_GLOBAL       2 '@println'
0007    | OP_GET_LOCAL        1
0009    | OP_GET_PROPERTY     3 'x'
0011    | OP_CALL             1
0013    | OP_POP
0014   17 OP_GET_GLOBAL       2 '@println'
0016    | OP_GET_LOCAL        1
0018    | OP_GET_PROPERTY     4 'y'
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
== clone ==
