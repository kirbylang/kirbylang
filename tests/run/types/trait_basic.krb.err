== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' public mutable
0011    3 OP_NIL
0012    | OP_FIELD            2 'y' public mutable
0016    4 OP_POP
0017    6 OP_GET_GLOBAL       0 'Point'
0019    7 OP_CLOSURE          4 <fn toString>
0021    | OP_METHOD           3 'toString'
0023    8 OP_POP
0024   10 OP_GET_GLOBAL       0 'Point'
0026    | OP_CONSTANT         1 'x'
0028    | OP_CONSTANT         6 '1'
0030    | OP_CONSTANT         2 'y'
0032    | OP_CONSTANT         7 '2'
0034    | OP_STRUCT_INIT      2
0036    | OP_DEFINE_GLOBAL    5 'p'
0038   11 OP_GET_GLOBAL       8 '@println'
0040    | OP_GET_GLOBAL       5 'p'
0042    | OP_INVOKE        (0 args)    3 'toString'
0045    | OP_CALL             1
0047    | OP_POP
0048   12 OP_NIL
0049    | OP_RETURN
== toString ==
0000    7 OP_CONSTANT         0 'Point'
0002    | OP_RETURN
