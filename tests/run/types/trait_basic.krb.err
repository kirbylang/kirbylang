== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'y' public mutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Point'
0023    7 OP_CLOSURE          6 <fn toString>
0025    | OP_METHOD           5 'toString'
0027    8 OP_POP
0028   10 OP_GET_GLOBAL       2 'Point'
0030    | OP_CONSTANT         3 'x'
0032    | OP_CONSTANT         8 '1'
0034    | OP_CONSTANT         4 'y'
0036    | OP_CONSTANT         9 '2'
0038    | OP_STRUCT_INIT      2
0040    | OP_DEFINE_GLOBAL    7 'p'
0042   12 OP_NIL
0043    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'p'
0004    | OP_INVOKE        (0 args)    2 'toString'
0007    | OP_CALL             1
0009    | OP_POP
0010    | OP_NIL
0011    | OP_RETURN
== toString ==
0000    7 OP_CONSTANT         0 'Point'
0002    | OP_RETURN
