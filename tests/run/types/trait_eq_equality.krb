struct Box {
    pub var value: f64;
}

impl Default for Box {
    fun default(): Self = Self { value: 0 };
}

impl Eq for Box {
    fun equals(self, other: Self): bool = self.value == self.value;
}

let a = Box.default();
let b = Box.default();

@println(a == a);
@println(a.equals(a));

@println(b == b);
@println(b.equals(b));

@println(a == b);
@println(a.equals(b));
