struct Point {
    pub var x: f64;
    pub var y: f64;
}

impl Point {
    pub fun origin(): Self = Self { x: 0, y: 0 };

    pub fun translate(self, dx: f64, dy: f64): Self =
        Self { x: self.x + dx, y: self.y + dy };

    pub fun equals(self, other: Self): bool = self.x == other.x and self.y == other.y;
}

var p = Point.origin();
var p2 = p.translate(3, 4);
@println(p2.x);
@println(p2.y);
@println(p2.equals(p2));
