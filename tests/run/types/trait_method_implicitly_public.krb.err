== <script> ==
0000   10 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Point'
0018    6 OP_CLOSURE          5 <fn toString>
0020    | OP_TRAIT_METHOD     4 'toString'    6 'Display.toString'
0023    7 OP_POP
0024    9 OP_GET_GLOBAL       2 'Point'
0026    | OP_CONSTANT         3 'x'
0028    | OP_CONSTANT         8 '1'
0030    | OP_STRUCT_INIT      1
0032    | OP_DEFINE_GLOBAL    7 'p'
0034   11 OP_NIL
0035    | OP_RETURN
== main ==
0000   10 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'p'
0004    | OP_INVOKE        (0 args)    2 'toString'
0007    | OP_CALL             1
0009    | OP_POP
0010    | OP_NIL
0011    | OP_RETURN
== toString ==
0000    6 OP_CONSTANT         0 'Point'
0002    | OP_RETURN
