== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   12 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@version'
0002    | OP_CALL             0
0004    2 OP_GET_GLOBAL       1 '@ceil'
0006    | OP_CONSTANT         2 '1.2'
0008    | OP_CALL             1
0010    3 OP_GET_GLOBAL       3 '@fileExists'
0012    | OP_CONSTANT         4 './does/not/exist.txt'
0014    | OP_CALL             1
0016    4 OP_GET_GLOBAL       5 '@parseInt'
0018    | OP_CONSTANT         6 '42'
0020    | OP_CALL             1
0022    5 OP_GET_GLOBAL       7 '@parseFloat'
0024    | OP_CONSTANT         8 '0.5'
0026    | OP_CALL             1
0028    7 OP_GET_GLOBAL       9 '@println'
0030    | OP_GET_LOCAL        2
0032    | OP_CALL             1
0034    | OP_POP
0035    8 OP_GET_GLOBAL       9 '@println'
0037    | OP_GET_LOCAL        3
0039    | OP_CALL             1
0041    | OP_POP
0042    9 OP_GET_GLOBAL       9 '@println'
0044    | OP_GET_LOCAL        4
0046    | OP_CALL             1
0048    | OP_POP
0049   10 OP_GET_GLOBAL       9 '@println'
0051    | OP_GET_LOCAL        5
0053    | OP_CALL             1
0055    | OP_POP
0056   11 OP_GET_GLOBAL       9 '@println'
0058    | OP_GET_GLOBAL      10 '@numberToString'
0060    | OP_GET_LOCAL        4
0062    | OP_CALL             1
0064    | OP_CONSTANT        11 '!'
0066    | OP_ADD
0067    | OP_CALL             1
0069    | OP_POP
0070    | OP_NIL
0071    | OP_RETURN
