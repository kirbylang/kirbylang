0046    | OP_CONSTANT        13 '2.25'
0048    | OP_STRUCT_INIT      1
0050    | OP_DEFINE_GLOBAL   12 'heavy'
0052   20 OP_NIL
0053    | OP_RETURN
== main ==
0000   17 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'light'
0004    | OP_GET_GLOBAL       3 'heavy'
