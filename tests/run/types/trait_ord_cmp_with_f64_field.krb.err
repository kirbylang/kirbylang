0018    | OP_POP
0019    | OP_GET_LOCAL        0
0021    | OP_GET_PROPERTY     0 'kg'
0023    | OP_GET_LOCAL        1
0025    | OP_GET_PROPERTY     0 'kg'
0027    | OP_GREATER
0028    | OP_JUMP_IF_FALSE   28 -> 37
0031    | OP_POP
0032    | OP_CONSTANT         2 '1'
