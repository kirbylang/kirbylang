== cmp ==
0000   11 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'kg'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'kg'
0008    | OP_LESS
0009    | OP_JUMP_IF_FALSE    9 -> 18
0012    | OP_POP
0013    | OP_CONSTANT         1 '-1'
