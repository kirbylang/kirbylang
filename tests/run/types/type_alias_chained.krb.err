== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_CONSTANT         3 '7'
0006    | OP_DEFINE_GLOBAL    2 'value'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'value'
0004    | OP_CALL             1
0006    | OP_POP
0007    | OP_NIL
0008    | OP_RETURN
