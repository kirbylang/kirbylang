== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    9 OP_CLOSURE          3 <fn greet>
0006    | OP_DEFINE_GLOBAL    2 'greet'
0008   10 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_NIL
0001    5 OP_GET_GLOBAL       0 'greet'
0003    | OP_SET_LOCAL        1
0005    | OP_POP
0006    7 OP_GET_LOCAL        1
0008    | OP_CALL             0
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
== greet ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'hi'
0004    | OP_CALL             1
0006    | OP_POP
0007    | OP_NIL
0008    | OP_RETURN
