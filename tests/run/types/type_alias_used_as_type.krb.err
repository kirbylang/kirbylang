== <script> ==
0000    7 OP_CLOSURE          1 <fn add>
0002    | OP_DEFINE_GLOBAL    0 'add'
0004   11 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    4 OP_CONSTANT         5 '42'
0010    | OP_DEFINE_GLOBAL    4 'count'
0012    5 OP_CONSTANT         7 'Kirby'
0014    | OP_DEFINE_GLOBAL    6 'name'
0016   12 OP_NIL
0017    | OP_RETURN
== add ==
0000    7 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'count'
0004    | OP_CALL             1
0006    | OP_POP
0007   10 OP_GET_GLOBAL       0 '@println'
0009    | OP_GET_GLOBAL       2 'name'
0011    | OP_CALL             1
0013    | OP_POP
0014   11 OP_GET_GLOBAL       0 '@println'
0016    | OP_GET_GLOBAL       3 'add'
0018    | OP_CONSTANT         4 '1'
0020    | OP_CONSTANT         5 '2'
0022    | OP_CALL             2
0024    | OP_CALL             1
0026    | OP_POP
0027    | OP_NIL
0028    | OP_RETURN
