0006    | OP_DEFINE_GLOBAL    2 'count'
0008    5 OP_CONSTANT         5 'Kirby'
0010    | OP_DEFINE_GLOBAL    4 'name'
0012    9 OP_GET_GLOBAL       6 '@println'
0014    | OP_GET_GLOBAL       2 'count'
