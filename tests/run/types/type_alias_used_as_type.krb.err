0018    | OP_POP
0019   10 OP_GET_GLOBAL       6 '@println'
0021    | OP_GET_GLOBAL       4 'name'
0023    | OP_CALL             1
0025    | OP_POP
0026   11 OP_GET_GLOBAL       6 '@println'
0028    | OP_GET_GLOBAL       0 'add'
0030    | OP_CONSTANT         7 '1'
0032    | OP_CONSTANT         8 '2'
0034    | OP_CALL             2
