== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    6 OP_NIL
0017    | OP_RETURN
== main ==
0000    5 OP_NIL
0001    | OP_RETURN
