== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       1 '@ceil'
0002    | OP_DEFINE_GLOBAL    0 'round'
0004    3 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'round'
