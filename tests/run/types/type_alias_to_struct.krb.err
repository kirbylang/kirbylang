== <script> ==
0000   12 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    3 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    4 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    5 OP_POP
0016    7 OP_GET_GLOBAL       2 'Point'
0018    8 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022    9 OP_POP
0023   13 OP_NIL
0024    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         2 '3'
0004    | OP_INVOKE        (1 args)    1 'new'
0007   12 OP_GET_GLOBAL       3 '@println'
0009    | OP_GET_LOCAL        1
0011    | OP_GET_PROPERTY     4 'x'
0013    | OP_CALL             1
0015    | OP_POP
0016    | OP_NIL
0017    | OP_RETURN
== new ==
0000    8 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
