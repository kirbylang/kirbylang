== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    3 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    4 OP_NIL
0007    | OP_FIELD            1 'x' public mutable
0011    5 OP_POP
0012    7 OP_GET_GLOBAL       0 'Point'
0014    8 OP_CLOSURE          3 <fn new>
0016    | OP_METHOD           2 'new'
0018    9 OP_POP
0019   11 OP_GET_GLOBAL       0 'Point'
0021    | OP_CONSTANT         5 '3'
0023    | OP_INVOKE        (1 args)    2 'new'
0026    | OP_DEFINE_GLOBAL    4 'p'
0028   12 OP_GET_GLOBAL       6 '@println'
0030    | OP_GET_GLOBAL       4 'p'
0032    | OP_GET_PROPERTY     1 'x'
0034    | OP_CALL             1
0036    | OP_POP
0037   13 OP_NIL
0038    | OP_RETURN
== new ==
0000    8 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
