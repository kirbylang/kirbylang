== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    9 OP_CLOSURE          3 <fn run>
0006    | OP_DEFINE_GLOBAL    2 'run'
0008   10 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_NIL
0001    5 OP_GET_GLOBAL       0 'run'
0003    | OP_SET_LOCAL        1
0005    | OP_POP
0006    7 OP_GET_GLOBAL       1 '@println'
0008    | OP_GET_LOCAL        1
0010    | OP_CLOSURE          2 <fn lambda0x1>
0012    | OP_CONSTANT         3 '5'
0014    | OP_CALL             2
0016    | OP_CALL             1
0018    | OP_POP
0019    | OP_NIL
0020    | OP_RETURN
== lambda0x1 ==
0000    7 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '1'
0004    | OP_ADD
0005    | OP_RETURN
== run ==
0000    9 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_CALL             1
0006    | OP_RETURN
