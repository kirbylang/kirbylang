== <script> ==
0000    7 OP_CLOSURE          1 <fn add>
0002    | OP_DEFINE_GLOBAL    0 'add'
0004    3 OP_CONSTANT         3 '5'
0006    | OP_DEFINE_GLOBAL    2 'x'
0008    5 OP_GET_GLOBAL       4 '@println'
0010    | OP_GET_GLOBAL       2 'x'
0012    | OP_CALL             1
0014    | OP_POP
0015    9 OP_GET_GLOBAL       4 '@println'
0017    | OP_GET_GLOBAL       0 'add'
0019    | OP_CONSTANT         5 '1'
0021    | OP_CONSTANT         6 '2'
0023    | OP_CALL             2
0025    | OP_CALL             1
0027    | OP_POP
0028   10 OP_NIL
0029    | OP_RETURN
== add ==
0000    7 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
