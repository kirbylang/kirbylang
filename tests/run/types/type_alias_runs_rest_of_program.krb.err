== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   11 OP_CLOSURE          3 <fn add>
0006    | OP_DEFINE_GLOBAL    2 'add'
0008    3 OP_CONSTANT         5 '5'
0010    | OP_DEFINE_GLOBAL    4 'x'
0012   12 OP_NIL
0013    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'x'
0004    | OP_CALL             1
0006    | OP_POP
0007    9 OP_GET_GLOBAL       0 '@println'
0009    | OP_GET_GLOBAL       2 'add'
0011    | OP_CONSTANT         3 '1'
0013    | OP_CONSTANT         4 '2'
0015    | OP_CALL             2
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
== add ==
0000   11 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
