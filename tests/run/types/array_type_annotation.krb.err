== <script> ==
0000   12 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2.5'
0008    | OP_LIST             2
0010    | OP_DEFINE_GLOBAL    2 'floats'
0012   13 OP_NIL
0013    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'floats'
0004    | OP_CALL             1
0006    | OP_POP
0007    4 OP_LIST             0
0009    5 OP_GET_GLOBAL       2 '@listPush'
0011    | OP_GET_LOCAL        1
0013    | OP_CONSTANT         3 'a'
0015    | OP_CALL             2
0017    | OP_POP
0018    6 OP_GET_GLOBAL       0 '@println'
0020    | OP_GET_LOCAL        1
0022    | OP_CALL             1
0024    | OP_POP
0025    8 OP_CONSTANT         4 '1'
0027    | OP_LIST             1
0029    | OP_CONSTANT         5 '2'
0031    | OP_CONSTANT         6 '3'
0033    | OP_LIST             2
0035    | OP_LIST             2
0037    9 OP_GET_GLOBAL       0 '@println'
0039    | OP_GET_LOCAL        2
0041    | OP_CALL             1
0043    | OP_POP
0044   11 OP_GET_GLOBAL       7 '@strSplit'
0046    | OP_CONSTANT         8 'a,b'
0048    | OP_CONSTANT         9 ','
0050    | OP_CALL             2
0052   12 OP_GET_GLOBAL       0 '@println'
0054    | OP_GET_GLOBAL      10 '@listLen'
0056    | OP_GET_LOCAL        3
0058    | OP_CALL             1
0060    | OP_CALL             1
0062    | OP_POP
0063    | OP_NIL
0064    | OP_RETURN
