== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    3 OP_CONSTANT         3 '9.5'
0006    | OP_CONSTANT         4 '7'
0008    | OP_LIST             2
0010    | OP_DEFINE_GLOBAL    2 'scores'
0012    5 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'scores'
0004    | OP_CALL             1
0006    | OP_POP
0007    | OP_NIL
0008    | OP_RETURN
