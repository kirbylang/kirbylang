0020    | OP_GET_GLOBAL       4 'Bag'
0022   11 OP_NIL
0023    | OP_FIELD            5 'items' public mutable
0027   12 OP_POP
0028    5 OP_GET_GLOBAL       2 'Box'
0030    6 OP_CLOSURE          7 <fn wrap>
0032    | OP_METHOD           6 'wrap'
0034    7 OP_CLOSURE          9 <fn zero>
0036    | OP_METHOD           8 'zero'
0038    8 OP_POP
0039   14 OP_GET_GLOBAL       4 'Bag'
