== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' public mutable
0011    3 OP_NIL
0012    | OP_FIELD            2 'y' public mutable
0016    4 OP_POP
0017    6 OP_GET_GLOBAL       0 'Point'
0019    7 OP_CLOSURE          4 <fn new>
0021    | OP_METHOD           3 'new'
0023    8 OP_POP
0024   10 OP_GET_GLOBAL       0 'Point'
0026    | OP_CONSTANT         6 '1'
0028    | OP_CONSTANT         7 '2'
0030    | OP_INVOKE        (2 args)    3 'new'
0033    | OP_DEFINE_GLOBAL    5 'p'
0035   11 OP_GET_GLOBAL       8 '@println'
0037    | OP_GET_GLOBAL       5 'p'
0039    | OP_GET_PROPERTY     1 'x'
0041    | OP_CALL             1
0043    | OP_POP
0044   12 OP_GET_GLOBAL       8 '@println'
0046    | OP_GET_GLOBAL       5 'p'
0048    | OP_GET_PROPERTY     2 'y'
0050    | OP_CALL             1
0052    | OP_POP
0053   13 OP_NIL
0054    | OP_RETURN
== new ==
0000    7 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_CONSTANT         2 'y'
0008    | OP_GET_LOCAL        2
0010    | OP_STRUCT_INIT      2
0012    | OP_RETURN
