== <script> ==
0000   17 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'y' public mutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Point'
0023    7 OP_CLOSURE          6 <fn toString>
0025    | OP_METHOD           5 'toString'
0027    8 OP_POP
0028   10 OP_GET_GLOBAL       2 'Point'
0030   11 OP_CLOSURE          8 <fn equals>
0032    | OP_METHOD           7 'equals'
0034   12 OP_POP
0035   14 OP_GET_GLOBAL       2 'Point'
0037    | OP_CONSTANT         3 'x'
0039    | OP_CONSTANT        10 '1'
0041    | OP_CONSTANT         4 'y'
0043    | OP_CONSTANT        11 '2'
0045    | OP_STRUCT_INIT      2
0047    | OP_DEFINE_GLOBAL    9 'a'
0049   18 OP_NIL
0050    | OP_RETURN
== main ==
0000   16 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_INVOKE        (0 args)    2 'toString'
0007    | OP_CALL             1
0009    | OP_POP
0010   17 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       1 'a'
0014    | OP_GET_GLOBAL       1 'a'
0016    | OP_INVOKE        (1 args)    3 'equals'
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
== toString ==
0000    7 OP_CONSTANT         0 'Point'
0002    | OP_RETURN
== equals ==
0000   11 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'x'
0008    | OP_EQUAL
0009    | OP_JUMP_IF_FALSE    9 -> 22
0012    | OP_POP
0013    | OP_GET_LOCAL        0
0015    | OP_GET_PROPERTY     1 'y'
0017    | OP_GET_LOCAL        1
0019    | OP_GET_PROPERTY     1 'y'
0021    | OP_EQUAL
0022    | OP_RETURN
