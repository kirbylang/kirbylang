== <script> ==
0000   16 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Money'
0006    | OP_DEFINE_GLOBAL    2 'Money'
0008    | OP_GET_GLOBAL       2 'Money'
0010    2 OP_NIL
0011    | OP_FIELD            3 'cents' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Money'
0018    6 OP_CLOSURE          5 <fn cmp>
0020    | OP_TRAIT_METHOD     4 'cmp'    6 'Ord.cmp'
0023    7 OP_POP
0024    9 OP_GET_GLOBAL       2 'Money'
0026   10 OP_CLOSURE          8 <fn equals>
0028    | OP_TRAIT_METHOD     7 'equals'    9 'Eq.equals'
0031   11 OP_POP
0032   13 OP_GET_GLOBAL       2 'Money'
0034    | OP_CONSTANT         3 'cents'
0036    | OP_CONSTANT        11 '500'
0038    | OP_STRUCT_INIT      1
0040    | OP_DEFINE_GLOBAL   10 'a'
0042   14 OP_GET_GLOBAL       2 'Money'
0044    | OP_CONSTANT         3 'cents'
0046    | OP_CONSTANT        13 '300'
0048    | OP_STRUCT_INIT      1
0050    | OP_DEFINE_GLOBAL   12 'b'
0052   17 OP_NIL
0053    | OP_RETURN
== main ==
0000   16 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_GET_GLOBAL       3 'b'
0006    | OP_INVOKE        (1 args)    2 'cmp'
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== cmp ==
0000    6 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'cents'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'cents'
0008    | OP_SUBTRACT
0009    | OP_RETURN
== equals ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'cents'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'cents'
0008    | OP_EQUAL
0009    | OP_RETURN
