== <script> ==
0000    1 OP_STRUCT           0 'Struct'
0002    | OP_DEFINE_GLOBAL    0 'Struct'
0004    | OP_GET_GLOBAL       0 'Struct'
0006    | OP_POP
0007    3 OP_GET_GLOBAL       0 'Struct'
0009    4 OP_CLOSURE          2 <fn new>
0011    | OP_METHOD           1 'new'
0013    5 OP_POP
0014    7 OP_GET_GLOBAL       0 'Struct'
0016    | OP_INVOKE        (0 args)    1 'new'
0019    | OP_DEFINE_GLOBAL    3 's'
0021    8 OP_GET_GLOBAL       4 '@println'
0023    | OP_GET_GLOBAL       3 's'
0025    | OP_CALL             1
0027    | OP_POP
0028    9 OP_NIL
0029    | OP_RETURN
== new ==
0000    4 OP_GET_GLOBAL       0 'Struct'
0002    | OP_STRUCT_INIT      0
0004    | OP_RETURN
