== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    3 OP_GET_GLOBAL       2 'Struct'
0013    4 OP_CLOSURE          4 <fn new>
0015    | OP_METHOD           3 'new'
0017    5 OP_POP
0018    9 OP_NIL
0019    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 'Struct'
0002    | OP_INVOKE        (0 args)    1 'new'
0005    8 OP_GET_GLOBAL       2 '@println'
0007    | OP_GET_LOCAL        1
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== new ==
0000    4 OP_GET_GLOBAL       0 'Struct'
0002    | OP_STRUCT_INIT      0
0004    | OP_RETURN
