== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'y' public mutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Point'
0023    7 OP_CLOSURE          6 <fn equals>
0025    | OP_METHOD           5 'equals'
0027    8 OP_POP
0028   10 OP_GET_GLOBAL       2 'Point'
0030    | OP_CONSTANT         3 'x'
0032    | OP_CONSTANT         8 '1'
0034    | OP_CONSTANT         4 'y'
0036    | OP_CONSTANT         9 '2'
0038    | OP_STRUCT_INIT      2
0040    | OP_DEFINE_GLOBAL    7 'a'
0042   14 OP_NIL
0043    | OP_RETURN
== main ==
0000   12 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_GET_GLOBAL       1 'a'
0006    | OP_INVOKE        (1 args)    2 'equals'
0009    | OP_CALL             1
0011    | OP_POP
0012   13 OP_GET_GLOBAL       0 '@println'
0014    | OP_GET_GLOBAL       1 'a'
0016    | OP_GET_GLOBAL       1 'a'
0018    | OP_INVOKE        (1 args)    2 'equals'
0021    | OP_CALL             1
0023    | OP_POP
0024    | OP_NIL
0025    | OP_RETURN
== equals ==
0000    7 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     0 'x'
0008    | OP_EQUAL
0009    | OP_JUMP_IF_FALSE    9 -> 22
0012    | OP_POP
0013    | OP_GET_LOCAL        0
0015    | OP_GET_PROPERTY     1 'y'
0017    | OP_GET_LOCAL        1
0019    | OP_GET_PROPERTY     1 'y'
0021    | OP_EQUAL
0022    | OP_RETURN
