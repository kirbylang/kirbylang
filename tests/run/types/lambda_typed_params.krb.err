== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CLOSURE          3 <fn lambda0x1>
0006    | OP_DEFINE_GLOBAL    2 'add'
0008    4 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'add'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '2'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
== lambda0x1 ==
0000    1 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    | OP_RETURN
