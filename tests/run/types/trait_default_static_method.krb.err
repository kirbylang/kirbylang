== <script> ==
0000   12 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Point'
0006    | OP_DEFINE_GLOBAL    2 'Point'
0008    | OP_GET_GLOBAL       2 'Point'
0010    2 OP_NIL
0011    | OP_FIELD            3 'x' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'y' public mutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Point'
0023    7 OP_CLOSURE          6 <fn default>
0025    | OP_METHOD           5 'default'
0027    8 OP_POP
0028   13 OP_NIL
0029    | OP_RETURN
== main ==
0000   10 OP_GET_GLOBAL       0 'Point'
0002    | OP_INVOKE        (0 args)    1 'default'
0005   11 OP_GET_GLOBAL       2 '@println'
0007    | OP_GET_LOCAL        1
0009    | OP_GET_PROPERTY     3 'x'
0011    | OP_CALL             1
0013    | OP_POP
0014   12 OP_GET_GLOBAL       2 '@println'
0016    | OP_GET_LOCAL        1
0018    | OP_GET_PROPERTY     4 'y'
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
== default ==
0000    7 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_CONSTANT         2 '0'
0006    | OP_CONSTANT         3 'y'
0008    | OP_CONSTANT         2 '0'
0010    | OP_STRUCT_INIT      2
0012    | OP_RETURN
