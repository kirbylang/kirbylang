== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' public mutable
0011    3 OP_NIL
0012    | OP_FIELD            2 'y' public mutable
0016    4 OP_POP
0017    6 OP_GET_GLOBAL       0 'Point'
0019    7 OP_CLOSURE          4 <fn default>
0021    | OP_METHOD           3 'default'
0023    8 OP_POP
0024   10 OP_GET_GLOBAL       0 'Point'
0026    | OP_INVOKE        (0 args)    3 'default'
0029    | OP_DEFINE_GLOBAL    5 'origin'
0031   11 OP_GET_GLOBAL       6 '@println'
0033    | OP_GET_GLOBAL       5 'origin'
0035    | OP_GET_PROPERTY     1 'x'
0037    | OP_CALL             1
0039    | OP_POP
0040   12 OP_GET_GLOBAL       6 '@println'
0042    | OP_GET_GLOBAL       5 'origin'
0044    | OP_GET_PROPERTY     2 'y'
0046    | OP_CALL             1
0048    | OP_POP
0049   13 OP_NIL
0050    | OP_RETURN
== default ==
0000    7 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_CONSTANT         2 '0'
0006    | OP_CONSTANT         3 'y'
0008    | OP_CONSTANT         2 '0'
0010    | OP_STRUCT_INIT      2
0012    | OP_RETURN
