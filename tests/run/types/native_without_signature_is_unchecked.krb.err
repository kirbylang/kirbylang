== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@typeof'
0002    | OP_CONSTANT         1 '3'
0004    | OP_CALL             1
0006    6 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_LOCAL        1
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
