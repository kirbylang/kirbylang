== <script> ==
0000    6 OP_CLOSURE          1 <fn describe>
0002    | OP_DEFINE_GLOBAL    0 'describe'
0004   10 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_CONSTANT         5 'World'
0010    | OP_DEFINE_GLOBAL    4 'name'
0012   11 OP_NIL
0013    | OP_RETURN
== describe ==
0000    4 OP_CONSTANT         0 'Hello'
0002    5 OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_GET_LOCAL        1
0006    | OP_CONSTANT         2 ', '
0008    | OP_GET_GLOBAL       3 '@numberToString'
0010    | OP_CONSTANT         4 '2'
0012    | OP_GET_LOCAL        6
0014    | OP_CONSTANT         5 '3'
0016    | OP_MULTIPLY
0017    | OP_CLOSE_BLOCK_EXPR    1
0019    | OP_CALL             1
0021    | OP_CONSTANT         6 ' times '
0023    | OP_GET_GLOBAL       7 'name'
0025    | OP_CONSTANT         8 ' and '
0027    | OP_GET_GLOBAL       9 '@boolToString'
0029    | OP_TRUE
0030    | OP_GET_LOCAL       10
0032    | OP_NOT
0033    | OP_CLOSE_BLOCK_EXPR    1
0035    | OP_CALL             1
0037    | OP_LIST             7
0039    | OP_CALL             1
0041    | OP_RETURN
== main ==
0000    8 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'describe'
0004    | OP_CALL             0
0006    | OP_CALL             1
0008    | OP_POP
0009    9 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       2 '@strConcat'
0013    | OP_CONSTANT         3 'a '
0015    | OP_GET_GLOBAL       4 'name'
0017    | OP_CONSTANT         5 ' b '
0019    | OP_CONSTANT         6 'x'
0021    | OP_GET_LOCAL        6
0023    | OP_GET_LOCAL        6
0025    | OP_ADD
0026    | OP_CLOSE_BLOCK_EXPR    1
0028    | OP_CONSTANT         7 ' c'
0030    | OP_LIST             5
0032    | OP_CALL             1
0034    | OP_CALL             1
0036    | OP_POP
0037   10 OP_GET_GLOBAL       0 '@println'
0039    | OP_GET_GLOBAL       2 '@strConcat'
0041    | OP_CONSTANT         8 'a'
0043    | OP_CONSTANT         9 'b'
0045    | OP_GET_LOCAL        4
0047    | OP_CLOSE_BLOCK_EXPR    1
0049    | OP_CONSTANT        10 'c'
0051    | OP_GET_GLOBAL       4 'name'
0053    | OP_LIST             4
0055    | OP_CALL             1
0057    | OP_CALL             1
0059    | OP_POP
0060    | OP_NIL
0061    | OP_RETURN
