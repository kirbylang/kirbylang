== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'World'
0006    | OP_DEFINE_GLOBAL    2 'name'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_CONSTANT         2 'a '
0006    | OP_GET_GLOBAL       1 '@strConcat'
0008    | OP_CONSTANT         3 'b '
0010    | OP_GET_GLOBAL       4 'name'
0012    | OP_CONSTANT         5 ' c'
0014    | OP_LIST             3
0016    | OP_CALL             1
0018    | OP_GET_LOCAL        4
0020    | OP_CONSTANT         6 '!'
0022    | OP_ADD
0023    | OP_CLOSE_BLOCK_EXPR    1
0025    | OP_CONSTANT         7 ' d'
0027    | OP_LIST             3
0029    | OP_CALL             1
0031    | OP_CALL             1
0033    | OP_POP
0034    4 OP_GET_GLOBAL       0 '@println'
0036    | OP_GET_GLOBAL       1 '@strConcat'
0038    | OP_CONSTANT         8 'x '
0040    | OP_GET_GLOBAL       4 'name'
0042    | OP_GET_LOCAL        4
0044    | OP_CONSTANT         9 '?'
0046    | OP_ADD
0047    | OP_CLOSE_BLOCK_EXPR    0
0049    | OP_CLOSE_BLOCK_EXPR    1
0051    | OP_CONSTANT        10 ' y'
0053    | OP_LIST             3
0055    | OP_CALL             1
0057    | OP_CALL             1
0059    | OP_POP
0060    | OP_NIL
0061    | OP_RETURN
