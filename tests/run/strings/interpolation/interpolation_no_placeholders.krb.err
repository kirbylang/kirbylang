== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    3 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'plain text'
0004    | OP_CALL             1
0006    | OP_POP
0007    2 OP_GET_GLOBAL       0 '@println'
0009    | OP_CONSTANT         2 ''
0011    | OP_CALL             1
0013    | OP_POP
0014    | OP_NIL
0015    | OP_RETURN
