== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '3'
0006    | OP_DEFINE_GLOBAL    2 'count'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_CONSTANT         2 'count='
0006    | OP_GET_GLOBAL       3 '@numberToString'
0008    | OP_GET_GLOBAL       4 'count'
0010    | OP_CALL             1
0012    | OP_LIST             2
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    4 OP_GET_GLOBAL       0 '@println'
0021    | OP_GET_GLOBAL       1 '@strConcat'
0023    | OP_CONSTANT         5 'pi is roughly '
0025    | OP_GET_GLOBAL       3 '@numberToString'
0027    | OP_CONSTANT         6 '3.14159'
0029    | OP_CALL             1
0031    | OP_LIST             2
0033    | OP_CALL             1
0035    | OP_CALL             1
0037    | OP_POP
0038    | OP_NIL
0039    | OP_RETURN
