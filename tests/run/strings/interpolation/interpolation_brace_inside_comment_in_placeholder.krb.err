== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    2 OP_CONSTANT         5 '2'
0010    | OP_DEFINE_GLOBAL    4 'b'
0012    9 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@numberToString'
0004    | OP_GET_GLOBAL       2 'a'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    6 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       3 '@strConcat'
0015    | OP_GET_GLOBAL       1 '@numberToString'
0017    | OP_GET_GLOBAL       2 'a'
0019    | OP_CALL             1
0021    7 OP_CONSTANT         4 ' and '
0023    | OP_GET_GLOBAL       1 '@numberToString'
0025    | OP_GET_GLOBAL       5 'b'
0027    | OP_CALL             1
0029    6 OP_LIST             3
0031    | OP_CALL             1
0033    | OP_CALL             1
0035    | OP_POP
0036    8 OP_NIL
0037    | OP_RETURN
