== <script> ==
0000    1 OP_CONSTANT         1 'World'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    3 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       3 '@strConcat'
0008    | OP_CONSTANT         4 '{name} is '
0010    | OP_GET_GLOBAL       0 'name'
0012    | OP_ARRAY            2
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    4 OP_GET_GLOBAL       2 '@println'
0021    | OP_CONSTANT         5 'tab:	quote:"'
0023    | OP_CALL             1
0025    | OP_POP
0026    5 OP_NIL
0027    | OP_RETURN
