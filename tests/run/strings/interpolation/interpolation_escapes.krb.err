== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'World'
0006    | OP_DEFINE_GLOBAL    2 'name'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_CONSTANT         2 '{name} is '
0006    | OP_GET_GLOBAL       3 'name'
0008    | OP_LIST             2
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_POP
0015    4 OP_GET_GLOBAL       0 '@println'
0017    | OP_CONSTANT         4 'tab:	quote:"'
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
