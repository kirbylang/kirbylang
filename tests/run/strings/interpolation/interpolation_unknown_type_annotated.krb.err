== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@typeof'
0002    | OP_CONSTANT         1 '3'
0004    | OP_CALL             1
0006    3 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_GLOBAL       3 '@strConcat'
0010    | OP_CONSTANT         4 'type='
0012    | OP_GET_LOCAL        1
0014    | OP_LIST             2
0016    | OP_CALL             1
0018    | OP_CALL             1
0020    | OP_POP
0021    | OP_NIL
0022    | OP_RETURN
