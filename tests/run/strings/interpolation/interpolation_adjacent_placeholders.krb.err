== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         2 'a'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    2 OP_CONSTANT         3 'b'
0010    | OP_DEFINE_GLOBAL    3 'b'
0012    5 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_GET_GLOBAL       2 'a'
0006    | OP_GET_GLOBAL       3 'b'
0008    | OP_LIST             2
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_POP
0015    | OP_NIL
0016    | OP_RETURN
