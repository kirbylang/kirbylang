== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         0 'a'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    2 OP_CONSTANT         1 'b'
0006    | OP_DEFINE_GLOBAL    1 'b'
0008    4 OP_GET_GLOBAL       2 '@println'
0010    | OP_GET_GLOBAL       3 '@strConcat'
0012    | OP_GET_GLOBAL       0 'a'
0014    | OP_GET_GLOBAL       1 'b'
0016    | OP_ARRAY            2
0018    | OP_CALL             1
0020    | OP_CALL             1
0022    | OP_POP
0023    5 OP_NIL
0024    | OP_RETURN
