== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'World'
0006    | OP_DEFINE_GLOBAL    2 'name'
0008    8 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '}'
0004    | OP_CALL             1
0006    | OP_POP
0007    4 OP_GET_GLOBAL       0 '@println'
0009    | OP_CONSTANT         2 '{'
0011    | OP_CALL             1
0013    | OP_POP
0014    5 OP_GET_GLOBAL       0 '@println'
0016    | OP_GET_GLOBAL       3 '@strConcat'
0018    | OP_CONSTANT         4 '{}'
0020    | OP_CONSTANT         5 ' and '
0022    | OP_GET_GLOBAL       6 'name'
0024    | OP_LIST             3
0026    | OP_CALL             1
0028    | OP_CALL             1
0030    | OP_POP
0031    6 OP_GET_GLOBAL       0 '@println'
0033    | OP_GET_GLOBAL       3 '@strConcat'
0035    | OP_CONSTANT         7 'a '
0037    | OP_GET_GLOBAL       3 '@strConcat'
0039    | OP_CONSTANT         1 '}'
0041    | OP_GET_GLOBAL       6 'name'
0043    | OP_CONSTANT         2 '{'
0045    | OP_LIST             3
0047    | OP_CALL             1
0049    | OP_CONSTANT         8 ' b'
0051    | OP_LIST             3
0053    | OP_CALL             1
0055    | OP_CALL             1
0057    | OP_POP
0058    7 OP_GET_GLOBAL       0 '@println'
0060    | OP_CONSTANT         9 '{{x}}'
0062    | OP_CALL             1
0064    | OP_POP
0065    | OP_NIL
0066    | OP_RETURN
