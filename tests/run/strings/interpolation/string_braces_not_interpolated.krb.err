== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'a'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    2 OP_GET_GLOBAL       2 '@println'
0006    | OP_CONSTANT         3 'a {name} b'
0008    | OP_CALL             1
0010    | OP_POP
0011    3 OP_NIL
0012    | OP_RETURN
