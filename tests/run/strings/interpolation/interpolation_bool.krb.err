== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_TRUE
0005    | OP_DEFINE_GLOBAL    2 'ok'
0007    4 OP_NIL
0008    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_CONSTANT         2 'ok='
0006    | OP_GET_GLOBAL       3 '@boolToString'
0008    | OP_GET_GLOBAL       4 'ok'
0010    | OP_CALL             1
0012    | OP_CONSTANT         5 ', not ok='
0014    | OP_GET_GLOBAL       3 '@boolToString'
0016    | OP_GET_GLOBAL       4 'ok'
0018    | OP_NOT
0019    | OP_CALL             1
0021    | OP_LIST             4
0023    | OP_CALL             1
0025    | OP_CALL             1
0027    | OP_POP
0028    | OP_NIL
0029    | OP_RETURN
