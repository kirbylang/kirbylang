== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '123'
0006    | OP_DEFINE_GLOBAL    2 'n'
0008    2 OP_CONSTANT         5 'World'
0010    | OP_DEFINE_GLOBAL    4 'name'
0012   12 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '{123}'
0004    | OP_CALL             1
0006    | OP_POP
0007    5 OP_GET_GLOBAL       0 '@println'
0009    | OP_GET_GLOBAL       2 '@strConcat'
0011    | OP_CONSTANT         3 '{'
0013    | OP_GET_GLOBAL       4 '@numberToString'
0015    | OP_GET_GLOBAL       5 'n'
0017    | OP_CALL             1
0019    | OP_CONSTANT         6 '}'
0021    | OP_LIST             3
0023    | OP_CALL             1
0025    | OP_CALL             1
0027    | OP_POP
0028    6 OP_GET_GLOBAL       0 '@println'
0030    | OP_GET_GLOBAL       2 '@strConcat'
0032    | OP_CONSTANT         7 '{name} is '
0034    | OP_GET_GLOBAL       8 'name'
0036    | OP_LIST             2
0038    | OP_CALL             1
0040    | OP_CALL             1
0042    | OP_POP
0043    7 OP_GET_GLOBAL       0 '@println'
0045    | OP_CONSTANT         9 'a { b } c'
0047    | OP_CALL             1
0049    | OP_POP
0050    8 OP_GET_GLOBAL       0 '@println'
0052    | OP_CONSTANT        10 '{{'
0054    | OP_CALL             1
0056    | OP_POP
0057    9 OP_GET_GLOBAL       0 '@println'
0059    | OP_CONSTANT        11 '}}'
0061    | OP_CALL             1
0063    | OP_POP
0064   10 OP_GET_GLOBAL       0 '@println'
0066    | OP_CONSTANT         3 '{'
0068    | OP_CALL             1
0070    | OP_POP
0071   11 OP_GET_GLOBAL       0 '@println'
0073    | OP_CONSTANT         6 '}'
0075    | OP_CALL             1
0077    | OP_POP
0078    | OP_NIL
0079    | OP_RETURN
