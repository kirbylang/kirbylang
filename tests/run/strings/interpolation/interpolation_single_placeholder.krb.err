== <script> ==
0000    1 OP_CONSTANT         1 'World'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    2 OP_CONSTANT         3 '42'
0006    | OP_DEFINE_GLOBAL    2 'n'
0008    4 OP_GET_GLOBAL       4 '@println'
0010    | OP_GET_GLOBAL       0 'name'
0012    | OP_CALL             1
0014    | OP_POP
0015    5 OP_GET_GLOBAL       4 '@println'
0017    | OP_GET_GLOBAL       5 '@numberToString'
0019    | OP_GET_GLOBAL       2 'n'
0021    | OP_CALL             1
0023    | OP_CALL             1
0025    | OP_POP
0026    6 OP_NIL
0027    | OP_RETURN
