== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'World'
0006    | OP_DEFINE_GLOBAL    2 'name'
0008    2 OP_CONSTANT         5 '42'
0010    | OP_DEFINE_GLOBAL    4 'n'
0012    6 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'name'
0004    | OP_CALL             1
0006    | OP_POP
0007    5 OP_GET_GLOBAL       0 '@println'
0009    | OP_GET_GLOBAL       2 '@numberToString'
0011    | OP_GET_GLOBAL       3 'n'
0013    | OP_CALL             1
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
