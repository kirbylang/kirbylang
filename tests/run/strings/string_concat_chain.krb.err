== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         2 'a'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    2 OP_CONSTANT         3 'b'
0010    | OP_DEFINE_GLOBAL    3 'b'
0012    8 OP_NIL
0013    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_GET_GLOBAL       2 'b'
0006    | OP_ADD
0007    | OP_CALL             1
0009    | OP_POP
0010    5 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       3 '@strConcat'
0014    | OP_GET_GLOBAL       1 'a'
0016    | OP_GET_GLOBAL       2 'b'
0018    | OP_CONSTANT         4 'c'
0020    | OP_LIST             3
0022    | OP_CALL             1
0024    | OP_CALL             1
0026    | OP_POP
0027    6 OP_GET_GLOBAL       0 '@println'
0029    | OP_GET_GLOBAL       3 '@strConcat'
0031    | OP_CONSTANT         5 'x'
0033    | OP_GET_GLOBAL       1 'a'
0035    | OP_GET_GLOBAL       2 'b'
0037    | OP_CONSTANT         6 'y'
0039    | OP_LIST             4
0041    | OP_CALL             1
0043    | OP_CALL             1
0045    | OP_POP
0046    7 OP_GET_GLOBAL       0 '@println'
0048    | OP_CONSTANT         7 '1'
0050    | OP_CONSTANT         8 '2'
0052    | OP_ADD
0053    | OP_CONSTANT         9 '3'
0055    | OP_ADD
0056    | OP_CALL             1
0058    | OP_POP
0059    | OP_NIL
0060    | OP_RETURN
