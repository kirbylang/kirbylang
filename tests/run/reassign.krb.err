== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '123'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    4 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_CONSTANT         1 '456'
0002    | OP_SET_GLOBAL       0 'a'
0004    | OP_POP
0005    | OP_NIL
0006    | OP_RETURN
