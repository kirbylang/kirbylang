== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016   11 OP_GET_GLOBAL       2 'Box'
0018   12 OP_CLOSURE          5 <fn toString>
0020    | OP_METHOD           4 'toString'
0022   13 OP_POP
0023   14 OP_NIL
0024    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Box'
0004    | OP_CONSTANT         2 'value'
0006    | OP_CONSTANT         3 '1'
0008    | OP_STRUCT_INIT      1
0010    | OP_INVOKE        (0 args)    4 'toString'
0013    | OP_CALL             1
0015    | OP_POP
0016    | OP_NIL
0017    | OP_RETURN
== toString ==
0000   12 OP_CONSTANT         0 'a box'
0002    | OP_RETURN
