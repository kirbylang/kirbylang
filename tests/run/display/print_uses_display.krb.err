== <script> ==
0000   16 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    9 OP_STRUCT           4 'Plain'
0018    | OP_DEFINE_GLOBAL    4 'Plain'
0020    | OP_GET_GLOBAL       4 'Plain'
0022   10 OP_NIL
0023    | OP_FIELD            3 'value' public mutable
0027   11 OP_POP
0028    5 OP_GET_GLOBAL       2 'Box'
0030    6 OP_CLOSURE          6 <fn toString>
0032    | OP_TRAIT_METHOD     5 'toString'    7 'Display.toString'
0035    7 OP_POP
0036   13 OP_GET_GLOBAL       2 'Box'
0038    | OP_CONSTANT         3 'value'
0040    | OP_CONSTANT         9 '123'
0042    | OP_STRUCT_INIT      1
0044    | OP_DEFINE_GLOBAL    8 'box'
0046   17 OP_NIL
0047    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'box'
0004    | OP_INVOKE        (0 args)    2 'Display.toString'
0007    | OP_CALL             1
0009    | OP_POP
0010   16 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       3 'Plain'
0014    | OP_CONSTANT         4 'value'
0016    | OP_CONSTANT         5 '1'
0018    | OP_STRUCT_INIT      1
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
== toString ==
0000    6 OP_GET_GLOBAL       0 '@strConcat'
0002    | OP_CONSTANT         1 'Box('
0004    | OP_GET_GLOBAL       2 '@numberToString'
0006    | OP_GET_LOCAL        0
0008    | OP_GET_PROPERTY     3 'value'
