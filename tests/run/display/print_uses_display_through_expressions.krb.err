0035    | OP_CONSTANT         8 '2'
0037    | OP_STRUCT_INIT      1
0039    | OP_ARRAY            2
0041    | OP_DEFINE_GLOBAL    6 'boxes'
0043   15 OP_GET_GLOBAL       0 'show'
0045    | OP_GET_GLOBAL       2 'Box'
0047    | OP_CONSTANT         3 'value'
0049    | OP_CONSTANT         9 '3'
0051    | OP_STRUCT_INIT      1
0053    | OP_CALL             1
0055    | OP_POP
0056   16 OP_GET_GLOBAL      10 '@println'
0058    | OP_GET_GLOBAL       6 'boxes'
0060    | OP_CONSTANT         7 '1'
0062    | OP_GET_INDEX
0063    | OP_INVOKE        (0 args)    4 'toString'
0066    | OP_CALL             1
0068    | OP_POP
0069   17 OP_GET_GLOBAL      10 '@println'
0071    | OP_GET_GLOBAL       2 'Box'
0073    | OP_CONSTANT         3 'value'
0075    | OP_CONSTANT        11 '4'
0077    | OP_STRUCT_INIT      1
0079    | OP_GET_LOCAL        2
0081    | OP_CLOSE_BLOCK_EXPR    1
0083    | OP_INVOKE        (0 args)    4 'toString'
0086    | OP_CALL             1
0088    | OP_POP
0089   18 OP_NIL
0090    | OP_RETURN
== show ==
0000   10 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_LOCAL        1
0004    | OP_INVOKE        (0 args)    1 'toString'
0007    | OP_CALL             1
0009    | OP_POP
0010   11 OP_NIL
0011    | OP_RETURN
== toString ==
0000    6 OP_GET_GLOBAL       0 '@strConcat'
