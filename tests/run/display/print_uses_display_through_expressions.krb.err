== <script> ==
0000   11 OP_CLOSURE          1 <fn show>
0002    | OP_DEFINE_GLOBAL    0 'show'
0004   17 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Box'
0010    | OP_DEFINE_GLOBAL    4 'Box'
0012    | OP_GET_GLOBAL       4 'Box'
0014    2 OP_NIL
0015    | OP_FIELD            5 'value' public mutable
0019    3 OP_POP
0020    5 OP_GET_GLOBAL       4 'Box'
0022    6 OP_CLOSURE          7 <fn toString>
0024    | OP_TRAIT_METHOD     6 'toString'    8 'Display.toString'
0027    7 OP_POP
0028   13 OP_GET_GLOBAL       4 'Box'
0030    | OP_CONSTANT         5 'value'
0032    | OP_CONSTANT        10 '1'
0034    | OP_STRUCT_INIT      1
0036    | OP_GET_GLOBAL       4 'Box'
0038    | OP_CONSTANT         5 'value'
0040    | OP_CONSTANT        11 '2'
0042    | OP_STRUCT_INIT      1
0044    | OP_ARRAY            2
0046    | OP_DEFINE_GLOBAL    9 'boxes'
0048   18 OP_NIL
0049    | OP_RETURN
== show ==
0000   10 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_LOCAL        1
0004    | OP_INVOKE        (0 args)    1 'Display.toString'
0007    | OP_CALL             1
0009    | OP_POP
0010   11 OP_NIL
0011    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 'show'
0002    | OP_GET_GLOBAL       1 'Box'
0004    | OP_CONSTANT         2 'value'
0006    | OP_CONSTANT         3 '3'
0008    | OP_STRUCT_INIT      1
0010    | OP_CALL             1
0012    | OP_POP
0013   16 OP_GET_GLOBAL       4 '@println'
0015    | OP_GET_GLOBAL       5 'boxes'
0017    | OP_CONSTANT         6 '1'
0019    | OP_GET_INDEX
0020    | OP_INVOKE        (0 args)    7 'Display.toString'
0023    | OP_CALL             1
0025    | OP_POP
0026   17 OP_GET_GLOBAL       4 '@println'
0028    | OP_GET_GLOBAL       1 'Box'
0030    | OP_CONSTANT         2 'value'
0032    | OP_CONSTANT         8 '4'
0034    | OP_STRUCT_INIT      1
0036    | OP_GET_LOCAL        2
0038    | OP_CLOSE_BLOCK_EXPR    1
0040    | OP_INVOKE        (0 args)    7 'Display.toString'
0043    | OP_CALL             1
0045    | OP_POP
0046    | OP_NIL
0047    | OP_RETURN
== toString ==
0000    6 OP_GET_GLOBAL       0 '@strConcat'
0002    | OP_CONSTANT         1 'Box('
0004    | OP_GET_GLOBAL       2 '@numberToString'
0006    | OP_GET_LOCAL        0
0008    | OP_GET_PROPERTY     3 'value'
0010    | OP_CALL             1
0012    | OP_CONSTANT         4 ')'
0014    | OP_LIST             3
0016    | OP_CALL             1
0018    | OP_RETURN
