== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'nums'
0014    2 OP_CONSTANT         7 '1'
0016    | OP_DEFINE_GLOBAL    6 'i'
0018    7 OP_NIL
0019    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'nums'
0002    | OP_GET_GLOBAL       1 'i'
0004    | OP_CONSTANT         2 '20'
0006    | OP_SET_INDEX
0007    | OP_POP
0008    4 OP_GET_GLOBAL       0 'nums'
0010    | OP_CONSTANT         3 '2'
0012    | OP_CONSTANT         4 '30'
0014    | OP_SET_INDEX
0015    | OP_POP
0016    5 OP_GET_GLOBAL       0 'nums'
0018    | OP_CONSTANT         5 '0'
0020    | OP_CONSTANT         6 '10'
0022    | OP_SET_INDEX
0023    | OP_POP
0024    6 OP_GET_GLOBAL       7 '@println'
0026    | OP_GET_GLOBAL       0 'nums'
0028    | OP_CALL             1
0030    | OP_POP
0031    | OP_NIL
0032    | OP_RETURN
