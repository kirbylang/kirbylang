== <script> ==
0000    1 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    2 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_CONSTANT         0 '1'
0002    | OP_CONSTANT         1 '2'
0004    | OP_CONSTANT         2 '3'
0006    | OP_ARRAY            3
0008    | OP_POP
0009    | OP_NIL
0010    | OP_RETURN
