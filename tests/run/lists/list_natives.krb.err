== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_LIST             1
0008    | OP_DEFINE_GLOBAL    2 'xs'
0010    5 OP_NIL
0011    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@listPush'
0002    | OP_GET_GLOBAL       1 'xs'
0004    | OP_CONSTANT         2 '2'
0006    | OP_CALL             2
0008    | OP_POP
0009    3 OP_GET_GLOBAL       3 '@println'
0011    | OP_GET_GLOBAL       4 '@listLen'
0013    | OP_GET_GLOBAL       1 'xs'
0015    | OP_CALL             1
0017    | OP_CALL             1
0019    | OP_POP
0020    4 OP_GET_GLOBAL       3 '@println'
0022    | OP_GET_GLOBAL       5 '@listPop'
0024    | OP_GET_GLOBAL       1 'xs'
0026    | OP_CALL             1
0028    | OP_CALL             1
0030    | OP_POP
0031    | OP_NIL
0032    | OP_RETURN
