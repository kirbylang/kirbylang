== <script> ==
0000    1 OP_CONSTANT         1 '1'
0002    | OP_LIST             1
0004    | OP_DEFINE_GLOBAL    0 'xs'
0006    2 OP_GET_GLOBAL       2 '@listPush'
0008    | OP_GET_GLOBAL       0 'xs'
0010    | OP_CONSTANT         3 '2'
0012    | OP_CALL             2
0014    | OP_POP
0015    3 OP_GET_GLOBAL       4 '@println'
0017    | OP_GET_GLOBAL       5 '@listLen'
0019    | OP_GET_GLOBAL       0 'xs'
0021    | OP_CALL             1
0023    | OP_CALL             1
0025    | OP_POP
0026    4 OP_GET_GLOBAL       4 '@println'
0028    | OP_GET_GLOBAL       6 '@listPop'
0030    | OP_GET_GLOBAL       0 'xs'
0032    | OP_CALL             1
0034    | OP_CALL             1
0036    | OP_POP
0037    5 OP_NIL
0038    | OP_RETURN
