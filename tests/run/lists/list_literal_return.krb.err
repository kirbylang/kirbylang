== <script> ==
0000    3 OP_CLOSURE          1 <fn make>
0002    | OP_DEFINE_GLOBAL    0 'make'
0004    6 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    7 OP_NIL
0009    | OP_RETURN
== make ==
0000    2 OP_CONSTANT         0 '1'
0002    | OP_CONSTANT         1 '2'
0004    | OP_LIST             2
0006    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 'make'
0002    | OP_CALL             0
0004    5 OP_GET_GLOBAL       1 '@listPush'
0006    | OP_GET_LOCAL        1
0008    | OP_CONSTANT         2 '3'
0010    | OP_CALL             2
0012    | OP_POP
0013    6 OP_GET_GLOBAL       3 '@println'
0015    | OP_GET_LOCAL        1
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
