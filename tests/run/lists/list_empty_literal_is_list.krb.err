== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_LIST             0
0006    | OP_DEFINE_GLOBAL    2 'xs'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@listPush'
0002    | OP_GET_GLOBAL       1 'xs'
0004    | OP_CONSTANT         2 'a'
0006    | OP_CALL             2
0008    | OP_POP
0009    3 OP_GET_GLOBAL       3 '@println'
0011    | OP_GET_GLOBAL       1 'xs'
0013    | OP_CALL             1
0015    | OP_POP
0016    4 OP_GET_GLOBAL       3 '@println'
0018    | OP_GET_GLOBAL       4 '@typeof'
0020    | OP_GET_GLOBAL       1 'xs'
0022    | OP_CALL             1
0024    | OP_CALL             1
0026    | OP_POP
0027    | OP_NIL
0028    | OP_RETURN
