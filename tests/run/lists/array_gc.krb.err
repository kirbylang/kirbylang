== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_LIST             0
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_CONSTANT         0 '0'
0002    | OP_GET_LOCAL        1
0004    | OP_CONSTANT         1 '10000'
0006    | OP_LESS
0007    | OP_JUMP_IF_FALSE    7 -> 37
0010    | OP_POP
0011    | OP_JUMP            11 -> 25
0014    | OP_GET_LOCAL        1
0016    | OP_CONSTANT         2 '1'
0018    | OP_ADD
0019    | OP_SET_LOCAL        1
0021    | OP_POP
0022    | OP_LOOP            22 -> 2
0025    4 OP_GET_GLOBAL       3 '@listPush'
0027    | OP_GET_GLOBAL       4 'a'
0029    | OP_GET_LOCAL        1
0031    | OP_CALL             2
0033    | OP_POP
0034    5 OP_LOOP            34 -> 14
0037    | OP_POP
0038    | OP_POP
0039    | OP_NIL
0040    | OP_RETURN
