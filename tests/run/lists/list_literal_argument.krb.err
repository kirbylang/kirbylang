== <script> ==
0000    3 OP_CLOSURE          1 <fn grow>
0002    | OP_DEFINE_GLOBAL    0 'grow'
0004    4 OP_LIST             0
0006    | OP_DEFINE_GLOBAL    2 'ys'
0008    5 OP_GET_GLOBAL       0 'grow'
0010    | OP_GET_GLOBAL       2 'ys'
0012    | OP_CALL             1
0014    | OP_POP
0015    6 OP_GET_GLOBAL       3 '@println'
0017    | OP_GET_GLOBAL       2 'ys'
0019    | OP_CALL             1
0021    | OP_POP
0022    7 OP_NIL
0023    | OP_RETURN
== grow ==
0000    2 OP_GET_GLOBAL       0 '@listPush'
0002    | OP_GET_LOCAL        1
0004    | OP_CONSTANT         1 '0'
0006    | OP_CALL             2
0008    | OP_POP
0009    3 OP_NIL
0010    | OP_RETURN
