== <script> ==
0000    3 OP_CLOSURE          1 <fn grow>
0002    | OP_DEFINE_GLOBAL    0 'grow'
0004    6 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    4 OP_LIST             0
0010    | OP_DEFINE_GLOBAL    4 'ys'
0012    7 OP_NIL
0013    | OP_RETURN
== grow ==
0000    2 OP_GET_GLOBAL       0 '@listPush'
0002    | OP_GET_LOCAL        1
0004    | OP_CONSTANT         1 '0'
0006    | OP_CALL             2
0008    | OP_POP
0009    3 OP_NIL
0010    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 'grow'
0002    | OP_GET_GLOBAL       1 'ys'
0004    | OP_CALL             1
0006    | OP_POP
0007    6 OP_GET_GLOBAL       2 '@println'
0009    | OP_GET_GLOBAL       1 'ys'
0011    | OP_CALL             1
0013    | OP_POP
0014    | OP_NIL
0015    | OP_RETURN
