== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'a'
0006    | OP_CONSTANT         4 'b'
0008    | OP_CONSTANT         5 'c'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'names'
0014    2 OP_CONSTANT         7 '1'
0016    | OP_DEFINE_GLOBAL    6 'i'
0018    3 OP_CONSTANT         9 '2'
0020    | OP_DEFINE_GLOBAL    8 'u'
0022    4 OP_CONSTANT        11 '0'
0024    | OP_DEFINE_GLOBAL   10 'big'
0026    5 OP_CONSTANT        13 '1'
0028    | OP_DEFINE_GLOBAL   12 'neg'
0030   12 OP_NIL
0031    | OP_RETURN
== main ==
0000    6 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'names'
0004    | OP_GET_GLOBAL       2 'i'
0006    | OP_GET_INDEX
0007    | OP_CALL             1
0009    | OP_POP
0010    7 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       1 'names'
0014    | OP_GET_GLOBAL       3 'u'
0016    | OP_GET_INDEX
0017    | OP_CALL             1
0019    | OP_POP
0020    8 OP_GET_GLOBAL       0 '@println'
0022    | OP_GET_GLOBAL       1 'names'
0024    | OP_GET_GLOBAL       4 'big'
0026    | OP_GET_INDEX
0027    | OP_CALL             1
0029    | OP_POP
0030    9 OP_GET_GLOBAL       0 '@println'
0032    | OP_GET_GLOBAL       1 'names'
0034    | OP_GET_GLOBAL       5 'neg'
0036    | OP_GET_INDEX
0037    | OP_CALL             1
0039    | OP_POP
0040   10 OP_GET_GLOBAL       0 '@println'
0042    | OP_GET_GLOBAL       1 'names'
0044    | OP_CONSTANT         6 '2'
0046    | OP_GET_INDEX
0047    | OP_CALL             1
0049    | OP_POP
0050   11 OP_GET_GLOBAL       0 '@println'
0052    | OP_GET_GLOBAL       1 'names'
0054    | OP_CONSTANT         7 '0'
0056    | OP_GET_INDEX
