== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '7'
0006    | OP_DEFINE_GLOBAL    2 'x'
0008    3 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_CONSTANT         2 'v='
0006    | OP_GET_GLOBAL       3 '@numberToString'
0008    | OP_GET_GLOBAL       4 'x'
0010    | OP_CALL             1
0012    | OP_LIST             2
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    | OP_NIL
0020    | OP_RETURN
