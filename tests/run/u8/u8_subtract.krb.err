== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '10'
0004    | OP_CONSTANT         2 '3'
0006    | OP_SUBTRACT
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_CONSTANT         4 '1'
0012    | OP_DEFINE_GLOBAL    3 'a'
0014    3 OP_GET_GLOBAL       0 '@println'
0016    | OP_GET_GLOBAL       3 'a'
0018    | OP_CONSTANT         5 '2'
0020    | OP_SUBTRACT
0021    | OP_CALL             1
0023    | OP_POP
0024    4 OP_NIL
0025    | OP_RETURN
