== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '10'
0004    | OP_CONSTANT         2 '3'
0006    | OP_SUBTRACT
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_CONSTANT         3 '2'
0012    3 OP_GET_GLOBAL       0 '@println'
0014    | OP_GET_LOCAL        1
0016    | OP_CONSTANT         3 '2'
0018    | OP_SUBTRACT
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
