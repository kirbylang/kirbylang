== <script> ==
0000    3 OP_CLOSURE          1 <fn answer>
0002    | OP_DEFINE_GLOBAL    0 'answer'
0004    5 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    6 OP_NIL
0009    | OP_RETURN
== answer ==
0000    2 OP_CONSTANT         0 '42'
0002    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'answer'
0004    | OP_CALL             0
0006    | OP_CALL             1
0008    | OP_POP
0009    | OP_NIL
0010    | OP_RETURN
