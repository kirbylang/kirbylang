== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    9 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 'Date'
0002    | OP_CONSTANT         2 '1791273061'
0004    | OP_INVOKE        (1 args)    1 'new'
0007    3 OP_GET_GLOBAL       3 '@println'
0009    | OP_GET_LOCAL        1
0011    | OP_INVOKE        (0 args)    4 'get_year'
0014    | OP_CALL             1
0016    | OP_POP
0017    4 OP_GET_GLOBAL       3 '@println'
0019    | OP_GET_LOCAL        1
0021    | OP_INVOKE        (0 args)    5 'get_month'
0024    | OP_CALL             1
0026    | OP_POP
0027    5 OP_GET_GLOBAL       3 '@println'
0029    | OP_GET_LOCAL        1
0031    | OP_INVOKE        (0 args)    6 'get_day'
0034    | OP_CALL             1
0036    | OP_POP
0037    6 OP_GET_GLOBAL       3 '@println'
0039    | OP_GET_LOCAL        1
0041    | OP_INVOKE        (0 args)    7 'get_hour'
0044    | OP_CALL             1
0046    | OP_POP
0047    7 OP_GET_GLOBAL       3 '@println'
0049    | OP_GET_LOCAL        1
0051    | OP_INVOKE        (0 args)    8 'get_minute'
0054    | OP_CALL             1
0056    | OP_POP
0057    8 OP_GET_GLOBAL       3 '@println'
0059    | OP_GET_LOCAL        1
0061    | OP_INVOKE        (0 args)    9 'get_second'
0064    | OP_CALL             1
0066    | OP_POP
0067    | OP_NIL
0068    | OP_RETURN
