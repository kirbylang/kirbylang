== <script> ==
0000   15 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    6 OP_GET_GLOBAL       2 'Date'
0006    7 OP_CLOSURE          4 <fn get_year>
0008    | OP_TRAIT_METHOD     3 'get_year'    5 'Loud.get_year'
0011    8 OP_POP
0012   16 OP_NIL
0013    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 'Date'
0002    | OP_CONSTANT         2 '2020'
0004    | OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_CONSTANT         6 '4'
0012    | OP_CONSTANT         7 '5'
0014    | OP_INVOKE        (6 args)    1 'from_parts'
0017   13 OP_GET_GLOBAL       8 '@println'
0019    | OP_GET_LOCAL        1
0021    | OP_INVOKE        (0 args)    9 'get_year'
0024    | OP_CALL             1
0026    | OP_POP
0027   14 OP_GET_GLOBAL       8 '@println'
0029    | OP_GET_LOCAL        1
0031    | OP_INVOKE        (0 args)   10 'Loud.get_year'
0034    | OP_CALL             1
0036    | OP_POP
0037   15 OP_NIL
0038    | OP_RETURN
== get_year ==
0000    7 OP_CONSTANT         0 'LOUD'
0002    | OP_RETURN
