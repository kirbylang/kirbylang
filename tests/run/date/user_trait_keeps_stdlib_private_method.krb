// A trait method doesn't replace a method the standard library calls itself
trait Pad {
    fun pad_zeros(num: i64, length: i64): string;
}

impl Pad for Date {
    fun pad_zeros(num: i64, length: i64): string = "replaced";
}

fun main(): unit {
    @println(Date.from_parts(2020, 1, 2, 3, 4, 5)); // 2020-01-02 03:04:05
}
