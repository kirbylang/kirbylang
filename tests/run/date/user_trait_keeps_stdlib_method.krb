// The struct's own method wins over a trait method added after it
trait Loud {
    fun get_year(self): string;
}

impl Loud for Date {
    fun get_year(self): string = "LOUD";
}

fun main(): unit {
    let date = Date.from_parts(2020, 1, 2, 3, 4, 5);

    @println(date.get_year()); // 2020
    @println(Loud.get_year(date)); // LOUD
}
