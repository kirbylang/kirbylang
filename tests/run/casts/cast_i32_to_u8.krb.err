== <script> ==
0000    2 OP_CONSTANT         1 '255'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    3 OP_GET_GLOBAL       0 'a'
0006    | OP_CAST          u8
0008    | OP_DEFINE_GLOBAL    2 'byte'
0010    4 OP_GET_GLOBAL       3 '@println'
0012    | OP_GET_GLOBAL       2 'byte'
0014    | OP_CALL             1
0016    | OP_POP
0017    5 OP_NIL
0018    | OP_RETURN
