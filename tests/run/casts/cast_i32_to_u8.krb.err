== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    2 OP_CONSTANT         3 '255'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'a'
0002    | OP_CAST          u8
0004    4 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CALL             1
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
