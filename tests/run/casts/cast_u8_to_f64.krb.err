== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    2 OP_CONSTANT         3 '7'
0006    | OP_DEFINE_GLOBAL    2 'byte'
0008   10 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'byte'
0002    | OP_CAST          f64
0004    4 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CONSTANT         2 '0.5'
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_POP
0014    5 OP_GET_GLOBAL       1 '@println'
0016    | OP_GET_GLOBAL       0 'byte'
0018    | OP_CAST          f64
0020    | OP_CONSTANT         3 '2'
0022    | OP_DIVIDE
0023    | OP_CALL             1
0025    | OP_POP
0026    8 OP_GET_GLOBAL       1 '@println'
0028    | OP_CONSTANT         4 '7'
0030    | OP_CAST          u8
0032    | OP_CALL             1
0034    | OP_POP
0035    9 OP_GET_GLOBAL       1 '@println'
0037    | OP_CONSTANT         5 '1.5'
0039    | OP_CAST          f64
0041    | OP_CALL             1
0043    | OP_POP
0044    | OP_NIL
0045    | OP_RETURN
