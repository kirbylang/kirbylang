== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    2 OP_CONSTANT         3 '255'
0006    | OP_DEFINE_GLOBAL    2 'byte'
0008    5 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'byte'
0002    | OP_CAST          i32
0004    4 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CONSTANT         2 '1'
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_POP
0014    | OP_NIL
0015    | OP_RETURN
