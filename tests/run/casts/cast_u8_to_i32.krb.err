== <script> ==
0000    2 OP_CONSTANT         1 '255'
0002    | OP_DEFINE_GLOBAL    0 'byte'
0004    3 OP_GET_GLOBAL       0 'byte'
0006    | OP_CAST          i32
0008    | OP_DEFINE_GLOBAL    2 'a'
0010    4 OP_GET_GLOBAL       3 '@println'
0012    | OP_GET_GLOBAL       2 'a'
0014    | OP_CONSTANT         4 '1'
0016    | OP_ADD
0017    | OP_CALL             1
0019    | OP_POP
0020    5 OP_NIL
0021    | OP_RETURN
