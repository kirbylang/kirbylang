== <script> ==
0000   14 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    2 OP_CONSTANT         3 '255'
0006    | OP_DEFINE_GLOBAL    2 'v'
0008   15 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'v'
0002    | OP_CAST          u8
0004    4 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CALL             1
0010    | OP_POP
0011    6 OP_CONSTANT         2 '3.14159'
0013    7 OP_GET_GLOBAL       1 '@println'
0015    | OP_GET_GLOBAL       3 '@floor'
0017    | OP_GET_LOCAL        2
0019    | OP_CALL             1
0021    | OP_CAST          u8
0023    | OP_CALL             1
0025    | OP_POP
0026   11 OP_GET_GLOBAL       1 '@println'
0028    | OP_CONSTANT         4 '2'
0030    | OP_CONSTANT         5 '3'
0032    | OP_MULTIPLY
0033    | OP_CAST          u8
0035    | OP_CALL             1
0037    | OP_POP
0038   14 OP_GET_GLOBAL       1 '@println'
0040    | OP_CONSTANT         6 '7'
0042    | OP_CAST          u8
0044    | OP_CALL             1
0046    | OP_POP
0047    | OP_NIL
0048    | OP_RETURN
