== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    2 OP_CONSTANT         3 '7'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    8 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'a'
0002    | OP_CAST          f64
0004    4 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CONSTANT         2 '0.5'
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_POP
0014    7 OP_GET_GLOBAL       1 '@println'
0016    | OP_CONSTANT         3 '7'
0018    | OP_CAST          i32
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
