== <script> ==
0000    2 OP_CONSTANT         1 '7'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    3 OP_GET_GLOBAL       0 'a'
0006    | OP_CAST          f64
0008    | OP_DEFINE_GLOBAL    2 'value'
0010    4 OP_GET_GLOBAL       3 '@println'
0012    | OP_GET_GLOBAL       2 'value'
0014    | OP_CONSTANT         4 '0.5'
0016    | OP_ADD
0017    | OP_CALL             1
0019    | OP_POP
0020    7 OP_GET_GLOBAL       3 '@println'
0022    | OP_CONSTANT         1 '7'
0024    | OP_CAST          i32
0026    | OP_CALL             1
0028    | OP_POP
0029    8 OP_NIL
0030    | OP_RETURN
