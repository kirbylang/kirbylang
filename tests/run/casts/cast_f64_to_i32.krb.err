0006    | OP_DEFINE_GLOBAL    2 'v'
0008   12 OP_NIL
0009    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 'v'
0002    | OP_CAST          i32
0004    5 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CALL             1
0010    | OP_POP
0011    7 OP_CONSTANT         2 '2147483647'
0013    8 OP_GET_GLOBAL       1 '@println'
0015    | OP_GET_LOCAL        2
0017    | OP_CAST          i32
0019    | OP_CALL             1
0021    | OP_POP
0022   10 OP_CONSTANT         3 '2147483648'
0024    | OP_NEGATE
0025   11 OP_GET_GLOBAL       1 '@println'
0027    | OP_GET_LOCAL        3
0029    | OP_CAST          i32
