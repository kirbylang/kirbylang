== <script> ==
0000   10 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Node'
0006    | OP_DEFINE_GLOBAL    2 'Node'
0008    | OP_GET_GLOBAL       2 'Node'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'children' public mutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Node'
0023    | OP_CONSTANT         3 'value'
0025    | OP_CONSTANT         6 '2'
0027    | OP_CONSTANT         4 'children'
0029    | OP_LIST             0
0031    | OP_STRUCT_INIT      2
0033    | OP_DEFINE_GLOBAL    5 'leaf'
0035    7 OP_GET_GLOBAL       2 'Node'
0037    | OP_CONSTANT         3 'value'
0039    | OP_CONSTANT         8 '1'
0041    | OP_CONSTANT         4 'children'
0043    | OP_GET_GLOBAL       5 'leaf'
0045    | OP_LIST             1
0047    | OP_STRUCT_INIT      2
0049    | OP_DEFINE_GLOBAL    7 'root'
0051   11 OP_NIL
0052    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'root'
0004    | OP_GET_PROPERTY     2 'value'
0006    | OP_CALL             1
0008    | OP_POP
0009   10 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       1 'root'
0013    | OP_GET_PROPERTY     3 'children'
0015    | OP_CONSTANT         4 '0'
0017    | OP_GET_INDEX
0018    | OP_GET_PROPERTY     2 'value'
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
