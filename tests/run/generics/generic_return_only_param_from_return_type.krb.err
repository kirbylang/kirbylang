== <script> ==
0000    1 OP_CLOSURE          1 <fn empty>
0002    | OP_DEFINE_GLOBAL    0 'empty'
0004    5 OP_CLOSURE          3 <fn names>
0006    | OP_DEFINE_GLOBAL    2 'names'
0008    7 OP_CLOSURE          5 <fn numbers>
0010    | OP_DEFINE_GLOBAL    4 'numbers'
0012    9 OP_CLOSURE          7 <fn main>
0014    | OP_DEFINE_GLOBAL    6 'main'
0016   10 OP_NIL
0017    | OP_RETURN
== empty ==
0000    1 OP_LIST             0
0002    | OP_RETURN
== names ==
0000    4 OP_GET_GLOBAL       0 'empty'
0002    | OP_CALL             0
0004    | OP_RETURN
== numbers ==
0000    7 OP_GET_GLOBAL       0 'empty'
0002    | OP_CALL             0
0004    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@listLen'
0004    | OP_GET_GLOBAL       2 'names'
0006    | OP_CALL             0
0008    | OP_CALL             1
0010    | OP_GET_GLOBAL       1 '@listLen'
0012    | OP_GET_GLOBAL       3 'numbers'
0014    | OP_CALL             0
0016    | OP_CALL             1
0018    | OP_ADD
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
