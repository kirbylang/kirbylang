== <script> ==
0000    1 OP_CLOSURE          1 <fn empty>
0002    | OP_DEFINE_GLOBAL    0 'empty'
0004    5 OP_CLOSURE          3 <fn names>
0006    | OP_DEFINE_GLOBAL    2 'names'
0008    7 OP_CLOSURE          5 <fn numbers>
0010    | OP_DEFINE_GLOBAL    4 'numbers'
0012    9 OP_GET_GLOBAL       6 '@println'
0014    | OP_GET_GLOBAL       7 '@listLen'
0016    | OP_GET_GLOBAL       2 'names'
0018    | OP_CALL             0
0020    | OP_CALL             1
0022    | OP_GET_GLOBAL       7 '@listLen'
0024    | OP_GET_GLOBAL       4 'numbers'
0026    | OP_CALL             0
0028    | OP_CALL             1
0030    | OP_ADD
0031    | OP_CALL             1
0033    | OP_POP
0034   10 OP_NIL
0035    | OP_RETURN
== empty ==
0000    1 OP_LIST             0
0002    | OP_RETURN
== names ==
0000    4 OP_GET_GLOBAL       0 'empty'
0002    | OP_CALL             0
0004    | OP_RETURN
== numbers ==
0000    7 OP_GET_GLOBAL       0 'empty'
0002    | OP_CALL             0
0004    | OP_RETURN
