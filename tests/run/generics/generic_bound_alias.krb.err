== <script> ==
0000   11 OP_CLOSURE          1 <fn first>
0002    | OP_DEFINE_GLOBAL    0 'first'
0004   16 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Money'
0010    | OP_DEFINE_GLOBAL    4 'Money'
0012    | OP_GET_GLOBAL       4 'Money'
0014    2 OP_NIL
0015    | OP_FIELD            5 'cents' public mutable
0019    3 OP_POP
0020    5 OP_GET_GLOBAL       4 'Money'
0022    6 OP_CLOSURE          7 <fn toString>
0024    | OP_METHOD           6 'toString'
0026    7 OP_POP
0027   17 OP_NIL
0028    | OP_RETURN
== first ==
0000   11 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '0'
0004    | OP_GET_INDEX
0005    | OP_INVOKE        (0 args)    1 'toString'
0008    | OP_RETURN
== main ==
0000   14 OP_GET_GLOBAL       0 'Money'
0002    | OP_CONSTANT         1 'cents'
0004    | OP_CONSTANT         2 '3'
0006    | OP_STRUCT_INIT      1
0008    | OP_LIST             1
0010   15 OP_GET_GLOBAL       3 '@println'
0012    | OP_GET_GLOBAL       4 'first'
0014    | OP_GET_LOCAL        1
0016    | OP_CALL             1
0018    | OP_CALL             1
0020    | OP_POP
0021   16 OP_NIL
0022    | OP_RETURN
== toString ==
0000    6 OP_GET_GLOBAL       0 '@strConcat'
0002    | OP_CONSTANT         1 '$'
0004    | OP_GET_GLOBAL       2 '@numberToString'
0006    | OP_GET_LOCAL        0
0008    | OP_GET_PROPERTY     3 'cents'
0010    | OP_CALL             1
0012    | OP_LIST             2
0014    | OP_CALL             1
0016    | OP_RETURN
