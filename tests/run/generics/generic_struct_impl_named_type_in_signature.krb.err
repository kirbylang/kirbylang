== <script> ==
0000    1 OP_STRUCT           0 'Box'
0002    | OP_DEFINE_GLOBAL    0 'Box'
0004    | OP_GET_GLOBAL       0 'Box'
0006    2 OP_NIL
0007    | OP_FIELD            1 'value' public mutable
0011    3 OP_POP
0012    5 OP_GET_GLOBAL       0 'Box'
0014    6 OP_CLOSURE          3 <fn new>
0016    | OP_METHOD           2 'new'
0018    7 OP_CLOSURE          5 <fn get>
0020    | OP_METHOD           4 'get'
0022    8 OP_POP
0023   10 OP_GET_GLOBAL       0 'Box'
0025    | OP_CONSTANT         7 '5'
0027    | OP_INVOKE        (1 args)    2 'new'
0030    | OP_DEFINE_GLOBAL    6 'b'
0032   11 OP_GET_GLOBAL       8 '@println'
0034    | OP_GET_GLOBAL       6 'b'
0036    | OP_INVOKE        (0 args)    4 'get'
0039    | OP_CALL             1
0041    | OP_POP
0042   12 OP_NIL
0043    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== get ==
0000    7 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
