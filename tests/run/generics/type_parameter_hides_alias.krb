struct Box[T] {
    pub value: T;
}

type Number = i64;
type Many[T] = [T];

fun id[Number](x: Number): Number = x;

fun same[Many](x: Many): Many = x;

type Wrapped[Number] = Box[Number];

fun main(): unit {
    @println(id("not a number"));
    @println(same(true));

    let w: Wrapped[string] = Box { value: "wrapped" };
    @println(w.value);
}
