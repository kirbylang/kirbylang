== <script> ==
0000   12 OP_CLOSURE          1 <fn announce>
0002    | OP_DEFINE_GLOBAL    0 'announce'
0004   16 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Dog'
0010    | OP_DEFINE_GLOBAL    4 'Dog'
0012    | OP_GET_GLOBAL       4 'Dog'
0014    2 OP_NIL
0015    | OP_FIELD            5 'name' public mutable
0019    3 OP_POP
0020    5 OP_GET_GLOBAL       4 'Dog'
0022    6 OP_CLOSURE          7 <fn toString>
0024    | OP_TRAIT_METHOD     6 'toString'    8 'Display.toString'
0027    7 OP_POP
0028   17 OP_NIL
0029    | OP_RETURN
== announce ==
0000   10 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_LOCAL        1
0004    | OP_INVOKE        (0 args)    1 'Display.toString'
0007    | OP_CALL             1
0009    | OP_POP
0010   11 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       2 '@strConcat'
0014    | OP_CONSTANT         3 'hello '
0016    | OP_GET_LOCAL        1
0018    | OP_INVOKE        (0 args)    1 'Display.toString'
0021    | OP_LIST             2
0023    | OP_CALL             1
0025    | OP_CALL             1
0027    | OP_POP
0028   12 OP_NIL
0029    | OP_RETURN
== main ==
0000   15 OP_GET_GLOBAL       0 'announce'
0002    | OP_GET_GLOBAL       1 'Dog'
0004    | OP_CONSTANT         2 'name'
0006    | OP_CONSTANT         3 'Rex'
0008    | OP_STRUCT_INIT      1
0010    | OP_CALL             1
0012    | OP_POP
0013   16 OP_NIL
0014    | OP_RETURN
== toString ==
0000    6 OP_GET_GLOBAL       0 '@strConcat'
0002    | OP_CONSTANT         1 'Dog '
0004    | OP_GET_LOCAL        0
0006    | OP_GET_PROPERTY     2 'name'
0008    | OP_LIST             2
0010    | OP_CALL             1
0012    | OP_RETURN
