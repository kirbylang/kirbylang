== <script> ==
0000    1 OP_STRUCT           0 'Box'
0002    | OP_DEFINE_GLOBAL    0 'Box'
0004    | OP_GET_GLOBAL       0 'Box'
0006    2 OP_NIL
0007    | OP_FIELD            1 'value' public mutable
0011    3 OP_POP
0012    9 OP_GET_GLOBAL       0 'Box'
0014    | OP_CONSTANT         1 'value'
0016    | OP_CONSTANT         3 '1'
0018    | OP_STRUCT_INIT      1
0020    | OP_DEFINE_GLOBAL    2 'n'
0022   10 OP_GET_GLOBAL       4 '@println'
0024    | OP_GET_GLOBAL       2 'n'
0026    | OP_GET_PROPERTY     1 'value'
0028    | OP_CONSTANT         3 '1'
0030    | OP_ADD
0031    | OP_CALL             1
0033    | OP_POP
0034   11 OP_NIL
0035    | OP_RETURN
