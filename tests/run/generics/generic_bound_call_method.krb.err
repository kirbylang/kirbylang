== <script> ==
0000    9 OP_CLOSURE          1 <fn show>
0002    | OP_DEFINE_GLOBAL    0 'show'
0004   13 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Dog'
0010    | OP_DEFINE_GLOBAL    4 'Dog'
0012    | OP_GET_GLOBAL       4 'Dog'
0014    2 OP_NIL
0015    | OP_FIELD            5 'name' public mutable
0019    3 OP_POP
0020    5 OP_GET_GLOBAL       4 'Dog'
0022    6 OP_CLOSURE          7 <fn toString>
0024    | OP_METHOD           6 'toString'
0026    7 OP_POP
0027   14 OP_NIL
0028    | OP_RETURN
== show ==
0000    9 OP_GET_LOCAL        1
0002    | OP_INVOKE        (0 args)    0 'toString'
0005    | OP_RETURN
== main ==
0000   12 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'show'
0004    | OP_GET_GLOBAL       2 'Dog'
0006    | OP_CONSTANT         3 'name'
0008    | OP_CONSTANT         4 'Rex'
0010    | OP_STRUCT_INIT      1
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017   13 OP_NIL
0018    | OP_RETURN
== toString ==
0000    6 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'name'
0004    | OP_RETURN
