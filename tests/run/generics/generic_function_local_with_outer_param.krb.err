== <script> ==
0000    9 OP_CLOSURE          1 <fn outer>
0002    | OP_DEFINE_GLOBAL    0 'outer'
0004   11 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'outer'
0008    | OP_TRUE
0009    | OP_CALL             1
0011    | OP_CALL             1
0013    | OP_POP
0014   12 OP_NIL
0015    | OP_RETURN
== outer ==
0000    4 OP_CLOSURE          0 <fn inner>
0002    6 OP_GET_GLOBAL       1 '@println'
0004    | OP_GET_LOCAL        2
0006    | OP_CONSTANT         2 '1'
0008    | OP_GET_LOCAL        1
0010    | OP_CALL             2
0012    | OP_CALL             1
0014    | OP_POP
0015    7 OP_GET_GLOBAL       1 '@println'
0017    | OP_GET_LOCAL        2
0019    | OP_CONSTANT         3 'one'
0021    | OP_GET_LOCAL        1
0023    | OP_CALL             2
0025    | OP_CALL             1
0027    | OP_POP
0028    8 OP_GET_LOCAL        1
0030    | OP_RETURN
== inner ==
0000    3 OP_GET_LOCAL        1
0002    | OP_RETURN
