== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    6 OP_CLOSURE          5 <fn count>
0020    | OP_METHOD           4 'count'
0022    7 OP_POP
0023   10 OP_NIL
0024    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'Box'
0004    | OP_INVOKE        (0 args)    2 'count'
0007    | OP_CALL             1
0009    | OP_POP
0010    | OP_NIL
0011    | OP_RETURN
== count ==
0000    6 OP_CONSTANT         0 '0'
0002    | OP_RETURN
