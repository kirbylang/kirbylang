== <script> ==
0000    1 OP_STRUCT           0 'Box'
0002    | OP_DEFINE_GLOBAL    0 'Box'
0004    | OP_GET_GLOBAL       0 'Box'
0006    2 OP_NIL
0007    | OP_FIELD            1 'value' public mutable
0011    3 OP_POP
0012    5 OP_GET_GLOBAL       0 'Box'
0014    6 OP_CLOSURE          3 <fn count>
0016    | OP_METHOD           2 'count'
0018    7 OP_POP
0019    9 OP_GET_GLOBAL       4 '@println'
0021    | OP_GET_GLOBAL       0 'Box'
0023    | OP_INVOKE        (0 args)    2 'count'
0026    | OP_CALL             1
0028    | OP_POP
0029   10 OP_NIL
0030    | OP_RETURN
== count ==
0000    6 OP_CONSTANT         0 '0'
0002    | OP_RETURN
