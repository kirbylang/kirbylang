== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    | OP_CONSTANT         3 'value'
0020    | OP_CONSTANT         5 '1'
0022    | OP_STRUCT_INIT      1
0024    | OP_DEFINE_GLOBAL    4 'a'
0026    6 OP_GET_GLOBAL       2 'Box'
0028    | OP_CONSTANT         3 'value'
0030    | OP_CONSTANT         7 'hi'
0032    | OP_STRUCT_INIT      1
0034    | OP_DEFINE_GLOBAL    6 'b'
0036   10 OP_NIL
0037    | OP_RETURN
== main ==
0000    8 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_GET_PROPERTY     2 'value'
0006    | OP_CALL             1
0008    | OP_POP
0009    9 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       3 'b'
0013    | OP_GET_PROPERTY     2 'value'
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
