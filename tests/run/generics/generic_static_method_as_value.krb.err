== <script> ==
0000   11 OP_CLOSURE          1 <fn make>
0002    | OP_DEFINE_GLOBAL    0 'make'
0004   13 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Box'
0010    | OP_DEFINE_GLOBAL    4 'Box'
0012    | OP_GET_GLOBAL       4 'Box'
0014    2 OP_NIL
0015    | OP_FIELD            5 'value' public mutable
0019    3 OP_POP
0020    5 OP_GET_GLOBAL       4 'Box'
0022    6 OP_CLOSURE          7 <fn new>
0024    | OP_METHOD           6 'new'
0026    7 OP_POP
0027   14 OP_NIL
0028    | OP_RETURN
== make ==
0000   10 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 'hi'
0004    | OP_CALL             1
0006    | OP_RETURN
== main ==
0000   13 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'make'
0004    | OP_GET_GLOBAL       2 'Box'
0006    | OP_GET_PROPERTY     3 'new'
0008    | OP_CALL             1
0010    | OP_GET_PROPERTY     4 'value'
0012    | OP_CALL             1
0014    | OP_POP
0015    | OP_NIL
0016    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
