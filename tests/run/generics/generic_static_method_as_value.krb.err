== <script> ==
0000   11 OP_CLOSURE          1 <fn make>
0002    | OP_DEFINE_GLOBAL    0 'make'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    6 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022    7 OP_POP
0023   13 OP_GET_GLOBAL       6 '@println'
0025    | OP_GET_GLOBAL       0 'make'
0027    | OP_GET_GLOBAL       2 'Box'
0029    | OP_GET_PROPERTY     4 'new'
0031    | OP_CALL             1
0033    | OP_GET_PROPERTY     3 'value'
0035    | OP_CALL             1
0037    | OP_POP
0038   14 OP_NIL
0039    | OP_RETURN
== make ==
0000   10 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 'hi'
0004    | OP_CALL             1
0006    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
