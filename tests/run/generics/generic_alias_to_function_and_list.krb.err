== <script> ==
0000    4 OP_CLOSURE          1 <fn twice>
0002    | OP_DEFINE_GLOBAL    0 'twice'
0004    6 OP_CLOSURE          3 <fn first>
0006    | OP_DEFINE_GLOBAL    2 'first'
0008    8 OP_CONSTANT         5 '3'
0010    | OP_CONSTANT         6 '4'
0012    | OP_LIST             2
0014    | OP_DEFINE_GLOBAL    4 'items'
0016   10 OP_GET_GLOBAL       7 '@println'
0018    | OP_GET_GLOBAL       0 'twice'
0020    | OP_CLOSURE          8 <fn lambda0x1>
0022    | OP_GET_GLOBAL       2 'first'
0024    | OP_GET_GLOBAL       4 'items'
0026    | OP_CALL             1
0028    | OP_CALL             2
0030    | OP_CALL             1
0032    | OP_POP
0033   11 OP_NIL
0034    | OP_RETURN
== twice ==
0000    4 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        1
0004    | OP_GET_LOCAL        2
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_RETURN
== first ==
0000    6 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '0'
0004    | OP_GET_INDEX
0005    | OP_RETURN
== lambda0x1 ==
0000   10 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '2'
0004    | OP_MULTIPLY
0005    | OP_RETURN
