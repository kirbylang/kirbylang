== <script> ==
0000    4 OP_CLOSURE          1 <fn twice>
0002    | OP_DEFINE_GLOBAL    0 'twice'
0004    6 OP_CLOSURE          3 <fn first>
0006    | OP_DEFINE_GLOBAL    2 'first'
0008   10 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012    8 OP_CONSTANT         7 '3'
0014    | OP_CONSTANT         8 '4'
0016    | OP_LIST             2
0018    | OP_DEFINE_GLOBAL    6 'items'
0020   11 OP_NIL
0021    | OP_RETURN
== twice ==
0000    4 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        1
0004    | OP_GET_LOCAL        2
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_RETURN
== first ==
0000    6 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '0'
0004    | OP_GET_INDEX
0005    | OP_RETURN
== main ==
0000   10 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'twice'
0004    | OP_CLOSURE          2 <fn lambda0x1>
0006    | OP_GET_GLOBAL       3 'first'
0008    | OP_GET_GLOBAL       4 'items'
0010    | OP_CALL             1
0012    | OP_CALL             2
0014    | OP_CALL             1
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
== lambda0x1 ==
0000   10 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '2'
0004    | OP_MULTIPLY
0005    | OP_RETURN
