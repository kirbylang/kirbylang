== <script> ==
0000   12 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Pair'
0006    | OP_DEFINE_GLOBAL    2 'Pair'
0008    | OP_GET_GLOBAL       2 'Pair'
0010    2 OP_NIL
0011    | OP_FIELD            3 'first' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'second' public mutable
0020    4 OP_POP
0021    6 OP_GET_GLOBAL       2 'Pair'
0023    | OP_CONSTANT         3 'first'
0025    | OP_CONSTANT         6 '1'
0027    | OP_CONSTANT         4 'second'
0029    | OP_CONSTANT         7 'two'
0031    | OP_STRUCT_INIT      2
0033    | OP_DEFINE_GLOBAL    5 'p'
0035    7 OP_GET_GLOBAL       2 'Pair'
0037    | OP_CONSTANT         3 'first'
0039    | OP_TRUE
0040    | OP_CONSTANT         4 'second'
0042    | OP_CONSTANT         9 '2.5'
0044    | OP_STRUCT_INIT      2
0046    | OP_DEFINE_GLOBAL    8 'q'
0048   13 OP_NIL
0049    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'p'
0004    | OP_GET_PROPERTY     2 'first'
0006    | OP_CALL             1
0008    | OP_POP
0009   10 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       1 'p'
0013    | OP_GET_PROPERTY     3 'second'
0015    | OP_CALL             1
0017    | OP_POP
0018   11 OP_GET_GLOBAL       0 '@println'
0020    | OP_GET_GLOBAL       4 'q'
0022    | OP_GET_PROPERTY     2 'first'
0024    | OP_CALL             1
0026    | OP_POP
0027   12 OP_GET_GLOBAL       0 '@println'
0029    | OP_GET_GLOBAL       4 'q'
0031    | OP_GET_PROPERTY     3 'second'
0033    | OP_CALL             1
0035    | OP_POP
0036    | OP_NIL
0037    | OP_RETURN
