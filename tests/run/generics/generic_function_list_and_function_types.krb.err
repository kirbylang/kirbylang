0014    | OP_GET_LOCAL        1
0016    | OP_CALL             1
0018    | OP_POP
0019   11 OP_GET_GLOBAL       4 '@println'
0021    | OP_GET_GLOBAL       5 'apply'
0023    | OP_GET_LOCAL        1
0025    | OP_CLOSURE          6 <fn lambda0x1>
0027    | OP_CALL             2
0029    | OP_CALL             1
0031    | OP_POP
0032   12 OP_GET_GLOBAL       4 '@println'
0034    | OP_GET_GLOBAL       5 'apply'
0036    | OP_CONSTANT         7 'abc'
0038    | OP_CLOSURE          8 <fn lambda0x2>
0040    | OP_CALL             2
0042    | OP_CALL             1
