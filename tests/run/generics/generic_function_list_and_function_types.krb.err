0006    | OP_DEFINE_GLOBAL    2 'apply'
0008   12 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012   13 OP_NIL
0013    | OP_RETURN
== first ==
0000    2 OP_GET_LOCAL        1
