== <script> ==
0000    5 OP_CLOSURE          1 <fn twice>
0002    | OP_DEFINE_GLOBAL    0 'twice'
0004    8 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    9 OP_NIL
0009    | OP_RETURN
== twice ==
0000    2 OP_CLOSURE          0 <fn lambda0x1>
0002    3 OP_GET_LOCAL        1
0004    4 OP_GET_LOCAL        2
0006    | OP_GET_LOCAL        3
0008    | OP_CALL             1
0010    | OP_RETURN
== lambda0x1 ==
0000    2 OP_GET_LOCAL        1
0002    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'twice'
0004    | OP_CONSTANT         2 '4'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    8 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 'twice'
0015    | OP_CONSTANT         3 'four'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
