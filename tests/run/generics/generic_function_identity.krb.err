== <script> ==
0000    3 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004    8 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    9 OP_NIL
0009    | OP_RETURN
== id ==
0000    2 OP_GET_LOCAL        1
0002    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'id'
0004    | OP_CONSTANT         2 '5'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    6 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 'id'
0015    | OP_CONSTANT         3 'hi'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    7 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 'id'
0026    | OP_TRUE
0027    | OP_CALL             1
0029    | OP_CALL             1
0031    | OP_POP
0032    8 OP_GET_GLOBAL       0 '@println'
0034    | OP_GET_GLOBAL       1 'id'
0036    | OP_CONSTANT         4 '2.5'
0038    | OP_CALL             1
0040    | OP_CALL             1
0042    | OP_POP
0043    | OP_NIL
0044    | OP_RETURN
