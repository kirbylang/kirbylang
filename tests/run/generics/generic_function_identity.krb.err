== <script> ==
0000    3 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004    5 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'id'
0008    | OP_CONSTANT         3 '5'
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_POP
0015    6 OP_GET_GLOBAL       2 '@println'
0017    | OP_GET_GLOBAL       0 'id'
0019    | OP_CONSTANT         4 'hi'
0021    | OP_CALL             1
0023    | OP_CALL             1
0025    | OP_POP
0026    7 OP_GET_GLOBAL       2 '@println'
0028    | OP_GET_GLOBAL       0 'id'
0030    | OP_TRUE
0031    | OP_CALL             1
0033    | OP_CALL             1
0035    | OP_POP
0036    8 OP_GET_GLOBAL       2 '@println'
0038    | OP_GET_GLOBAL       0 'id'
0040    | OP_CONSTANT         5 '2.5'
0042    | OP_CALL             1
0044    | OP_CALL             1
0046    | OP_POP
0047    9 OP_NIL
0048    | OP_RETURN
== id ==
0000    2 OP_GET_LOCAL        1
0002    | OP_RETURN
