== <script> ==
0000    7 OP_CLOSURE          1 <fn wrap>
0002    | OP_DEFINE_GLOBAL    0 'wrap'
0004    9 OP_CLOSURE          3 <fn unwrap>
0006    | OP_DEFINE_GLOBAL    2 'unwrap'
0008   11 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012    1 OP_STRUCT           6 'Box'
0014    | OP_DEFINE_GLOBAL    6 'Box'
0016    | OP_GET_GLOBAL       6 'Box'
0018    2 OP_NIL
0019    | OP_FIELD            7 'value' public mutable
0023    3 OP_POP
0024   12 OP_NIL
0025    | OP_RETURN
== wrap ==
0000    7 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== unwrap ==
0000    9 OP_GET_LOCAL        1
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'unwrap'
0004    | OP_GET_GLOBAL       2 'wrap'
0006    | OP_CONSTANT         3 '41'
0008    | OP_CALL             1
0010    | OP_CALL             1
0012    | OP_CONSTANT         4 '1'
0014    | OP_ADD
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
