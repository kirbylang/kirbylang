== <script> ==
0000    7 OP_CLOSURE          1 <fn wrap>
0002    | OP_DEFINE_GLOBAL    0 'wrap'
0004    9 OP_CLOSURE          3 <fn unwrap>
0006    | OP_DEFINE_GLOBAL    2 'unwrap'
0008    1 OP_STRUCT           4 'Box'
0010    | OP_DEFINE_GLOBAL    4 'Box'
0012    | OP_GET_GLOBAL       4 'Box'
0014    2 OP_NIL
0015    | OP_FIELD            5 'value' public mutable
0019    3 OP_POP
0020   11 OP_GET_GLOBAL       6 '@println'
0022    | OP_GET_GLOBAL       2 'unwrap'
0024    | OP_GET_GLOBAL       0 'wrap'
0026    | OP_CONSTANT         7 '41'
0028    | OP_CALL             1
0030    | OP_CALL             1
0032    | OP_CONSTANT         8 '1'
0034    | OP_ADD
0035    | OP_CALL             1
0037    | OP_POP
0038   12 OP_NIL
0039    | OP_RETURN
== wrap ==
0000    7 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== unwrap ==
0000    9 OP_GET_LOCAL        1
0002    | OP_GET_PROPERTY     0 'value'
0004    | OP_RETURN
