== <script> ==
0000    6 OP_CLOSURE          1 <fn last>
0002    | OP_DEFINE_GLOBAL    0 'last'
0004    8 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'last'
0008    | OP_CONSTANT         3 '1'
0010    | OP_CONSTANT         4 '2'
0012    | OP_CONSTANT         5 '3'
0014    | OP_LIST             3
0016    | OP_CONSTANT         4 '2'
0018    | OP_CALL             2
0020    | OP_CALL             1
0022    | OP_POP
0023    9 OP_GET_GLOBAL       2 '@println'
0025    | OP_GET_GLOBAL       0 'last'
0027    | OP_CONSTANT         6 'a'
0029    | OP_CONSTANT         7 'b'
0031    | OP_LIST             2
0033    | OP_CONSTANT         3 '1'
0035    | OP_CALL             2
0037    | OP_CALL             1
0039    | OP_POP
0040   10 OP_NIL
0041    | OP_RETURN
== last ==
0000    2 OP_GET_LOCAL        2
0002    | OP_CONSTANT         0 '0'
0004    | OP_EQUAL
0005    | OP_JUMP_IF_FALSE    5 -> 18
0008    | OP_POP
0009    3 OP_GET_LOCAL        1
0011    | OP_CONSTANT         0 '0'
0013    | OP_GET_INDEX
0014    | OP_RETURN
0015    4 OP_JUMP            15 -> 19
0018    | OP_POP
0019    5 OP_GET_GLOBAL       1 'last'
0021    | OP_GET_LOCAL        1
0023    | OP_GET_LOCAL        2
0025    | OP_CONSTANT         2 '1'
0027    | OP_SUBTRACT
0028    | OP_CALL             2
0030    | OP_RETURN
