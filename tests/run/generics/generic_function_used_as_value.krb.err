== <script> ==
0000    3 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004    7 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    5 OP_GET_GLOBAL       0 'id'
0010    | OP_DEFINE_GLOBAL    4 'f'
0012    8 OP_NIL
0013    | OP_RETURN
== id ==
0000    2 OP_GET_LOCAL        1
0002    | OP_RETURN
== main ==
0000    7 OP_NIL
0001    | OP_RETURN
