struct Box[string] {
    pub value: string;
}

impl Box[u8] {
    pub fun get(self): u8 = self.value;

    pub fun other[bool](self, extra: bool): bool = extra;
}

type Many[i64] = [i64];

fun id[string](x: string): string = x;

fun first[f64](xs: [f64]): f64 {
    let item: f64 = xs[0];
    item
}

fun main(): unit {
    let n: i64 = id(5);
    @println(n);

    let b: Box[i64] = Box { value: 7 };
    let held: i64 = b.get();
    @println(held);

    let word: string = b.other("word");
    @println(word);

    let words: Many[string] = ["many"];
    let w: string = first(words);
    @println(w);
}
