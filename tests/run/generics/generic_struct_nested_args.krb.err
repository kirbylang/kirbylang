== <script> ==
0000   10 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    | OP_CONSTANT         3 'value'
0020    | OP_CONSTANT         5 '1'
0022    | OP_STRUCT_INIT      1
0024    | OP_DEFINE_GLOBAL    4 'inner'
0026    6 OP_GET_GLOBAL       2 'Box'
0028    | OP_CONSTANT         3 'value'
0030    | OP_GET_GLOBAL       4 'inner'
0032    | OP_STRUCT_INIT      1
0034    | OP_DEFINE_GLOBAL    6 'outer'
0036    7 OP_GET_GLOBAL       2 'Box'
0038    | OP_CONSTANT         3 'value'
0040    | OP_CONSTANT         5 '1'
0042    | OP_CONSTANT         8 '2'
0044    | OP_CONSTANT         9 '3'
0046    | OP_LIST             3
0048    | OP_STRUCT_INIT      1
0050    | OP_DEFINE_GLOBAL    7 'list'
0052   11 OP_NIL
0053    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'outer'
0004    | OP_GET_PROPERTY     2 'value'
0006    | OP_GET_PROPERTY     2 'value'
0008    | OP_CALL             1
0010    | OP_POP
0011   10 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       3 'list'
0015    | OP_GET_PROPERTY     2 'value'
0017    | OP_CONSTANT         4 '1'
0019    | OP_GET_INDEX
0020    | OP_CALL             1
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
