== <script> ==
0000    7 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004   11 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'T'
0010    | OP_DEFINE_GLOBAL    4 'T'
0012    | OP_GET_GLOBAL       4 'T'
0014    2 OP_NIL
0015    | OP_FIELD            5 'x' public mutable
0019    3 OP_POP
0020   12 OP_NIL
0021    | OP_RETURN
== id ==
0000    6 OP_GET_LOCAL        1
0002    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'id'
0004    | OP_CONSTANT         2 'shadowed'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011   10 OP_GET_GLOBAL       3 'T'
0013    | OP_CONSTANT         4 'x'
0015    | OP_CONSTANT         5 '1'
0017    | OP_STRUCT_INIT      1
0019   11 OP_GET_GLOBAL       0 '@println'
0021    | OP_GET_GLOBAL       1 'id'
0023    | OP_GET_LOCAL        1
0025    | OP_CALL             1
0027    | OP_GET_PROPERTY     4 'x'
0029    | OP_CALL             1
0031    | OP_POP
0032    | OP_NIL
0033    | OP_RETURN
