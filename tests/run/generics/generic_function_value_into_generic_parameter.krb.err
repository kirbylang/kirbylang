== <script> ==
0000    1 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004    3 OP_CLOSURE          3 <fn apply>
0006    | OP_DEFINE_GLOBAL    2 'apply'
0008    5 OP_GET_GLOBAL       2 'apply'
0010    | OP_CONSTANT         5 '3'
0012    | OP_GET_GLOBAL       0 'id'
0014    | OP_CALL             2
0016    | OP_DEFINE_GLOBAL    4 'n'
0018    6 OP_GET_GLOBAL       6 '@println'
0020    | OP_GET_GLOBAL       4 'n'
0022    | OP_CONSTANT         7 '1'
0024    | OP_ADD
0025    | OP_CALL             1
0027    | OP_POP
0028    8 OP_GET_GLOBAL       2 'apply'
0030    | OP_CONSTANT         9 'a'
0032    | OP_GET_GLOBAL       0 'id'
0034    | OP_CALL             2
0036    | OP_DEFINE_GLOBAL    8 's'
0038    9 OP_GET_GLOBAL       6 '@println'
0040    | OP_GET_GLOBAL       8 's'
0042    | OP_CONSTANT        10 'b'
0044    | OP_ADD
0045    | OP_CALL             1
0047    | OP_POP
0048   10 OP_NIL
0049    | OP_RETURN
== id ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
== apply ==
0000    3 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
