== <script> ==
0000    1 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004    3 OP_CLOSURE          3 <fn apply>
0006    | OP_DEFINE_GLOBAL    2 'apply'
0008    9 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012   10 OP_NIL
0013    | OP_RETURN
== id ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
== apply ==
0000    3 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 'apply'
0002    | OP_CONSTANT         1 '3'
0004    | OP_GET_GLOBAL       2 'id'
0006    | OP_CALL             2
0008    6 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_LOCAL        1
0012    | OP_CONSTANT         4 '1'
0014    | OP_ADD
0015    | OP_CALL             1
0017    | OP_POP
0018    8 OP_GET_GLOBAL       0 'apply'
0020    | OP_CONSTANT         5 'a'
0022    | OP_GET_GLOBAL       2 'id'
0024    | OP_CALL             2
0026    9 OP_GET_GLOBAL       3 '@println'
0028    | OP_GET_LOCAL        2
0030    | OP_CONSTANT         6 'b'
0032    | OP_ADD
0033    | OP_CALL             1
0035    | OP_POP
0036    | OP_NIL
0037    | OP_RETURN
