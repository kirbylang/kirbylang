== <script> ==
0000   13 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    6 OP_CLOSURE          5 <fn new>
0020    | OP_METHOD           4 'new'
0022    7 OP_CLOSURE          7 <fn same>
0024    | OP_METHOD           6 'same'
0026    8 OP_CLOSURE          9 <fn copy>
0028    | OP_METHOD           8 'copy'
0030    9 OP_POP
0031   14 OP_NIL
0032    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         2 '5'
0004    | OP_INVOKE        (1 args)    1 'new'
0007   12 OP_GET_GLOBAL       3 '@println'
0009    | OP_GET_LOCAL        1
0011    | OP_GET_GLOBAL       0 'Box'
0013    | OP_CONSTANT         5 '6'
0015    | OP_INVOKE        (1 args)    1 'new'
0018    | OP_INVOKE        (1 args)    4 'same'
0021    | OP_CALL             1
0023    | OP_POP
0024   13 OP_GET_GLOBAL       3 '@println'
0026    | OP_GET_LOCAL        1
0028    | OP_INVOKE        (0 args)    6 'copy'
0031    | OP_GET_PROPERTY     7 'value'
0033    | OP_CALL             1
0035    | OP_POP
0036    | OP_NIL
0037    | OP_RETURN
== new ==
0000    6 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== same ==
0000    7 OP_TRUE
0001    | OP_RETURN
== copy ==
0000    8 OP_GET_GLOBAL       0 'Box'
0002    | OP_CONSTANT         1 'value'
0004    | OP_GET_LOCAL        0
0006    | OP_GET_PROPERTY     1 'value'
0008    | OP_STRUCT_INIT      1
0010    | OP_RETURN
