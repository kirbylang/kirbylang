== <script> ==
0000    3 OP_CLOSURE          1 <fn wrap>
0002    | OP_DEFINE_GLOBAL    0 'wrap'
0004    6 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    7 OP_NIL
0009    | OP_RETURN
== wrap ==
0000    2 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 'wrap'
0002    | OP_CONSTANT         1 '3'
0004    | OP_CLOSURE          2 <fn lambda0x1>
0006    | OP_CALL             2
0008    6 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_LOCAL        1
0012    | OP_CONSTANT         4 '1'
0014    | OP_GET_INDEX
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
== lambda0x1 ==
0000    5 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        1
0004    | OP_LIST             2
0006    | OP_GET_LOCAL        2
0008    | OP_RETURN
