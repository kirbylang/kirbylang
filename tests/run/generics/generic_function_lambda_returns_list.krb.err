== <script> ==
0000    3 OP_CLOSURE          1 <fn wrap>
0002    | OP_DEFINE_GLOBAL    0 'wrap'
0004    5 OP_GET_GLOBAL       0 'wrap'
0006    | OP_CONSTANT         3 '3'
0008    | OP_CLOSURE          4 <fn lambda0x1>
0010    | OP_CALL             2
0012    | OP_DEFINE_GLOBAL    2 'xs'
0014    6 OP_GET_GLOBAL       5 '@println'
0016    | OP_GET_GLOBAL       2 'xs'
0018    | OP_CONSTANT         6 '1'
0020    | OP_GET_INDEX
0021    | OP_CALL             1
0023    | OP_POP
0024    7 OP_NIL
0025    | OP_RETURN
== wrap ==
0000    2 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
== lambda0x1 ==
0000    5 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        1
0004    | OP_LIST             2
0006    | OP_GET_LOCAL        2
0008    | OP_RETURN
