0027    | OP_CONSTANT         6 '1'
0029    | OP_CONSTANT         4 'y'
0031    | OP_CONSTANT         7 '2'
0033    | OP_STRUCT_INIT      2
0035    | OP_CALL             1
0037    | OP_DEFINE_GLOBAL    5 'p'
0039   11 OP_GET_GLOBAL       8 '@println'
0041    | OP_GET_GLOBAL       5 'p'
0043    | OP_GET_PROPERTY     3 'x'
0045    | OP_GET_GLOBAL       5 'p'
0047    | OP_GET_PROPERTY     4 'y'
0049    | OP_ADD
0050    | OP_CALL             1
0052    | OP_POP
0053   12 OP_NIL
