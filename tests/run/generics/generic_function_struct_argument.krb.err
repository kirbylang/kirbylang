== <script> ==
0000    8 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004   11 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Point'
0010    | OP_DEFINE_GLOBAL    4 'Point'
0012    | OP_GET_GLOBAL       4 'Point'
0014    2 OP_NIL
0015    | OP_FIELD            5 'x' public mutable
0019    3 OP_NIL
0020    | OP_FIELD            6 'y' public mutable
0024    4 OP_POP
0025   12 OP_NIL
0026    | OP_RETURN
== id ==
0000    7 OP_GET_LOCAL        1
0002    | OP_RETURN
== main ==
0000   10 OP_GET_GLOBAL       0 'id'
0002    | OP_GET_GLOBAL       1 'Point'
0004    | OP_CONSTANT         2 'x'
0006    | OP_CONSTANT         3 '1'
0008    | OP_CONSTANT         4 'y'
0010    | OP_CONSTANT         5 '2'
0012    | OP_STRUCT_INIT      2
0014    | OP_CALL             1
0016   11 OP_GET_GLOBAL       6 '@println'
0018    | OP_GET_LOCAL        1
0020    | OP_GET_PROPERTY     2 'x'
0022    | OP_GET_LOCAL        1
0024    | OP_GET_PROPERTY     4 'y'
0026    | OP_ADD
0027    | OP_CALL             1
0029    | OP_POP
0030    | OP_NIL
0031    | OP_RETURN
