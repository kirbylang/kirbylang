struct Vec2 {
  pub var x: f64;
  pub var y: f64;
}

impl Add for Vec2 {
  fun add(self, other: Self): Self = Vec2 { x: self.x + other.x, y: self.y + other.y };
}

impl Sub for Vec2 {
  fun sub(self, other: Self): Self = Vec2 { x: self.x - other.x, y: self.y - other.y };
}

impl Mul for Vec2 {
  fun mul(self, other: Self): Self = Vec2 { x: self.x * other.x, y: self.y * other.y };
}

impl Div for Vec2 {
  fun div(self, other: Self): Self = Vec2 { x: self.x / other.x, y: self.y / other.y };
}

impl Mod for Vec2 {
  fun mod(self, other: Self): Self = Vec2 { x: self.x % other.x, y: self.y % other.y };
}

impl Neg for Vec2 {
  fun neg(self): Self = Vec2 { x: -self.x, y: -self.y };
}

fun show(v: Vec2): unit {
  @println($"({v.x}, {v.y})");
}

fun main(): unit {
  let a = Vec2 { x: 7, y: 9 };
  let b = Vec2 { x: 2, y: 4 };

  show(a + b);
  show(a - b);
  show(a * b);
  show(a / b);
  show(a % b);
  show(-a);
  show(a + b * b);
}
