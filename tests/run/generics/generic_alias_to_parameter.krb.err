== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    3 OP_CONSTANT         3 '5'
0006    | OP_DEFINE_GLOBAL    2 'n'
0008    4 OP_CONSTANT         5 'a'
0010    | OP_DEFINE_GLOBAL    4 's'
0012    8 OP_NIL
0013    | OP_RETURN
== main ==
0000    6 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'n'
0004    | OP_CONSTANT         2 '1'
0006    | OP_ADD
0007    | OP_CALL             1
0009    | OP_POP
0010    7 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       3 's'
0014    | OP_CONSTANT         4 'b'
0016    | OP_ADD
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
