== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Pair'
0006    | OP_DEFINE_GLOBAL    2 'Pair'
0008    | OP_GET_GLOBAL       2 'Pair'
0010    2 OP_NIL
0011    | OP_FIELD            3 'first' public mutable
0015    3 OP_NIL
0016    | OP_FIELD            4 'second' public mutable
0020    4 OP_POP
0021    8 OP_GET_GLOBAL       2 'Pair'
0023    | OP_CONSTANT         3 'first'
0025    | OP_CONSTANT         6 'k'
0027    | OP_CONSTANT         4 'second'
0029    | OP_TRUE
0030    | OP_STRUCT_INIT      2
0032    | OP_DEFINE_GLOBAL    5 'p'
0034   10 OP_NIL
0035    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'p'
0004    | OP_GET_PROPERTY     2 'first'
0006    | OP_CALL             1
0008    | OP_POP
0009    | OP_NIL
0010    | OP_RETURN
