== <script> ==
0000    3 OP_CLOSURE          1 <fn id>
0002    | OP_DEFINE_GLOBAL    0 'id'
0004    7 OP_CLOSURE          3 <fn twice>
0006    | OP_DEFINE_GLOBAL    2 'twice'
0008   10 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012   11 OP_NIL
0013    | OP_RETURN
== id ==
0000    2 OP_GET_LOCAL        1
0002    | OP_RETURN
== twice ==
0000    6 OP_GET_GLOBAL       0 'id'
0002    | OP_GET_GLOBAL       0 'id'
0004    | OP_GET_LOCAL        1
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_RETURN
== main ==
0000    9 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'twice'
0004    | OP_CONSTANT         2 '7'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011   10 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 'twice'
0015    | OP_CONSTANT         3 'seven'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
