== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    8 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '32767'
0004    | OP_CALL             1
0006    | OP_POP
0007    2 OP_GET_GLOBAL       0 '@println'
0009    | OP_CONSTANT         2 '1'
0011    | OP_CALL             1
0013    | OP_POP
0014    3 OP_GET_GLOBAL       0 '@println'
0016    | OP_CONSTANT         3 '0'
0018    | OP_CALL             1
0020    | OP_POP
0021    4 OP_CONSTANT         1 '32767'
0023    5 OP_GET_GLOBAL       0 '@println'
0025    | OP_GET_LOCAL        1
0027    | OP_CALL             1
0029    | OP_POP
0030    6 OP_CONSTANT         4 '-32768'
0032    7 OP_GET_GLOBAL       0 '@println'
0034    | OP_GET_LOCAL        2
0036    | OP_CALL             1
0038    | OP_POP
0039    | OP_NIL
0040    | OP_RETURN
