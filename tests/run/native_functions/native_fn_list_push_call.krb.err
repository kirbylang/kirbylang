== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_LIST             0
0006    | OP_DEFINE_GLOBAL    2 'array'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@listPush'
0002    | OP_GET_GLOBAL       1 'array'
0004    | OP_CONSTANT         2 '123'
0006    | OP_CALL             2
0008    | OP_POP
0009    5 OP_GET_GLOBAL       3 '@println'
0011    | OP_GET_GLOBAL       1 'array'
0013    | OP_CALL             1
0015    | OP_POP
0016    | OP_NIL
0017    | OP_RETURN
