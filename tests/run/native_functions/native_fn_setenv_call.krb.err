== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@setenv'
0004    | OP_CONSTANT         2 'HELLO'
0006    | OP_CONSTANT         3 'WORLD'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    3 OP_GET_GLOBAL       0 '@println'
0015    | OP_GET_GLOBAL       4 '@getenv'
0017    | OP_CONSTANT         2 'HELLO'
0019    | OP_CALL             1
0021    | OP_CALL             1
0023    | OP_POP
0024    4 OP_NIL
0025    | OP_RETURN
