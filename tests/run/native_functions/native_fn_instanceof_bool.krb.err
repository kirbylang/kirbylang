== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Struct'
0006    | OP_DEFINE_GLOBAL    2 'Struct'
0008    | OP_GET_GLOBAL       2 'Struct'
0010    | OP_POP
0011    4 OP_NIL
0012    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@instanceOf'
0004    | OP_TRUE
0005    | OP_GET_GLOBAL       2 'Struct'
0007    | OP_CALL             2
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
