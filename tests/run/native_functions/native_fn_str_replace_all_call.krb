@println(@strReplaceAll("a-b-c", "-", "+"));
@println(@strReplaceAll("banana", "an", "AN"));
@println(@strReplaceAll("aaa", "aa", "b"));
@println(@strReplaceAll("hello", "xyz", "!"));
@println(@strReplaceAll("abab", "ab", ""));
@println(@strReplaceAll("a.b.c", ".", ".."));
@println(@strReplaceAll("", "a", "b"));
