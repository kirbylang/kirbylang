== <script> ==
0000    1 OP_GET_GLOBAL       1 '@arrPop'
0002    | OP_DEFINE_GLOBAL    0 'pop'
0004    2 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'pop'
0008    | OP_CONSTANT         3 '1'
0010    | OP_CONSTANT         4 '2'
0012    | OP_ARRAY            2
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    3 OP_NIL
0020    | OP_RETURN
