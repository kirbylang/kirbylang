== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@listPop'
0002    2 OP_CONSTANT         1 '1'
0004    | OP_CONSTANT         2 '2'
0006    | OP_LIST             2
0008    3 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_LOCAL        1
0012    | OP_GET_LOCAL        2
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    | OP_NIL
0020    | OP_RETURN
