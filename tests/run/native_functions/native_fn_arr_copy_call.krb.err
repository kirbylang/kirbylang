== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    7 OP_NIL
0015    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@arrCopy'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CALL             1
0006    3 OP_GET_LOCAL        1
0008    | OP_CONSTANT         2 '0'
0010    | OP_CONSTANT         3 '100'
0012    | OP_SET_INDEX
0013    | OP_POP
0014    4 OP_GET_GLOBAL       4 '@println'
0016    | OP_GET_GLOBAL       1 'a'
0018    | OP_CALL             1
0020    | OP_POP
0021    5 OP_GET_GLOBAL       4 '@println'
0023    | OP_GET_LOCAL        1
0025    | OP_CALL             1
0027    | OP_POP
0028    6 OP_GET_GLOBAL       4 '@println'
0030    | OP_GET_GLOBAL       5 '@typeof'
0032    | OP_GET_LOCAL        1
0034    | OP_CALL             1
0036    | OP_CALL             1
0038    | OP_POP
0039    | OP_NIL
0040    | OP_RETURN
