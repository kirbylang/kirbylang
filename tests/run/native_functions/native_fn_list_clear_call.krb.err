== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_LIST             3
0012    | OP_DEFINE_GLOBAL    2 'array'
0014    8 OP_NIL
0015    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'array'
0004    | OP_CALL             1
0006    | OP_POP
0007    5 OP_GET_GLOBAL       2 '@listClear'
0009    | OP_GET_GLOBAL       1 'array'
0011    | OP_CALL             1
0013    | OP_POP
0014    7 OP_GET_GLOBAL       0 '@println'
0016    | OP_GET_GLOBAL       1 'array'
0018    | OP_CALL             1
0020    | OP_POP
0021    | OP_NIL
0022    | OP_RETURN
