== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@sqrt'
0004    | OP_CONSTANT         2 '16'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 '@sqrt'
0015    | OP_CONSTANT         3 '2.25'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    3 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 '@sqrt'
0026    | OP_CONSTANT         4 '0'
0028    | OP_CALL             1
0030    | OP_CALL             1
0032    | OP_POP
0033    4 OP_NIL
0034    | OP_RETURN
