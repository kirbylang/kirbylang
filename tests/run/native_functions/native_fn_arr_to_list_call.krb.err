== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    7 OP_NIL
0015    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@arrToList'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CALL             1
0006    3 OP_GET_GLOBAL       2 '@listPush'
0008    | OP_GET_LOCAL        1
0010    | OP_CONSTANT         3 '4'
0012    | OP_CALL             2
0014    | OP_POP
0015    4 OP_GET_GLOBAL       4 '@println'
0017    | OP_GET_LOCAL        1
0019    | OP_CALL             1
0021    | OP_POP
0022    5 OP_GET_GLOBAL       4 '@println'
0024    | OP_GET_GLOBAL       1 'a'
0026    | OP_CALL             1
0028    | OP_POP
0029    6 OP_GET_GLOBAL       4 '@println'
0031    | OP_GET_GLOBAL       5 '@typeof'
0033    | OP_GET_LOCAL        1
0035    | OP_CALL             1
0037    | OP_CALL             1
0039    | OP_POP
0040    | OP_NIL
0041    | OP_RETURN
