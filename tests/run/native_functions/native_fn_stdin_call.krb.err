== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       1 '@stdin'
0002    | OP_CALL             0
0004    | OP_DEFINE_GLOBAL    0 'text'
0006    3 OP_GET_GLOBAL       2 '@println'
0008    | OP_CONSTANT         3 'Hello '
0010    | OP_GET_GLOBAL       0 'text'
0012    | OP_ADD
0013    | OP_CALL             1
0015    | OP_POP
0016    4 OP_NIL
0017    | OP_RETURN
