== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@stdin'
0002    | OP_CALL             0
0004    3 OP_GET_GLOBAL       1 '@println'
0006    | OP_CONSTANT         2 'Hello '
0008    | OP_GET_LOCAL        1
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_POP
0014    | OP_NIL
0015    | OP_RETURN
