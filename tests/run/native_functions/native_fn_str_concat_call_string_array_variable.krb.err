== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'Hello'
0006    | OP_CONSTANT         4 ', '
0008    | OP_CONSTANT         5 'World'
0010    | OP_LIST             3
0012    | OP_DEFINE_GLOBAL    2 'parts'
0014    4 OP_NIL
0015    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_GET_GLOBAL       2 'parts'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
