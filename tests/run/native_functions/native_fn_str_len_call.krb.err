== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    3 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strLen'
0004    | OP_CONSTANT         2 'Hello World'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 '@strLen'
0015    | OP_CONSTANT         3 ''
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    | OP_NIL
0023    | OP_RETURN
