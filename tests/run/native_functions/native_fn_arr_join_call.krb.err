== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'Hello'
0006    | OP_CONSTANT         4 'World'
0008    | OP_ARRAY            2
0010    | OP_DEFINE_GLOBAL    2 'parts'
0012    4 OP_NIL
0013    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@arrJoin'
0004    | OP_GET_GLOBAL       2 'parts'
0006    | OP_CONSTANT         3 ' '
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    3 OP_GET_GLOBAL       0 '@println'
0015    | OP_GET_GLOBAL       1 '@arrJoin'
0017    | OP_GET_GLOBAL       2 'parts'
0019    | OP_CONSTANT         4 ''
0021    | OP_CALL             2
0023    | OP_CALL             1
0025    | OP_POP
0026    | OP_NIL
0027    | OP_RETURN
