== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1.5'
0006    | OP_LIST             1
0008    | OP_DEFINE_GLOBAL    2 'floats'
0010    7 OP_NIL
0011    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@listPush'
0002    | OP_GET_GLOBAL       1 'floats'
0004    | OP_CONSTANT         2 '2'
0006    | OP_CALL             2
0008    | OP_POP
0009    3 OP_GET_GLOBAL       3 '@listInsert'
0011    | OP_GET_GLOBAL       1 'floats'
0013    | OP_CONSTANT         4 '0'
0015    | OP_CONSTANT         5 '3'
0017    | OP_CALL             3
0019    | OP_POP
0020    4 OP_GET_GLOBAL       6 '@println'
0022    | OP_GET_GLOBAL       1 'floats'
0024    | OP_CALL             1
0026    | OP_POP
0027    5 OP_GET_GLOBAL       6 '@println'
0029    | OP_GET_GLOBAL       7 '@typeof'
0031    | OP_GET_GLOBAL       1 'floats'
0033    | OP_CONSTANT         4 '0'
0035    | OP_GET_INDEX
0036    | OP_CALL             1
0038    | OP_CALL             1
0040    | OP_POP
0041    6 OP_GET_GLOBAL       6 '@println'
0043    | OP_GET_GLOBAL       8 '@listContains'
0045    | OP_GET_GLOBAL       1 'floats'
0047    | OP_CONSTANT         2 '2'
0049    | OP_CALL             2
0051    | OP_CALL             1
0053    | OP_POP
0054    | OP_NIL
0055    | OP_RETURN
