== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strRepeat'
0004    | OP_CONSTANT         2 'ab'
0006    | OP_CONSTANT         3 '3'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    2 OP_GET_GLOBAL       0 '@println'
0015    | OP_GET_GLOBAL       1 '@strRepeat'
0017    | OP_CONSTANT         4 'x'
0019    | OP_CONSTANT         5 '1'
0021    | OP_CALL             2
0023    | OP_CALL             1
0025    | OP_POP
0026    3 OP_GET_GLOBAL       0 '@println'
0028    | OP_GET_GLOBAL       1 '@strRepeat'
0030    | OP_CONSTANT         2 'ab'
0032    | OP_CONSTANT         6 '0'
0034    | OP_CALL             2
0036    | OP_CALL             1
0038    | OP_POP
0039    4 OP_GET_GLOBAL       0 '@println'
0041    | OP_GET_GLOBAL       1 '@strRepeat'
0043    | OP_CONSTANT         7 ''
0045    | OP_CONSTANT         8 '5'
0047    | OP_CALL             2
0049    | OP_CALL             1
0051    | OP_POP
0052    5 OP_NIL
0053    | OP_RETURN
