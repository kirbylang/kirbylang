== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    6 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@strToBytes'
0002    | OP_CONSTANT         1 'AB'
0004    | OP_CALL             1
0006    2 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_GLOBAL       3 '@listLen'
0010    | OP_GET_LOCAL        1
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017    3 OP_GET_GLOBAL       2 '@println'
0019    | OP_GET_LOCAL        1
0021    | OP_CONSTANT         4 '0'
0023    | OP_GET_INDEX
0024    | OP_CALL             1
0026    | OP_POP
0027    4 OP_GET_GLOBAL       2 '@println'
0029    | OP_GET_LOCAL        1
0031    | OP_CONSTANT         5 '1'
0033    | OP_GET_INDEX
0034    | OP_CALL             1
0036    | OP_POP
0037    5 OP_GET_GLOBAL       2 '@println'
0039    | OP_GET_GLOBAL       6 '@typeof'
0041    | OP_GET_LOCAL        1
0043    | OP_CONSTANT         4 '0'
0045    | OP_GET_INDEX
0046    | OP_CALL             1
0048    | OP_CALL             1
0050    | OP_POP
0051    | OP_NIL
0052    | OP_RETURN
