== <script> ==
0000    1 OP_GET_GLOBAL       0 '@assert'
0002    | OP_TRUE
0003    | OP_CONSTANT         1 'never shown'
0005    | OP_CALL             2
0007    | OP_POP
0008    2 OP_GET_GLOBAL       0 '@assert'
0010    | OP_CONSTANT         2 '1'
0012    | OP_CONSTANT         3 '2'
0014    | OP_LESS
0015    | OP_CONSTANT         4 'math works'
0017    | OP_CALL             2
0019    | OP_POP
0020    3 OP_GET_GLOBAL       5 '@println'
0022    | OP_CONSTANT         6 'after'
