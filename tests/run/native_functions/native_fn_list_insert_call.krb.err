== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'Testing'
0006    | OP_LIST             1
0008    | OP_DEFINE_GLOBAL    2 'array'
0010    7 OP_NIL
0011    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@listInsert'
0002    | OP_GET_GLOBAL       1 'array'
0004    | OP_CONSTANT         2 '0'
0006    | OP_CONSTANT         3 'Hello'
0008    | OP_CALL             3
0010    | OP_POP
0011    4 OP_GET_GLOBAL       0 '@listInsert'
0013    | OP_GET_GLOBAL       1 'array'
0015    | OP_CONSTANT         4 '1'
0017    | OP_CONSTANT         5 'World'
0019    | OP_CALL             3
0021    | OP_POP
0022    6 OP_GET_GLOBAL       6 '@println'
0024    | OP_GET_GLOBAL       1 'array'
0026    | OP_CALL             1
0028    | OP_POP
0029    | OP_NIL
0030    | OP_RETURN
