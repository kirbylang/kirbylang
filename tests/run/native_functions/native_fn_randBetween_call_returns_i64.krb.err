== <script> ==
0000    1 OP_GET_GLOBAL       1 '@randBetween'
0002    | OP_CONSTANT         2 '1'
0004    | OP_CONSTANT         3 '6'
0006    | OP_CALL             2
0008    | OP_DEFINE_GLOBAL    0 'roll'
0010    2 OP_GET_GLOBAL       4 '@println'
0012    | OP_GET_GLOBAL       0 'roll'
0014    | OP_CONSTANT         2 '1'
0016    | OP_LESS
0017    | OP_NOT
0018    | OP_JUMP_IF_FALSE   18 -> 28
0021    | OP_POP
0022    | OP_GET_GLOBAL       0 'roll'
0024    | OP_CONSTANT         3 '6'
0026    | OP_GREATER
0027    | OP_NOT
0028    | OP_CALL             1
0030    | OP_POP
0031    3 OP_GET_GLOBAL       4 '@println'
0033    | OP_GET_GLOBAL       5 '@typeof'
0035    | OP_GET_GLOBAL       0 'roll'
0037    | OP_CALL             1
0039    | OP_CALL             1
0041    | OP_POP
0042    4 OP_NIL
0043    | OP_RETURN
