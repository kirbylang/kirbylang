== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@randBetween'
0002    | OP_CONSTANT         1 '1'
0004    | OP_CONSTANT         2 '6'
0006    | OP_CALL             2
0008    2 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_LOCAL        1
0012    | OP_CONSTANT         1 '1'
0014    | OP_LESS
0015    | OP_NOT
0016    | OP_JUMP_IF_FALSE   16 -> 26
0019    | OP_POP
0020    | OP_GET_LOCAL        1
0022    | OP_CONSTANT         2 '6'
0024    | OP_GREATER
0025    | OP_NOT
0026    | OP_CALL             1
0028    | OP_POP
0029    3 OP_GET_GLOBAL       3 '@println'
0031    | OP_GET_GLOBAL       4 '@typeof'
0033    | OP_GET_LOCAL        1
0035    | OP_CALL             1
0037    | OP_CALL             1
0039    | OP_POP
0040    | OP_NIL
0041    | OP_RETURN
