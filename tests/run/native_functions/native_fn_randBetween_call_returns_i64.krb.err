== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@randBetween'
0002    | OP_CONSTANT         1 '1'
0004    | OP_CONSTANT         2 '6'
0006    | OP_CALL             2
0008    2 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_LOCAL        1
0012    | OP_CONSTANT         1 '1'
0014    | OP_GREATER_EQUAL
0015    | OP_JUMP_IF_FALSE   15 -> 24
0018    | OP_POP
0019    | OP_GET_LOCAL        1
0021    | OP_CONSTANT         2 '6'
0023    | OP_LESS_EQUAL
0024    | OP_CALL             1
0026    | OP_POP
0027    3 OP_GET_GLOBAL       3 '@println'
0029    | OP_GET_GLOBAL       4 '@typeof'
0031    | OP_GET_LOCAL        1
0033    | OP_CALL             1
0035    | OP_CALL             1
0037    | OP_POP
0038    | OP_NIL
0039    | OP_RETURN
