== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@argc'
0004    | OP_CALL             0
0006    | OP_CALL             1
0008    | OP_POP
0009    2 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       2 '@argv'
0013    | OP_CONSTANT         3 '0'
0015    | OP_CALL             1
0017    | OP_NIL
0018    | OP_EQUAL
0019    | OP_NOT
0020    | OP_CALL             1
0022    | OP_POP
0023    3 OP_GET_GLOBAL       0 '@println'
0025    | OP_GET_GLOBAL       2 '@argv'
0027    | OP_CONSTANT         4 '1'
0029    | OP_CALL             1
0031    | OP_CALL             1
0033    | OP_POP
0034    4 OP_NIL
0035    | OP_RETURN
