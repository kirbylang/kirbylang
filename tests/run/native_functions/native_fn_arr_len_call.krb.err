== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '10'
0006    | OP_CONSTANT         4 '20'
0008    | OP_CONSTANT         5 '30'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    2 OP_ARRAY            0
0016    | OP_DEFINE_GLOBAL    6 'none'
0018    7 OP_NIL
0019    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@arrLen'
0004    | OP_GET_GLOBAL       2 'a'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    4 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 '@arrLen'
0015    | OP_GET_GLOBAL       3 'none'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    5 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 '@arrLen'
0026    | OP_CONSTANT         2 'a'
0028    | OP_CONSTANT         4 'b'
0030    | OP_ARRAY            2
0032    | OP_CALL             1
0034    | OP_CALL             1
0036    | OP_POP
0037    6 OP_GET_GLOBAL       0 '@println'
0039    | OP_GET_GLOBAL       5 '@typeof'
0041    | OP_GET_GLOBAL       1 '@arrLen'
0043    | OP_GET_GLOBAL       2 'a'
0045    | OP_CALL             1
0047    | OP_CALL             1
0049    | OP_CALL             1
0051    | OP_POP
0052    | OP_NIL
0053    | OP_RETURN
