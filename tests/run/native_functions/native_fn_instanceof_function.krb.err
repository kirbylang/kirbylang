== <script> ==
0000    3 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    5 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    1 OP_STRUCT           4 'Struct'
0010    | OP_DEFINE_GLOBAL    4 'Struct'
0012    | OP_GET_GLOBAL       4 'Struct'
0014    | OP_POP
0015    6 OP_NIL
0016    | OP_RETURN
== test ==
0000    3 OP_NIL
0001    | OP_RETURN
== main ==
0000    5 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@instanceOf'
0004    | OP_GET_GLOBAL       2 'test'
0006    | OP_GET_GLOBAL       3 'Struct'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
