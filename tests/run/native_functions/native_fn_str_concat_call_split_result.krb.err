== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strConcat'
0004    | OP_GET_GLOBAL       2 '@strSplit'
0006    | OP_CONSTANT         3 'a,b,c'
0008    | OP_CONSTANT         4 ','
0010    | OP_CALL             2
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017    2 OP_NIL
0018    | OP_RETURN
