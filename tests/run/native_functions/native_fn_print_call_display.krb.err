== <script> ==
0000   16 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'Box'
0006    | OP_DEFINE_GLOBAL    2 'Box'
0008    | OP_GET_GLOBAL       2 'Box'
0010    2 OP_NIL
0011    | OP_FIELD            3 'value' public mutable
0015    3 OP_POP
0016    5 OP_GET_GLOBAL       2 'Box'
0018    6 OP_CLOSURE          5 <fn toString>
0020    | OP_METHOD           4 'toString'
0022    7 OP_POP
0023    9 OP_GET_GLOBAL       2 'Box'
0025    | OP_CONSTANT         3 'value'
0027    | OP_CONSTANT         7 '123'
0029    | OP_STRUCT_INIT      1
0031    | OP_DEFINE_GLOBAL    6 'box'
0033   17 OP_NIL
0034    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@print'
0002    | OP_GET_GLOBAL       1 'box'
0004    | OP_INVOKE        (0 args)    2 'toString'
0007    | OP_CALL             1
0009    | OP_POP
0010   12 OP_GET_GLOBAL       3 '@println'
0012    | OP_CONSTANT         4 ''
0014    | OP_CALL             1
0016    | OP_POP
0017   13 OP_GET_GLOBAL       3 '@println'
0019    | OP_GET_GLOBAL       1 'box'
0021    | OP_INVOKE        (0 args)    2 'toString'
0024    | OP_CALL             1
0026    | OP_POP
0027   14 OP_GET_GLOBAL       5 '@eprint'
0029    | OP_GET_GLOBAL       1 'box'
0031    | OP_INVOKE        (0 args)    2 'toString'
0034    | OP_CALL             1
0036    | OP_POP
0037   15 OP_GET_GLOBAL       6 '@eprintln'
0039    | OP_GET_GLOBAL       1 'box'
0041    | OP_INVOKE        (0 args)    2 'toString'
0044    | OP_CALL             1
0046    | OP_POP
0047   16 OP_GET_GLOBAL       3 '@println'
0049    | OP_GET_GLOBAL       7 'Box'
0051    | OP_CONSTANT         8 'value'
0053    | OP_CONSTANT         9 '1'
0055    | OP_STRUCT_INIT      1
0057    | OP_INVOKE        (0 args)    2 'toString'
0060    | OP_CALL             1
0062    | OP_POP
0063    | OP_NIL
0064    | OP_RETURN
== toString ==
0000    6 OP_GET_GLOBAL       0 '@strConcat'
0002    | OP_CONSTANT         1 'Box('
0004    | OP_GET_GLOBAL       2 '@numberToString'
0006    | OP_GET_LOCAL        0
0008    | OP_GET_PROPERTY     3 'value'
0010    | OP_CALL             1
0012    | OP_CONSTANT         4 ')'
