== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '10'
0006    | OP_CONSTANT         4 '20'
0008    | OP_CONSTANT         5 '30'
0010    | OP_CONSTANT         6 '40'
0012    | OP_CONSTANT         7 '50'
0014    | OP_LIST             5
0016    | OP_DEFINE_GLOBAL    2 'array'
0018    6 OP_NIL
0019    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@listSlice'
0002    | OP_GET_GLOBAL       1 'array'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '4'
0008    | OP_CALL             3
0010    5 OP_GET_GLOBAL       4 '@println'
0012    | OP_GET_GLOBAL       5 '@listEqual'
0014    | OP_CONSTANT         6 '20'
0016    | OP_CONSTANT         7 '30'
0018    | OP_CONSTANT         8 '40'
0020    | OP_LIST             3
0022    | OP_GET_LOCAL        1
0024    | OP_CALL             2
0026    | OP_CALL             1
0028    | OP_POP
0029    | OP_NIL
0030    | OP_RETURN
