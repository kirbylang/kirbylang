== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_LIST             0
0006    | OP_DEFINE_GLOBAL    2 'empty'
0008    4 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strIsEmpty'
0004    | OP_GET_GLOBAL       2 '@listJoin'
0006    | OP_GET_GLOBAL       3 'empty'
0008    | OP_CONSTANT         4 ', '
0010    | OP_CALL             2
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
