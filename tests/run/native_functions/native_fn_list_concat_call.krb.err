== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_LIST             3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    2 OP_CONSTANT         7 '4'
0016    | OP_CONSTANT         8 '5'
0018    | OP_CONSTANT         9 '6'
0020    | OP_LIST             3
0022    | OP_DEFINE_GLOBAL    6 'b'
0024    8 OP_NIL
0025    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@listConcat'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_GET_GLOBAL       2 'b'
0006    | OP_CALL             2
0008    5 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_GLOBAL       1 'a'
0012    | OP_CALL             1
0014    | OP_POP
0015    6 OP_GET_GLOBAL       3 '@println'
0017    | OP_GET_GLOBAL       2 'b'
0019    | OP_CALL             1
0021    | OP_POP
0022    7 OP_GET_GLOBAL       3 '@println'
0024    | OP_GET_LOCAL        1
0026    | OP_CALL             1
0028    | OP_POP
0029    | OP_NIL
0030    | OP_RETURN
