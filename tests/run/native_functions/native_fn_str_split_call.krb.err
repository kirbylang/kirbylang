== <script> ==
0000   10 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   11 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@strSplit'
0002    | OP_CONSTANT         1 'a,b,c'
0004    | OP_CONSTANT         2 ','
0006    | OP_CALL             2
0008    2 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_LOCAL        1
0012    | OP_CALL             1
0014    | OP_POP
0015    3 OP_GET_GLOBAL       3 '@println'
0017    | OP_GET_GLOBAL       4 '@listLen'
0019    | OP_GET_LOCAL        1
0021    | OP_CALL             1
0023    | OP_CALL             1
0025    | OP_POP
0026    4 OP_GET_GLOBAL       3 '@println'
0028    | OP_GET_LOCAL        1
0030    | OP_CONSTANT         5 '1'
0032    | OP_GET_INDEX
0033    | OP_CALL             1
0035    | OP_POP
0036    5 OP_GET_GLOBAL       3 '@println'
0038    | OP_GET_GLOBAL       0 '@strSplit'
0040    | OP_CONSTANT         6 'a,b,,c'
0042    | OP_CONSTANT         2 ','
0044    | OP_CALL             2
0046    | OP_CALL             1
0048    | OP_POP
0049    6 OP_GET_GLOBAL       3 '@println'
0051    | OP_GET_GLOBAL       0 '@strSplit'
0053    | OP_CONSTANT         7 'a,b,'
0055    | OP_CONSTANT         2 ','
0057    | OP_CALL             2
0059    | OP_CALL             1
0061    | OP_POP
0062    7 OP_GET_GLOBAL       3 '@println'
0064    | OP_GET_GLOBAL       0 '@strSplit'
0066    | OP_CONSTANT         8 ',a'
0068    | OP_CONSTANT         2 ','
0070    | OP_CALL             2
0072    | OP_CALL             1
0074    | OP_POP
0075    8 OP_GET_GLOBAL       3 '@println'
0077    | OP_GET_GLOBAL       0 '@strSplit'
0079    | OP_CONSTANT         9 'abc'
0081    | OP_CONSTANT         2 ','
0083    | OP_CALL             2
0085    | OP_CALL             1
0087    | OP_POP
0088    9 OP_GET_GLOBAL       3 '@println'
0090    | OP_GET_GLOBAL       0 '@strSplit'
0092    | OP_CONSTANT        10 'a--b--c'
0094    | OP_CONSTANT        11 '--'
0096    | OP_CALL             2
0098    | OP_CALL             1
0100    | OP_POP
0101   10 OP_GET_GLOBAL       3 '@println'
0103    | OP_GET_GLOBAL       0 '@strSplit'
0105    | OP_CONSTANT        12 'aaa'
0107    | OP_CONSTANT        13 'aa'
0109    | OP_CALL             2
0111    | OP_CALL             1
0113    | OP_POP
0114    | OP_NIL
0115    | OP_RETURN
