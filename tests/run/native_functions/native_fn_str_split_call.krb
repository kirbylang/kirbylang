var parts = @strSplit("a,b,c", ",");
@println(parts);
@println(@arrLen(parts));
@println(parts[1]);
@println(@strSplit("a,b,,c", ","));
@println(@strSplit("a,b,", ","));
@println(@strSplit(",a", ","));
@println(@strSplit("abc", ","));
@println(@strSplit("a--b--c", "--"));
@println(@strSplit("aaa", "aa"));
