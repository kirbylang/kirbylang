== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_LIST             3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014   10 OP_NIL
0015    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 'a'
0002    3 OP_GET_GLOBAL       1 '@listCopy'
0004    | OP_GET_GLOBAL       0 'a'
0006    | OP_CALL             1
0008    5 OP_GET_GLOBAL       0 'a'
0010    | OP_CONSTANT         2 '0'
0012    | OP_CONSTANT         3 '100'
0014    | OP_SET_INDEX
0015    | OP_POP
0016    7 OP_GET_GLOBAL       4 '@println'
0018    | OP_GET_GLOBAL       0 'a'
0020    | OP_CALL             1
0022    | OP_POP
0023    8 OP_GET_GLOBAL       4 '@println'
0025    | OP_GET_LOCAL        1
0027    | OP_CALL             1
0029    | OP_POP
0030    9 OP_GET_GLOBAL       4 '@println'
0032    | OP_GET_LOCAL        2
0034    | OP_CALL             1
0036    | OP_POP
0037    | OP_NIL
0038    | OP_RETURN
