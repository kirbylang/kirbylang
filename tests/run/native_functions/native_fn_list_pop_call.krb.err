== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_LIST             3
0012    | OP_DEFINE_GLOBAL    2 'array'
0014    7 OP_NIL
0015    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@listPop'
0002    | OP_GET_GLOBAL       1 'array'
0004    | OP_CALL             1
0006    5 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_GLOBAL       1 'array'
0010    | OP_CALL             1
0012    | OP_POP
0013    6 OP_GET_GLOBAL       2 '@println'
0015    | OP_GET_LOCAL        1
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
