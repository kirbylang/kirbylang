== <script> ==
0000   10 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_STRUCT           2 'StructA'
0006    | OP_DEFINE_GLOBAL    2 'StructA'
0008    | OP_GET_GLOBAL       2 'StructA'
0010    | OP_POP
0011    2 OP_STRUCT           3 'StructB'
0013    | OP_DEFINE_GLOBAL    3 'StructB'
0015    | OP_GET_GLOBAL       3 'StructB'
0017    | OP_POP
0018    4 OP_GET_GLOBAL       2 'StructA'
0020    | OP_STRUCT_INIT      0
0022    | OP_DEFINE_GLOBAL    4 'instanceA'
0024    5 OP_GET_GLOBAL       3 'StructB'
0026    | OP_STRUCT_INIT      0
0028    | OP_DEFINE_GLOBAL    5 'instanceB'
0030   11 OP_NIL
0031    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@instanceOf'
0004    | OP_GET_GLOBAL       2 'instanceA'
0006    | OP_GET_GLOBAL       3 'StructA'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    8 OP_GET_GLOBAL       0 '@println'
0015    | OP_GET_GLOBAL       1 '@instanceOf'
0017    | OP_GET_GLOBAL       4 'instanceB'
0019    | OP_GET_GLOBAL       5 'StructB'
0021    | OP_CALL             2
0023    | OP_CALL             1
0025    | OP_POP
0026    9 OP_GET_GLOBAL       0 '@println'
0028    | OP_GET_GLOBAL       1 '@instanceOf'
0030    | OP_GET_GLOBAL       2 'instanceA'
0032    | OP_GET_GLOBAL       5 'StructB'
0034    | OP_CALL             2
0036    | OP_CALL             1
0038    | OP_POP
0039   10 OP_GET_GLOBAL       0 '@println'
0041    | OP_GET_GLOBAL       1 '@instanceOf'
0043    | OP_GET_GLOBAL       4 'instanceB'
0045    | OP_GET_GLOBAL       3 'StructA'
0047    | OP_CALL             2
0049    | OP_CALL             1
0051    | OP_POP
0052    | OP_NIL
0053    | OP_RETURN
