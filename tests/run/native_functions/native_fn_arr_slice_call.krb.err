== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '10'
0006    | OP_CONSTANT         4 '20'
0008    | OP_CONSTANT         5 '30'
0010    | OP_CONSTANT         6 '40'
0012    | OP_CONSTANT         7 '50'
0014    | OP_ARRAY            5
0016    | OP_DEFINE_GLOBAL    2 'a'
0018    7 OP_NIL
0019    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@arrSlice'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '4'
0008    | OP_CALL             3
0010    3 OP_GET_GLOBAL       4 '@println'
0012    | OP_GET_LOCAL        1
0014    | OP_CALL             1
0016    | OP_POP
0017    4 OP_GET_GLOBAL       4 '@println'
0019    | OP_GET_GLOBAL       5 '@typeof'
0021    | OP_GET_LOCAL        1
0023    | OP_CALL             1
0025    | OP_CALL             1
0027    | OP_POP
0028    5 OP_GET_GLOBAL       6 '@listPush'
0030    | OP_GET_LOCAL        1
0032    | OP_CONSTANT         7 '60'
0034    | OP_CALL             2
0036    | OP_POP
0037    6 OP_GET_GLOBAL       4 '@println'
0039    | OP_GET_LOCAL        1
0041    | OP_CALL             1
0043    | OP_POP
0044    | OP_NIL
0045    | OP_RETURN
