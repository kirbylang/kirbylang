== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@strSplit'
0002    | OP_CONSTANT         1 'p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11'
0004    | OP_CONSTANT         2 ','
0006    | OP_CALL             2
0008    2 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_GLOBAL       4 '@listLen'
0012    | OP_GET_LOCAL        1
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    3 OP_GET_GLOBAL       3 '@println'
0021    | OP_GET_GLOBAL       5 '@listJoin'
0023    | OP_GET_LOCAL        1
0025    | OP_CONSTANT         6 '+'
0027    | OP_CALL             2
0029    | OP_CALL             1
0031    | OP_POP
0032    | OP_NIL
0033    | OP_RETURN
