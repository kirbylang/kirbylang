== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    4 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@strSplit'
0002    | OP_CONSTANT         1 'a b c'
0004    | OP_CONSTANT         2 ' '
0006    | OP_CALL             2
0008    2 OP_GET_GLOBAL       3 '@println'
0010    | OP_GET_GLOBAL       4 '@listJoin'
0012    | OP_GET_LOCAL        1
0014    | OP_CONSTANT         5 '-'
0016    | OP_CALL             2
0018    | OP_CALL             1
0020    | OP_POP
0021    3 OP_GET_GLOBAL       3 '@println'
0023    | OP_GET_LOCAL        1
0025    | OP_CONSTANT         6 '0'
0027    | OP_GET_INDEX
0028    | OP_CALL             1
0030    | OP_POP
0031    | OP_NIL
0032    | OP_RETURN
