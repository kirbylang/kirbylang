== <script> ==
0000    1 OP_GET_GLOBAL       1 '@strSplit'
0002    | OP_CONSTANT         2 'a b c'
0004    | OP_CONSTANT         3 ' '
0006    | OP_CALL             2
0008    | OP_DEFINE_GLOBAL    0 'parts'
0010    2 OP_GET_GLOBAL       4 '@println'
0012    | OP_GET_GLOBAL       5 '@arrJoin'
0014    | OP_GET_GLOBAL       0 'parts'
0016    | OP_CONSTANT         6 '-'
0018    | OP_CALL             2
0020    | OP_CALL             1
0022    | OP_POP
0023    3 OP_GET_GLOBAL       4 '@println'
0025    | OP_GET_GLOBAL       0 'parts'
0027    | OP_CONSTANT         7 '0'
0029    | OP_GET_INDEX
0030    | OP_CALL             1
0032    | OP_POP
0033    4 OP_NIL
0034    | OP_RETURN
