== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_CONSTANT         6 '4'
0012    | OP_ARRAY            4
0014    | OP_DEFINE_GLOBAL    2 'a'
0016    8 OP_NIL
0017    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@arrReverse'
0002    | OP_GET_GLOBAL       1 'a'
0004    | OP_CALL             1
0006    3 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_LOCAL        1
0010    | OP_CALL             1
0012    | OP_POP
0013    4 OP_GET_GLOBAL       2 '@println'
0015    | OP_GET_GLOBAL       1 'a'
0017    | OP_CALL             1
0019    | OP_POP
0020    5 OP_GET_GLOBAL       2 '@println'
0022    | OP_GET_GLOBAL       3 '@typeof'
0024    | OP_GET_LOCAL        1
0026    | OP_CALL             1
0028    | OP_CALL             1
0030    | OP_POP
0031    6 OP_GET_LOCAL        1
0033    | OP_CONSTANT         4 '0'
0035    | OP_GET_INDEX
0036    7 OP_GET_GLOBAL       2 '@println'
0038    | OP_GET_LOCAL        2
0040    | OP_CALL             1
0042    | OP_POP
0043    | OP_NIL
0044    | OP_RETURN
