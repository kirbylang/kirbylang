== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_ARRAY            2
0010    | OP_CONSTANT         5 '3'
0012    | OP_CONSTANT         6 '4'
0014    | OP_ARRAY            2
0016    | OP_ARRAY            2
0018    | OP_DEFINE_GLOBAL    2 'm'
0020    5 OP_NIL
0021    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 '@arrToList'
0002    | OP_GET_GLOBAL       1 'm'
0004    | OP_CALL             1
0006    3 OP_GET_GLOBAL       2 '@println'
0008    | OP_GET_GLOBAL       3 '@arrLen'
0010    | OP_GET_LOCAL        1
0012    | OP_CONSTANT         4 '0'
0014    | OP_GET_INDEX
0015    | OP_CALL             1
0017    | OP_CALL             1
0019    | OP_POP
0020    4 OP_GET_GLOBAL       2 '@println'
0022    | OP_GET_LOCAL        1
0024    | OP_CALL             1
0026    | OP_POP
0027    | OP_NIL
0028    | OP_RETURN
