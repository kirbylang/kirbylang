== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       1 '@version'
0002    | OP_CALL             0
0004    | OP_DEFINE_GLOBAL    0 'version'
0006    2 OP_GET_GLOBAL       3 '@getenv'
0008    | OP_CONSTANT         4 'EXPECTED_KIRBY_VERSION'
0010    | OP_CALL             1
0012    | OP_DEFINE_GLOBAL    2 'expected_version'
0014    4 OP_GET_GLOBAL       5 '@println'
0016    | OP_GET_GLOBAL       6 '@strConcat'
0018    | OP_CONSTANT         7 '@version() returns version from VERSION.txt: '
0020    | OP_GET_GLOBAL       8 '@boolToString'
0022    | OP_GET_GLOBAL       2 'expected_version'
0024    | OP_GET_GLOBAL       0 'version'
0026    | OP_EQUAL
0027    | OP_CALL             1
0029    | OP_ARRAY            2
0031    | OP_CALL             1
0033    | OP_CALL             1
0035    | OP_POP
0036    5 OP_NIL
0037    | OP_RETURN
