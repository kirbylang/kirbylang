== <script> ==
0000    4 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    5 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@version'
0002    | OP_CALL             0
0004    2 OP_GET_GLOBAL       1 '@getenv'
0006    | OP_CONSTANT         2 'EXPECTED_KIRBY_VERSION'
0008    | OP_CALL             1
0010    4 OP_GET_GLOBAL       3 '@println'
0012    | OP_GET_GLOBAL       4 '@strConcat'
0014    | OP_CONSTANT         5 '@version() returns version from VERSION.txt: '
0016    | OP_GET_GLOBAL       6 '@boolToString'
0018    | OP_GET_LOCAL        2
0020    | OP_GET_LOCAL        1
0022    | OP_EQUAL
0023    | OP_CALL             1
0025    | OP_LIST             2
0027    | OP_CALL             1
0029    | OP_CALL             1
0031    | OP_POP
0032    | OP_NIL
0033    | OP_RETURN
