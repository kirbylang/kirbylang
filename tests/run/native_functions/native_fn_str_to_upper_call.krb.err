== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@strToUpper'
0004    | OP_CONSTANT         2 'Hello, World 123!'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 '@strToUpper'
0015    | OP_CONSTANT         3 'already UPPER'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    3 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 '@strToUpper'
0026    | OP_CONSTANT         4 ''
0028    | OP_CALL             1
0030    | OP_CALL             1
0032    | OP_POP
0033    4 OP_GET_GLOBAL       0 '@println'
0035    | OP_GET_GLOBAL       1 '@strToUpper'
0037    | OP_CONSTANT         5 'café'
0039    | OP_CALL             1
0041    | OP_CALL             1
0043    | OP_POP
0044    5 OP_NIL
0045    | OP_RETURN
