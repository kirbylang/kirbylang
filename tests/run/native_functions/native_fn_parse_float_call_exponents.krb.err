== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@parseFloat'
0004    | OP_CONSTANT         2 '1e3'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 '@parseFloat'
0015    | OP_CONSTANT         3 '2.5E-4'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    3 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 '@parseFloat'
0026    | OP_CONSTANT         4 '-1.5e+2'
0028    | OP_CALL             1
0030    | OP_CALL             1
0032    | OP_POP
0033    4 OP_GET_GLOBAL       0 '@println'
0035    | OP_GET_GLOBAL       1 '@parseFloat'
0037    | OP_CONSTANT         5 '+7e0'
0039    | OP_CALL             1
0041    | OP_CALL             1
0043    | OP_POP
0044    5 OP_GET_GLOBAL       0 '@println'
0046    | OP_GET_GLOBAL       1 '@parseFloat'
0048    | OP_CONSTANT         6 '1e-400'
0050    | OP_CALL             1
0052    | OP_CALL             1
0054    | OP_POP
0055    6 OP_NIL
0056    | OP_RETURN
