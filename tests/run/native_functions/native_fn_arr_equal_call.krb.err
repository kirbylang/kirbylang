== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_CONSTANT         4 '2'
0008    | OP_CONSTANT         5 '3'
0010    | OP_ARRAY            3
0012    | OP_DEFINE_GLOBAL    2 'a'
0014    2 OP_CONSTANT         3 '1'
0016    | OP_CONSTANT         4 '2'
0018    | OP_CONSTANT         5 '3'
0020    | OP_ARRAY            3
0022    | OP_DEFINE_GLOBAL    6 'b'
0024    3 OP_CONSTANT         3 '1'
0026    | OP_CONSTANT         4 '2'
0028    | OP_CONSTANT         8 '4'
0030    | OP_ARRAY            3
0032    | OP_DEFINE_GLOBAL    7 'c'
0034    7 OP_NIL
0035    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@arrEqual'
0004    | OP_GET_GLOBAL       2 'a'
0006    | OP_GET_GLOBAL       2 'a'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    5 OP_GET_GLOBAL       0 '@println'
0015    | OP_GET_GLOBAL       1 '@arrEqual'
0017    | OP_GET_GLOBAL       2 'a'
0019    | OP_GET_GLOBAL       3 'b'
0021    | OP_CALL             2
0023    | OP_CALL             1
0025    | OP_POP
0026    6 OP_GET_GLOBAL       0 '@println'
0028    | OP_GET_GLOBAL       1 '@arrEqual'
0030    | OP_GET_GLOBAL       2 'a'
0032    | OP_GET_GLOBAL       4 'c'
0034    | OP_CALL             2
0036    | OP_CALL             1
0038    | OP_POP
0039    | OP_NIL
0040    | OP_RETURN
