0022    4 OP_CONSTANT         4 '-1'
0024    5 OP_CONSTANT         5 '-2'
0026    6 OP_GET_GLOBAL       0 '@println'
0028    | OP_GET_LOCAL        1
0030    | OP_GET_LOCAL        2
0032    | OP_MODULO
0033    | OP_CALL             1
0035    | OP_POP
0036    7 OP_GET_GLOBAL       0 '@println'
0038    | OP_CONSTANT         2 '7'
0040    | OP_GET_LOCAL        3
0042    | OP_DIVIDE
0043    | OP_CALL             1
0045    | OP_POP
