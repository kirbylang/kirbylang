== <script> ==
0000   10 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   11 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '127'
0004    | OP_CONSTANT         2 '7'
0006    | OP_DIVIDE
0007    | OP_CALL             1
0009    | OP_POP
