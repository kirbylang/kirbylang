== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '123'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    9 OP_NIL
0009    | OP_RETURN
== main ==
0000    4 OP_CONSTANT         0 '456'
0002    5 OP_GET_GLOBAL       1 '@println'
0004    | OP_GET_LOCAL        1
0006    | OP_CALL             1
0008    | OP_POP
0009    6 OP_POP
0010    8 OP_GET_GLOBAL       1 '@println'
0012    | OP_GET_GLOBAL       2 'a'
0014    | OP_CALL             1
0016    | OP_POP
0017    | OP_NIL
0018    | OP_RETURN
