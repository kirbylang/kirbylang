== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    | OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         0 '123'
0002    3 OP_CONSTANT         1 '456'
0004    5 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_LOCAL        2
0008    | OP_CALL             1
0010    | OP_POP
0011    6 OP_NIL
0012    | OP_CLOSE_BLOCK_EXPR    2
0014    | OP_RETURN
