== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   10 OP_NIL
0005    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'nested'
0004    | OP_CALL             1
0006    | OP_POP
0007    6 OP_CONSTANT         2 '5'
0009    7 OP_CLOSE_BLOCK_EXPR    0
0011    9 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_LOCAL        1
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
