fun main(): unit {
    let xs = [10, 20, 30];

    @println(xs.len());
    @println(xs.contains(20));
    @println(xs.contains(99));

    let copy = xs.copy();
    @println(copy.len());
    @println(copy[2]);

    let reversed = xs.reverse();
    @println(reversed[0]);
    @println(reversed[2]);

    let middle = xs.slice(1, 3);
    @println(middle.len());

    let all = xs.concat([40, 50]);
    @println(all.len());

    let list = xs.toList();
    list.push(40);
    @println(list.len());
    @println(xs.len());
}
