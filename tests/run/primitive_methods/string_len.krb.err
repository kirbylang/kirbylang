== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    7 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         0 'hello'
0002    3 OP_GET_GLOBAL       1 '@println'
0004    | OP_GET_GLOBAL       2 'string.len'
0006    | OP_GET_LOCAL        1
0008    | OP_CALL             1
0010    | OP_CALL             1
0012    | OP_POP
0013    4 OP_GET_GLOBAL       1 '@println'
0015    | OP_GET_GLOBAL       2 'string.len'
0017    | OP_CONSTANT         3 ''
0019    | OP_CALL             1
0021    | OP_CALL             1
0023    | OP_POP
0024    5 OP_GET_GLOBAL       1 '@println'
0026    | OP_GET_GLOBAL       2 'string.len'
0028    | OP_CONSTANT         4 'Hello World'
0030    | OP_CALL             1
0032    | OP_CONSTANT         5 '1'
0034    | OP_ADD
0035    | OP_CALL             1
0037    | OP_POP
0038    6 OP_NIL
0039    | OP_RETURN
