== <script> ==
0000    1 OP_CLOSURE          1 <fn greeting>
0002    | OP_DEFINE_GLOBAL    0 'greeting'
0004    7 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    8 OP_NIL
0009    | OP_RETURN
== greeting ==
0000    1 OP_CONSTANT         0 'Hello'
0002    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'string.len'
0004    | OP_GET_GLOBAL       2 'greeting'
0006    | OP_CALL             0
0008    | OP_CONSTANT         3 ' World'
0010    | OP_ADD
0011    | OP_CALL             1
0013    | OP_CALL             1
0015    | OP_POP
0016    5 OP_GET_GLOBAL       0 '@println'
0018    | OP_GET_GLOBAL       4 '@strConcat'
0020    | OP_GET_GLOBAL       5 '@numberToString'
0022    | OP_GET_GLOBAL       1 'string.len'
0024    | OP_GET_GLOBAL       2 'greeting'
0026    | OP_CALL             0
0028    | OP_CALL             1
0030    | OP_CALL             1
0032    | OP_CONSTANT         6 ' letters'
0034    | OP_LIST             2
0036    | OP_CALL             1
0038    | OP_CALL             1
0040    | OP_POP
0041    6 OP_GET_GLOBAL       0 '@println'
0043    | OP_GET_GLOBAL       1 'string.len'
0045    | OP_GET_GLOBAL       2 'greeting'
0047    | OP_CALL             0
0049    | OP_CALL             1
0051    | OP_CONSTANT         7 '5'
0053    | OP_EQUAL
0054    | OP_CALL             1
0056    | OP_POP
0057    7 OP_NIL
0058    | OP_RETURN
