== <script> ==
0000    1 OP_CLOSURE          1 <fn first_length>
0002    | OP_DEFINE_GLOBAL    0 'first_length'
0004    3 OP_CLOSURE          3 <fn count>
0006    | OP_DEFINE_GLOBAL    2 'count'
0008    8 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012   10 OP_CONSTANT         7 '  ann '
0014    | OP_CONSTANT         8 ' bob'
0016    | OP_ARRAY            2
0018    | OP_DEFINE_GLOBAL    6 'NAMES'
0020   11 OP_NIL
0021    | OP_RETURN
== first_length ==
0000    1 OP_GET_GLOBAL       0 'string.len'
0002    | OP_GET_GLOBAL       1 'NAMES'
0004    | OP_CONSTANT         2 '0'
0006    | OP_GET_INDEX
0007    | OP_CALL             1
0009    | OP_RETURN
== count ==
0000    3 OP_GET_GLOBAL       0 'array.len'
0002    | OP_GET_GLOBAL       1 'NAMES'
0004    | OP_CALL             1
0006    | OP_RETURN
== main ==
0000    6 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'first_length'
0004    | OP_CALL             0
0006    | OP_CALL             1
0008    | OP_POP
0009    7 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       2 'count'
0013    | OP_CALL             0
0015    | OP_CALL             1
0017    | OP_POP
0018    8 OP_NIL
0019    | OP_RETURN
