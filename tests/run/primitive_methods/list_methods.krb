fun main(): unit {
    let xs: [i64] = [10, 20, 30];

    @println(xs.len());
    @println(xs.isEmpty());

    xs.push(40);
    @println(xs.len());
    @println(xs.pop());
    @println(xs.len());

    xs.insert(1, 15);
    @println(xs.remove(0));
    @println(xs.contains(15));
    @println(xs.contains(99));

    let copy = xs.copy();
    copy.push(1);
    @println(xs.len());
    @println(copy.len());

    @println(xs.reverse().len());
    @println(xs.slice(1, 3).len());
    @println(xs.concat(copy).len());

    xs.clear();
    @println(xs.isEmpty());
    @println(xs.len());
}
