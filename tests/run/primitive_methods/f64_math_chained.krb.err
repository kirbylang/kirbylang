== <script> ==
0000    1 OP_CLOSURE          1 <fn half>
0002    | OP_DEFINE_GLOBAL    0 'half'
0004    7 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    8 OP_NIL
0009    | OP_RETURN
== half ==
0000    1 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '2'
0004    | OP_DIVIDE
0005    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'f64.sqrt'
0004    | OP_GET_GLOBAL       2 'f64.abs'
0006    | OP_GET_GLOBAL       3 'half'
0008    | OP_CONSTANT         4 '-9'
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019    5 OP_GET_GLOBAL       0 '@println'
0021    | OP_GET_GLOBAL       5 '@strConcat'
0023    | OP_GET_GLOBAL       6 '@numberToString'
0025    | OP_GET_GLOBAL       1 'f64.sqrt'
0027    | OP_CONSTANT         7 '16'
0029    | OP_CALL             1
0031    | OP_CALL             1
0033    | OP_CONSTANT         8 ' is the root'
0035    | OP_LIST             2
0037    | OP_CALL             1
0039    | OP_CALL             1
0041    | OP_POP
0042    6 OP_GET_GLOBAL       0 '@println'
0044    | OP_GET_GLOBAL       9 'f64.min'
0046    | OP_GET_GLOBAL      10 'f64.max'
0048    | OP_GET_GLOBAL      11 'f64.pow'
0050    | OP_CONSTANT        12 '2'
0052    | OP_CONSTANT        13 '3'
0054    | OP_CALL             2
0056    | OP_CONSTANT        14 '7'
0058    | OP_CALL             2
0060    | OP_CONSTANT        15 '100'
0062    | OP_CALL             2
0064    | OP_CALL             1
0066    | OP_POP
0067    7 OP_NIL
0068    | OP_RETURN
