fun add[T: Add](a: T, b: T): T = a.add(b);
fun sub[T: Sub](a: T, b: T): T = a.sub(b);
fun mul[T: Mul](a: T, b: T): T = a.mul(b);
fun div[T: Div](a: T, b: T): T = a.div(b);
fun mod[T: Mod](a: T, b: T): T = a.mod(b);
fun neg[T: Neg](a: T): T = a.neg();
fun cmp[T: Ord](a: T, b: T): i64 = a.cmp(b);

fun main(): unit {
  let a_i8: i8 = 7;
  let b_i8: i8 = 3;
  @println(add(a_i8, b_i8) == a_i8 + b_i8);
  @println(sub(a_i8, b_i8) == a_i8 - b_i8);
  @println(mul(a_i8, b_i8) == a_i8 * b_i8);
  @println(div(a_i8, b_i8) == a_i8 / b_i8);
  @println(mod(a_i8, b_i8) == a_i8 % b_i8);
  @println(neg(a_i8) == -a_i8);
  @println(cmp(a_i8, b_i8) == a_i8.cmp(b_i8));
  let a_i16: i16 = 7;
  let b_i16: i16 = 3;
  @println(add(a_i16, b_i16) == a_i16 + b_i16);
  @println(sub(a_i16, b_i16) == a_i16 - b_i16);
  @println(mul(a_i16, b_i16) == a_i16 * b_i16);
  @println(div(a_i16, b_i16) == a_i16 / b_i16);
  @println(mod(a_i16, b_i16) == a_i16 % b_i16);
  @println(neg(a_i16) == -a_i16);
  @println(cmp(a_i16, b_i16) == a_i16.cmp(b_i16));
  let a_i32: i32 = 7;
  let b_i32: i32 = 3;
  @println(add(a_i32, b_i32) == a_i32 + b_i32);
  @println(sub(a_i32, b_i32) == a_i32 - b_i32);
  @println(mul(a_i32, b_i32) == a_i32 * b_i32);
  @println(div(a_i32, b_i32) == a_i32 / b_i32);
  @println(mod(a_i32, b_i32) == a_i32 % b_i32);
  @println(neg(a_i32) == -a_i32);
  @println(cmp(a_i32, b_i32) == a_i32.cmp(b_i32));
  let a_i64: i64 = 7;
  let b_i64: i64 = 3;
  @println(add(a_i64, b_i64) == a_i64 + b_i64);
  @println(sub(a_i64, b_i64) == a_i64 - b_i64);
  @println(mul(a_i64, b_i64) == a_i64 * b_i64);
  @println(div(a_i64, b_i64) == a_i64 / b_i64);
  @println(mod(a_i64, b_i64) == a_i64 % b_i64);
  @println(neg(a_i64) == -a_i64);
  @println(cmp(a_i64, b_i64) == a_i64.cmp(b_i64));
  let a_u8: u8 = 7;
  let b_u8: u8 = 3;
  @println(add(a_u8, b_u8) == a_u8 + b_u8);
  @println(sub(a_u8, b_u8) == a_u8 - b_u8);
  @println(mul(a_u8, b_u8) == a_u8 * b_u8);
  @println(div(a_u8, b_u8) == a_u8 / b_u8);
  @println(mod(a_u8, b_u8) == a_u8 % b_u8);
  @println(cmp(a_u8, b_u8) == a_u8.cmp(b_u8));
  let a_u16: u16 = 7;
  let b_u16: u16 = 3;
  @println(add(a_u16, b_u16) == a_u16 + b_u16);
  @println(sub(a_u16, b_u16) == a_u16 - b_u16);
  @println(mul(a_u16, b_u16) == a_u16 * b_u16);
  @println(div(a_u16, b_u16) == a_u16 / b_u16);
  @println(mod(a_u16, b_u16) == a_u16 % b_u16);
  @println(cmp(a_u16, b_u16) == a_u16.cmp(b_u16));
  let a_u32: u32 = 7;
  let b_u32: u32 = 3;
  @println(add(a_u32, b_u32) == a_u32 + b_u32);
  @println(sub(a_u32, b_u32) == a_u32 - b_u32);
  @println(mul(a_u32, b_u32) == a_u32 * b_u32);
  @println(div(a_u32, b_u32) == a_u32 / b_u32);
  @println(mod(a_u32, b_u32) == a_u32 % b_u32);
  @println(cmp(a_u32, b_u32) == a_u32.cmp(b_u32));
  let a_u64: u64 = 7;
  let b_u64: u64 = 3;
  @println(add(a_u64, b_u64) == a_u64 + b_u64);
  @println(sub(a_u64, b_u64) == a_u64 - b_u64);
  @println(mul(a_u64, b_u64) == a_u64 * b_u64);
  @println(div(a_u64, b_u64) == a_u64 / b_u64);
  @println(mod(a_u64, b_u64) == a_u64 % b_u64);
  @println(cmp(a_u64, b_u64) == a_u64.cmp(b_u64));
  let a_f32: f32 = 7.5f32;
  let b_f32: f32 = 2.5f32;
  @println(add(a_f32, b_f32) == a_f32 + b_f32);
  @println(sub(a_f32, b_f32) == a_f32 - b_f32);
  @println(mul(a_f32, b_f32) == a_f32 * b_f32);
  @println(div(a_f32, b_f32) == a_f32 / b_f32);
  @println(mod(a_f32, b_f32) == a_f32 % b_f32);
  @println(neg(a_f32) == -a_f32);
  @println(cmp(a_f32, b_f32) == a_f32.cmp(b_f32));
  let a_f64: f64 = 7.5;
  let b_f64: f64 = 2.5;
  @println(add(a_f64, b_f64) == a_f64 + b_f64);
  @println(sub(a_f64, b_f64) == a_f64 - b_f64);
  @println(mul(a_f64, b_f64) == a_f64 * b_f64);
  @println(div(a_f64, b_f64) == a_f64 / b_f64);
  @println(mod(a_f64, b_f64) == a_f64 % b_f64);
  @println(neg(a_f64) == -a_f64);
  @println(cmp(a_f64, b_f64) == a_f64.cmp(b_f64));
}
