== <script> ==
0000    3 OP_CLOSURE          1 <fn count>
0002    | OP_DEFINE_GLOBAL    0 'count'
0004    7 OP_CLOSURE          3 <fn flipped>
0006    | OP_DEFINE_GLOBAL    2 'flipped'
0008   13 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012   14 OP_NIL
0013    | OP_RETURN
== count ==
0000    2 OP_GET_GLOBAL       0 'array.len'
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
== flipped ==
0000    6 OP_GET_GLOBAL       0 'array.reverse'
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_CONSTANT         1 '0'
0008    | OP_GET_INDEX
0009    | OP_RETURN
== main ==
0000   10 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'count'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '2'
0008    | OP_CONSTANT         4 '3'
0010    | OP_ARRAY            3
0012    | OP_CALL             1
0014    | OP_CALL             1
0016    | OP_POP
0017   11 OP_GET_GLOBAL       0 '@println'
0019    | OP_GET_GLOBAL       1 'count'
0021    | OP_CONSTANT         5 'a'
0023    | OP_CONSTANT         6 'b'
0025    | OP_CONSTANT         7 'c'
0027    | OP_ARRAY            3
0029    | OP_CALL             1
0031    | OP_CALL             1
0033    | OP_POP
0034   12 OP_GET_GLOBAL       0 '@println'
0036    | OP_GET_GLOBAL       8 'flipped'
0038    | OP_CONSTANT         9 '1.5'
0040    | OP_CONSTANT        10 '2.5'
0042    | OP_ARRAY            2
0044    | OP_CALL             1
0046    | OP_CALL             1
0048    | OP_POP
0049   13 OP_NIL
0050    | OP_RETURN
