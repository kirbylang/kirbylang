== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    6 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 'i32.Default.default'
0002    | OP_CALL             0
0004    3 OP_GET_GLOBAL       1 '@println'
0006    | OP_GET_LOCAL        1
0008    | OP_CALL             1
0010    | OP_POP
0011    4 OP_GET_GLOBAL       1 '@println'
0013    | OP_GET_GLOBAL       0 'i32.Default.default'
0015    | OP_CALL             0
0017    | OP_GET_LOCAL        1
0019    | OP_EQUAL
0020    | OP_CALL             1
0022    | OP_POP
0023    5 OP_NIL
0024    | OP_RETURN
