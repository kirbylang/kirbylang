// A method used as a value keeps the value it was taken from
fun apply(f: fun (i64) => i64, n: i64): i64 = f(n);

struct Holder {
    pub var call: fun () => i64;
}

trait Describe {
    fun describe(self, prefix: string): string;
    fun kind(): string;
}

impl Describe for i64 {
    fun describe(self, prefix: string): string = prefix + self.toString();
    fun kind(): string = "i64";
}

fun counted(text: string): string {
    @println("taken from " + text);
    return text;
}

fun adder(n: i64): fun (i64) => i64 = n.add;

fun main(): unit {
    var text = "ab";
    let len = text.len;
    text = "abcd";
    @println(len());
    @println(len);
    @println(@typeof(len));

    // The receiver is worked out once, when the method is taken
    let again = counted("xyz").len;
    @println(again() + again());

    let seven: i64 = 7;
    @println(apply(seven.max, 3));
    @println(apply(adder(10), 5));

    let holder = Holder { call: "hello".len };
    @println(holder.call());

    let describe = seven.describe;
    @println(describe("number "));

    let kind = i64.kind;
    @println(kind());

    let zero = f64.default;
    @println(zero());

    var items: [i64] = [1, 2];
    let push = items.push;
    push(3);
    @println(items.len());
    @println(items[2]);

    let array: [i64; 2] = [8, 9];
    let toList = array.toList;
    @println(toList()[1]);
    let concat = array.concat;
    @println(concat([10]).len());
}
