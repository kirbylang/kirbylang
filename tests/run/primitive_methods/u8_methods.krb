fun main(): unit {
    let lo: u8 = 0;
    let hi: u8 = 255;
    let mid: u8 = 7;

    @println(lo.max(hi));
    @println(lo.min(hi));
    @println(hi.max(hi));
    @println(mid.max(3));
    @println(mid.min(3));
    @println(mid.max(hi).min(100));
    @println($"{mid.max(hi).min(100)} is the cap");
}
