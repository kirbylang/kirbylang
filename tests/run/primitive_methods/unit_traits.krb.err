== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    8 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_NIL
0001    3 OP_GET_GLOBAL       0 '@println'
0003    | OP_GET_GLOBAL       1 'unit.Display.toString'
0005    | OP_GET_LOCAL        1
0007    | OP_CALL             1
0009    | OP_CALL             1
0011    | OP_POP
0012    4 OP_GET_GLOBAL       0 '@println'
0014    | OP_GET_GLOBAL       2 'unit.Eq.equals'
0016    | OP_GET_LOCAL        1
0018    | OP_NIL
