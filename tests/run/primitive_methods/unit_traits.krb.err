0021    | OP_CALL             1
0023    | OP_POP
0024    5 OP_GET_GLOBAL       0 '@println'
0026    | OP_GET_GLOBAL       3 'unit.Ord.cmp'
0028    | OP_GET_LOCAL        1
0030    | OP_NIL
0031    | OP_CALL             2
0033    | OP_CALL             1
0035    | OP_POP
0036    6 OP_GET_GLOBAL       0 '@println'
0038    | OP_GET_GLOBAL       4 'unit.Default.default'
