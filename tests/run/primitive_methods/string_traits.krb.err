== <script> ==
0000    7 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    8 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         0 'abc'
0002    3 OP_GET_GLOBAL       1 '@println'
0004    | OP_GET_GLOBAL       2 'string.Display.toString'
0006    | OP_GET_LOCAL        1
0008    | OP_CALL             1
0010    | OP_CALL             1
0012    | OP_POP
0013    4 OP_GET_GLOBAL       1 '@println'
0015    | OP_GET_GLOBAL       3 'string.Eq.equals'
0017    | OP_GET_LOCAL        1
0019    | OP_CONSTANT         0 'abc'
0021    | OP_CALL             2
0023    | OP_CALL             1
0025    | OP_POP
0026    5 OP_GET_GLOBAL       1 '@println'
0028    | OP_GET_GLOBAL       3 'string.Eq.equals'
0030    | OP_GET_LOCAL        1
0032    | OP_CONSTANT         4 'abd'
0034    | OP_CALL             2
0036    | OP_CALL             1
0038    | OP_POP
0039    6 OP_GET_GLOBAL       1 '@println'
0041    | OP_GET_GLOBAL       5 'string.Add.add'
0043    | OP_GET_LOCAL        1
0045    | OP_CONSTANT         6 'def'
0047    | OP_CALL             2
0049    | OP_CALL             1
0051    | OP_POP
0052    7 OP_NIL
0053    | OP_RETURN
