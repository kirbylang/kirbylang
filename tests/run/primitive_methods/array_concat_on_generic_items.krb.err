== <script> ==
0000    1 OP_CLOSURE          1 <fn join>
0002    | OP_DEFINE_GLOBAL    0 'join'
0004    6 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008    7 OP_NIL
0009    | OP_RETURN
== join ==
0000    1 OP_GET_GLOBAL       0 'array.concat'
0002    | OP_GET_LOCAL        1
0004    | OP_GET_LOCAL        2
0006    | OP_CALL             2
0008    | OP_RETURN
== main ==
0000    4 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'join'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CONSTANT         3 '2'
0008    | OP_ARRAY            2
0010    | OP_CONSTANT         4 '3'
0012    | OP_CONSTANT         5 '4'
0014    | OP_ARRAY            2
0016    | OP_CALL             2
0018    | OP_CALL             1
0020    | OP_POP
0021    5 OP_GET_GLOBAL       0 '@println'
0023    | OP_GET_GLOBAL       1 'join'
0025    | OP_CONSTANT         6 'a'
0027    | OP_CONSTANT         7 'b'
0029    | OP_ARRAY            2
0031    | OP_CONSTANT         8 'c'
0033    | OP_CONSTANT         9 'd'
0035    | OP_ARRAY            2
0037    | OP_CALL             2
0039    | OP_CALL             1
0041    | OP_POP
0042    6 OP_NIL
0043    | OP_RETURN
