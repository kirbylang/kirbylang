== <script> ==
0000    4 OP_CLOSURE          1 <fn f>
0002    | OP_DEFINE_GLOBAL    0 'f'
0004    9 OP_CLOSURE          3 <fn g>
0006    | OP_DEFINE_GLOBAL    2 'g'
0008   11 OP_GET_GLOBAL       4 '@println'
0010    | OP_GET_GLOBAL       0 'f'
0012    | OP_CALL             0
0014    | OP_CALL             1
0016    | OP_POP
0017   12 OP_GET_GLOBAL       4 '@println'
0019    | OP_GET_GLOBAL       2 'g'
0021    | OP_TRUE
0022    | OP_CALL             1
0024    | OP_CALL             1
0026    | OP_POP
0027   13 OP_GET_GLOBAL       4 '@println'
0029    | OP_GET_GLOBAL       2 'g'
0031    | OP_FALSE
0032    | OP_CALL             1
0034    | OP_CALL             1
0036    | OP_POP
0037   14 OP_NIL
0038    | OP_RETURN
== f ==
0000    2 OP_CONSTANT         0 '5'
0002    | OP_POP
0003    3 OP_CONSTANT         1 '10'
0005    | OP_RETURN
== g ==
0000    7 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 12
0005    | OP_POP
0006    | OP_CONSTANT         0 '1'
0008    | OP_POP
0009    | OP_JUMP             9 -> 16
0012    | OP_POP
0013    | OP_CONSTANT         1 '2'
0015    | OP_POP
0016    8 OP_CONSTANT         2 '3'
0018    | OP_RETURN
