== <script> ==
0000    4 OP_CLOSURE          1 <fn f>
0002    | OP_DEFINE_GLOBAL    0 'f'
0004    9 OP_CLOSURE          3 <fn g>
0006    | OP_DEFINE_GLOBAL    2 'g'
0008   13 OP_CLOSURE          5 <fn main>
0010    | OP_DEFINE_GLOBAL    4 'main'
0012   14 OP_NIL
0013    | OP_RETURN
== f ==
0000    2 OP_CONSTANT         0 '5'
0002    | OP_POP
0003    3 OP_CONSTANT         1 '10'
0005    | OP_RETURN
== g ==
0000    7 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 12
0005    | OP_POP
0006    | OP_CONSTANT         0 '1'
0008    | OP_POP
0009    | OP_JUMP             9 -> 16
0012    | OP_POP
0013    | OP_CONSTANT         1 '2'
0015    | OP_POP
0016    8 OP_CONSTANT         2 '3'
0018    | OP_RETURN
== main ==
0000   11 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'f'
0004    | OP_CALL             0
0006    | OP_CALL             1
0008    | OP_POP
0009   12 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       2 'g'
0013    | OP_TRUE
0014    | OP_CALL             1
0016    | OP_CALL             1
0018    | OP_POP
0019   13 OP_GET_GLOBAL       0 '@println'
0021    | OP_GET_GLOBAL       2 'g'
0023    | OP_FALSE
0024    | OP_CALL             1
0026    | OP_CALL             1
0028    | OP_POP
0029    | OP_NIL
0030    | OP_RETURN
