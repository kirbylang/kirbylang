== <script> ==
0000   10 OP_CLOSURE          1 <fn process>
0002    | OP_DEFINE_GLOBAL    0 'process'
0004   12 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008   13 OP_NIL
0009    | OP_RETURN
== process ==
0000    3 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        2
0004    | OP_ADD
0005    4 OP_GET_LOCAL        3
0007    | OP_CONSTANT         0 '0.5'
0009    | OP_MULTIPLY
0010    6 OP_GET_LOCAL        4
0012    7 OP_CLOSE_BLOCK_EXPR    2
0014    9 OP_GET_LOCAL        3
0016   10 OP_CLOSE_BLOCK_EXPR    1
0018    | OP_RETURN
== main ==
0000   12 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'process'
0004    | OP_CONSTANT         2 '5'
0006    | OP_CONSTANT         3 '20'
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_POP
0013    | OP_NIL
0014    | OP_RETURN
