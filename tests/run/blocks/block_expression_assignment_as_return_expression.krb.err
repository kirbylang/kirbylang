== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '1'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    6 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    4 OP_CONSTANT         2 '42'
0004    | OP_SET_GLOBAL       1 'a'
0006    5 OP_CLOSE_BLOCK_EXPR    0
0008    | OP_CALL             1
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
