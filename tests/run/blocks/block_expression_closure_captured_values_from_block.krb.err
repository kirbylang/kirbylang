== <script> ==
0000    2 OP_CONSTANT         1 'hello'
0002    4 OP_CLOSURE          2 <fn inner>
0004      |                     local 1
0006    6 OP_GET_LOCAL        2
0008    7 OP_CLOSE_BLOCK_EXPR    2
0010    | OP_DEFINE_GLOBAL    0 'closure'
0012    9 OP_GET_GLOBAL       3 '@println'
0014    | OP_GET_GLOBAL       0 'closure'
0016    | OP_CALL             0
0018    | OP_CALL             1
0020    | OP_POP
0021   10 OP_NIL
0022    | OP_RETURN
== inner ==
0000    4 OP_GET_UPVALUE      0
0002    | OP_RETURN
