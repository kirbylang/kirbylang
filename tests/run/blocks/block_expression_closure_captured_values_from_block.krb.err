== <script> ==
0000    9 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   10 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_CONSTANT         0 'hello'
0002    4 OP_CLOSURE          1 <fn inner>
0004      |                     local 1
0006    6 OP_GET_LOCAL        2
0008    7 OP_CLOSE_BLOCK_EXPR    2
0010    9 OP_GET_GLOBAL       2 '@println'
0012    | OP_GET_LOCAL        1
0014    | OP_CALL             0
0016    | OP_CALL             1
0018    | OP_POP
0019    | OP_NIL
0020    | OP_RETURN
== inner ==
0000    4 OP_GET_UPVALUE      0
0002    | OP_RETURN
