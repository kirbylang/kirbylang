== <script> ==
0000    1 OP_CONSTANT         1 'global'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    3 OP_GET_GLOBAL       2 '@println'
0006    4 OP_CONSTANT         3 'local'
0008    5 OP_GET_LOCAL        2
0010    6 OP_CLOSE_BLOCK_EXPR    1
0012    | OP_CALL             1
0014    | OP_POP
0015    8 OP_GET_GLOBAL       2 '@println'
0017    | OP_GET_GLOBAL       0 'a'
0019    | OP_CALL             1
0021    | OP_POP
0022    9 OP_NIL
0023    | OP_RETURN
