== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 'global'
0006    | OP_DEFINE_GLOBAL    2 'a'
0008    9 OP_NIL
0009    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 '@println'
0002    4 OP_CONSTANT         1 'local'
0004    5 OP_GET_LOCAL        2
0006    6 OP_CLOSE_BLOCK_EXPR    1
0008    | OP_CALL             1
0010    | OP_POP
0011    8 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       2 'a'
0015    | OP_CALL             1
0017    | OP_POP
0018    | OP_NIL
0019    | OP_RETURN
