== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    9 OP_CLOSURE          1 <fn sumBelow>
0002    | OP_DEFINE_GLOBAL    0 'sumBelow'
0004   11 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'sumBelow'
0008    | OP_CONSTANT         3 '5'
0010    | OP_CALL             1
0012    | OP_CALL             1
0014    | OP_POP
0015   12 OP_NIL
0016    | OP_RETURN
== sumBelow ==
0000    2 OP_CONSTANT         0 '0'
0002    3 OP_CONSTANT         0 '0'
0004    4 OP_GET_LOCAL        3
0006    | OP_GET_LOCAL        1
0008    | OP_LESS
0009    | OP_JUMP_IF_FALSE    9 -> 32
0012    | OP_POP
0013    5 OP_GET_LOCAL        2
0015    | OP_GET_LOCAL        3
0017    | OP_ADD
0018    | OP_SET_LOCAL        2
0020    | OP_POP
0021    6 OP_GET_LOCAL        3
0023    | OP_CONSTANT         1 '1'
0025    | OP_ADD
0026    | OP_SET_LOCAL        3
0028    | OP_POP
0029    7 OP_LOOP            29 -> 4
0032    | OP_POP
0033    8 OP_GET_LOCAL        2
0035    | OP_RETURN
