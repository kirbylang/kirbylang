== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    9 OP_CLOSURE          3 <fn test>
0006    | OP_DEFINE_GLOBAL    2 'test'
0008   10 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'test'
0004    | OP_TRUE
0005    | OP_FALSE
0006    | OP_CALL             2
0008    | OP_CALL             1
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 'test'
0015    | OP_FALSE
0016    | OP_TRUE
0017    | OP_CALL             2
0019    | OP_CALL             1
0021    | OP_POP
0022    3 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 'test'
0026    | OP_FALSE
0027    | OP_FALSE
0028    | OP_CALL             2
0030    | OP_CALL             1
0032    | OP_POP
0033    | OP_NIL
0034    | OP_RETURN
== test ==
0000    9 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    | OP_CONSTANT         0 'Hello'
0008    | OP_JUMP             8 -> 26
0011    | OP_POP
0012    | OP_GET_LOCAL        2
0014    | OP_JUMP_IF_FALSE   14 -> 23
0017    | OP_POP
0018    | OP_CONSTANT         1 'World'
0020    | OP_JUMP            20 -> 26
0023    | OP_POP
0024    | OP_CONSTANT         2 'Hello World!'
0026    | OP_RETURN
