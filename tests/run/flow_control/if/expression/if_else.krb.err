== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    8 OP_CLOSURE          3 <fn test>
0006    | OP_DEFINE_GLOBAL    2 'test'
0008    9 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'test'
0004    | OP_TRUE
0005    | OP_CALL             1
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       0 '@println'
0012    | OP_GET_GLOBAL       1 'test'
0014    | OP_FALSE
0015    | OP_CALL             1
0017    | OP_CALL             1
0019    | OP_POP
0020    | OP_NIL
0021    | OP_RETURN
== test ==
0000    8 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 13
0005    | OP_POP
0006    | OP_CONSTANT         0 'Hello'
0008    | OP_CLOSE_BLOCK_EXPR    0
0010    | OP_JUMP            10 -> 16
0013    | OP_POP
0014    | OP_CONSTANT         1 'World'
0016    | OP_RETURN
