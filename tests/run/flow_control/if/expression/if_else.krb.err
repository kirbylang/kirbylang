== <script> ==
0000    5 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'test'
0008    | OP_TRUE
0009    | OP_CALL             1
0011    | OP_CALL             1
0013    | OP_POP
0014    2 OP_GET_GLOBAL       2 '@println'
0016    | OP_GET_GLOBAL       0 'test'
0018    | OP_FALSE
0019    | OP_CALL             1
0021    | OP_CALL             1
0023    | OP_POP
0024    6 OP_NIL
0025    | OP_RETURN
== test ==
0000    5 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 13
0005    | OP_POP
0006    | OP_CONSTANT         0 'Hello'
0008    | OP_CLOSE_BLOCK_EXPR    0
0010    | OP_JUMP            10 -> 16
0013    | OP_POP
0014    | OP_CONSTANT         1 'World'
0016    | OP_RETURN
