== <script> ==
0000    5 OP_CLOSURE          1 <fn classify>
0002    | OP_DEFINE_GLOBAL    0 'classify'
0004    9 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008   10 OP_NIL
0009    | OP_RETURN
== classify ==
0000    2 OP_GET_LOCAL        1
0002    | OP_CONSTANT         0 '10'
0004    | OP_LESS
0005    | OP_JUMP_IF_FALSE    5 -> 31
0008    | OP_POP
0009    3 OP_GET_LOCAL        1
0011    | OP_CONSTANT         1 '5'
0013    | OP_LESS
0014    | OP_JUMP_IF_FALSE   14 -> 23
0017    | OP_POP
0018    | OP_CONSTANT         2 'small'
0020    | OP_JUMP            20 -> 26
0023    | OP_POP
0024    | OP_CONSTANT         3 'medium'
0026    4 OP_CLOSE_BLOCK_EXPR    0
0028    | OP_JUMP            28 -> 34
0031    | OP_POP
0032    | OP_CONSTANT         4 'large'
0034    | OP_RETURN
== main ==
0000    7 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 'classify'
0004    | OP_CONSTANT         2 '1'
0006    | OP_CALL             1
0008    | OP_CALL             1
0010    | OP_POP
0011    8 OP_GET_GLOBAL       0 '@println'
0013    | OP_GET_GLOBAL       1 'classify'
0015    | OP_CONSTANT         3 '7'
0017    | OP_CALL             1
0019    | OP_CALL             1
0021    | OP_POP
0022    9 OP_GET_GLOBAL       0 '@println'
0024    | OP_GET_GLOBAL       1 'classify'
0026    | OP_CONSTANT         4 '20'
0028    | OP_CALL             1
0030    | OP_CALL             1
0032    | OP_POP
0033    | OP_NIL
0034    | OP_RETURN
