== <script> ==
0000   12 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       0 'test'
0006    | OP_TRUE
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       0 'test'
0012    | OP_FALSE
0013    | OP_CALL             1
0015    | OP_POP
0016   13 OP_NIL
0017    | OP_RETURN
== test ==
0000    6 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'before'
0004    | OP_CALL             1
0006    | OP_POP
0007    8 OP_GET_LOCAL        1
0009    | OP_JUMP_IF_FALSE    9 -> 18
0012    | OP_POP
0013    | OP_CONSTANT         2 'Hello'
0015    | OP_JUMP            15 -> 21
0018    | OP_POP
0019    | OP_CONSTANT         3 'World'
0021    9 OP_CLOSE_BLOCK_EXPR    0
0023   11 OP_GET_GLOBAL       0 '@println'
0025    | OP_GET_LOCAL        2
0027    | OP_CALL             1
0029    | OP_POP
0030   12 OP_NIL
0031    | OP_CLOSE_BLOCK_EXPR    1
0033    | OP_RETURN
