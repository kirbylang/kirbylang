== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   22 OP_CLOSURE          3 <fn test>
0006    | OP_DEFINE_GLOBAL    2 'test'
0008   23 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 'test'
0002    | OP_TRUE
0003    | OP_CALL             1
0005    | OP_POP
0006    2 OP_GET_GLOBAL       0 'test'
0008    | OP_FALSE
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== test ==
0000   16 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'before'
0004    | OP_CALL             1
0006    | OP_POP
0007   18 OP_GET_LOCAL        1
0009    | OP_JUMP_IF_FALSE    9 -> 18
0012    | OP_POP
0013    | OP_CONSTANT         2 'Hello'
0015    | OP_JUMP            15 -> 21
0018    | OP_POP
0019    | OP_CONSTANT         3 'World'
0021   19 OP_CLOSE_BLOCK_EXPR    0
0023   21 OP_GET_GLOBAL       0 '@println'
0025    | OP_GET_LOCAL        2
0027    | OP_CALL             1
0029    | OP_POP
0030   22 OP_NIL
0031    | OP_CLOSE_BLOCK_EXPR    1
0033    | OP_RETURN
