== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    2 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 15
0004    | OP_POP
0005    3 OP_GET_GLOBAL       1 '@println'
0007    | OP_CONSTANT         2 'hi'
0009    | OP_CALL             1
0011    | OP_POP
0012    4 OP_JUMP            12 -> 16
0015    | OP_POP
0016    6 OP_CONSTANT         3 '5'
0018    7 OP_CLOSE_BLOCK_EXPR    0
0020    | OP_DEFINE_GLOBAL    0 'x'
0022    8 OP_GET_GLOBAL       1 '@println'
0024    | OP_GET_GLOBAL       0 'x'
0026    | OP_CALL             1
0028    | OP_POP
0029    9 OP_NIL
0030    | OP_RETURN
