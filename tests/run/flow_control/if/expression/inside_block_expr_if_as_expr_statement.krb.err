== <script> ==
0000    8 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    9 OP_NIL
0005    | OP_RETURN
== main ==
0000    2 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 15
0004    | OP_POP
0005    3 OP_GET_GLOBAL       0 '@println'
0007    | OP_CONSTANT         1 'hi'
0009    | OP_CALL             1
0011    | OP_POP
0012    4 OP_JUMP            12 -> 16
0015    | OP_POP
0016    6 OP_CONSTANT         2 '5'
0018    7 OP_CLOSE_BLOCK_EXPR    0
0020    8 OP_GET_GLOBAL       0 '@println'
0022    | OP_GET_LOCAL        1
0024    | OP_CALL             1
0026    | OP_POP
0027    | OP_NIL
0028    | OP_RETURN
