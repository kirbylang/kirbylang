== <script> ==
0000    3 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   22 OP_CLOSURE          3 <fn test>
0006    | OP_DEFINE_GLOBAL    2 'test'
0008   23 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 'test'
0002    | OP_TRUE
0003    | OP_FALSE
0004    | OP_CALL             2
0006    | OP_POP
0007    2 OP_GET_GLOBAL       0 'test'
0009    | OP_FALSE
0010    | OP_TRUE
0011    | OP_CALL             2
0013    | OP_POP
0014    3 OP_GET_GLOBAL       0 'test'
0016    | OP_FALSE
0017    | OP_FALSE
0018    | OP_CALL             2
0020    | OP_POP
0021    | OP_NIL
0022    | OP_RETURN
== test ==
0000   15 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 19
0005    | OP_POP
0006   16 OP_GET_GLOBAL       0 '@println'
0008    | OP_CONSTANT         1 'Hello'
0010    | OP_CALL             1
0012    | OP_POP
0013   17 OP_NIL
0014    | OP_CLOSE_BLOCK_EXPR    0
0016    | OP_JUMP            16 -> 50
0019    | OP_POP
0020    | OP_GET_LOCAL        2
0022    | OP_JUMP_IF_FALSE   22 -> 39
0025    | OP_POP
0026   18 OP_GET_GLOBAL       0 '@println'
0028    | OP_CONSTANT         2 'World'
0030    | OP_CALL             1
0032    | OP_POP
0033   19 OP_NIL
0034    | OP_CLOSE_BLOCK_EXPR    0
0036    | OP_JUMP            36 -> 50
0039    | OP_POP
0040   20 OP_GET_GLOBAL       0 '@println'
0042    | OP_CONSTANT         3 'Goodbye'
0044    | OP_CALL             1
0046    | OP_POP
0047   21 OP_NIL
0048    | OP_CLOSE_BLOCK_EXPR    0
0050    | OP_RETURN
