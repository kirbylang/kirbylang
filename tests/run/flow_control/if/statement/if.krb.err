== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   18 OP_CLOSURE          3 <fn test>
0006    | OP_DEFINE_GLOBAL    2 'test'
0008   19 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 'test'
0002    | OP_TRUE
0003    | OP_CALL             1
0005    | OP_POP
0006    2 OP_GET_GLOBAL       0 'test'
0008    | OP_FALSE
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== test ==
0000   13 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 16
0005    | OP_POP
0006   14 OP_GET_GLOBAL       0 '@println'
0008    | OP_CONSTANT         1 'Hello'
0010    | OP_CALL             1
0012    | OP_POP
0013   15 OP_JUMP            13 -> 17
0016    | OP_POP
0017   17 OP_GET_GLOBAL       0 '@println'
0019    | OP_CONSTANT         2 'World'
0021    | OP_CALL             1
0023    | OP_POP
0024   18 OP_NIL
0025    | OP_RETURN
