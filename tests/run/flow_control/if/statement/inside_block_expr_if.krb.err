== <script> ==
0000    2 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004   27 OP_CLOSURE          3 <fn test>
0006    | OP_DEFINE_GLOBAL    2 'test'
0008   28 OP_NIL
0009    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 'test'
0002    | OP_TRUE
0003    | OP_CALL             1
0005    | OP_POP
0006    2 OP_GET_GLOBAL       0 'test'
0008    | OP_FALSE
0009    | OP_CALL             1
0011    | OP_POP
0012    | OP_NIL
0013    | OP_RETURN
== test ==
0000   19 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 15
0004    | OP_POP
0005   20 OP_GET_GLOBAL       0 '@println'
0007    | OP_CONSTANT         1 'Hello'
0009    | OP_CALL             1
0011    | OP_POP
0012   21 OP_JUMP            12 -> 16
0015    | OP_POP
0016   23 OP_CONSTANT         2 'World'
0018   24 OP_CLOSE_BLOCK_EXPR    0
0020   26 OP_GET_GLOBAL       0 '@println'
0022    | OP_GET_LOCAL        2
0024    | OP_CALL             1
0026    | OP_POP
0027   27 OP_NIL
0028    | OP_RETURN
