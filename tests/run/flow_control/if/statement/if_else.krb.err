== <script> ==
0000   10 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       0 'test'
0006    | OP_TRUE
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       0 'test'
0012    | OP_FALSE
0013    | OP_CALL             1
0015    | OP_POP
0016   11 OP_NIL
0017    | OP_RETURN
== test ==
0000    5 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 19
0005    | OP_POP
0006    6 OP_GET_GLOBAL       0 '@println'
0008    | OP_CONSTANT         1 'Hello'
0010    | OP_CALL             1
0012    | OP_POP
0013    7 OP_NIL
0014    | OP_CLOSE_BLOCK_EXPR    0
0016    | OP_JUMP            16 -> 30
0019    | OP_POP
0020    8 OP_GET_GLOBAL       0 '@println'
0022    | OP_CONSTANT         2 'World'
0024    | OP_CALL             1
0026    | OP_POP
0027    9 OP_NIL
0028    | OP_CLOSE_BLOCK_EXPR    0
0030    | OP_RETURN
