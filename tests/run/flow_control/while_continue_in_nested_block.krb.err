== <script> ==
0000   11 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_CONSTANT         3 '0'
0006    | OP_DEFINE_GLOBAL    2 'i'
0008   12 OP_NIL
0009    | OP_RETURN
== main ==
0000    2 OP_GET_GLOBAL       0 'i'
0002    | OP_CONSTANT         1 '4'
0004    | OP_LESS
0005    | OP_JUMP_IF_FALSE    5 -> 53
0008    | OP_POP
0009    3 OP_GET_GLOBAL       0 'i'
0011    | OP_CONSTANT         2 '1'
0013    | OP_ADD
0014    | OP_SET_GLOBAL       0 'i'
0016    | OP_POP
0017    6 OP_GET_GLOBAL       0 'i'
0019    | OP_CONSTANT         3 '100'
0021    | OP_MULTIPLY
0022    7 OP_GET_GLOBAL       0 'i'
0024    | OP_CONSTANT         4 '2'
0026    | OP_EQUAL
0027    | OP_JUMP_IF_FALSE   27 -> 38
0030    | OP_POP
0031    | OP_POP
0032    | OP_LOOP            32 -> 0
0035    | OP_JUMP            35 -> 39
0038    | OP_POP
0039    8 OP_GET_GLOBAL       5 '@println'
0041    | OP_GET_LOCAL        1
0043    | OP_CALL             1
0045    | OP_POP
0046    9 OP_NIL
0047    | OP_CLOSE_BLOCK_EXPR    1
0049    | OP_POP
0050   10 OP_LOOP            50 -> 0
0053    | OP_POP
0054   11 OP_GET_GLOBAL       5 '@println'
0056    | OP_CONSTANT         6 'done'
0058    | OP_CALL             1
0060    | OP_POP
0061    | OP_NIL
0062    | OP_RETURN
