0031    | OP_JUMP_IF_FALSE   31 -> 42
0034    | OP_POP
0035    | OP_POP
0036    | OP_LOOP            36 -> 4
0039    | OP_JUMP            39 -> 43
0042    | OP_POP
0043    8 OP_GET_GLOBAL       6 '@println'
