== <script> ==
0000    6 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    1 OP_TRUE
0005    | OP_DEFINE_GLOBAL    2 'cond'
0007    7 OP_NIL
0008    | OP_RETURN
== main ==
0000    3 OP_GET_GLOBAL       0 'cond'
0002    | OP_JUMP_IF_FALSE    2 -> 22
0005    | OP_POP
0006    4 OP_GET_GLOBAL       0 'cond'
0008    | OP_NOT
0009    | OP_SET_GLOBAL       0 'cond'
0011    | OP_POP
0012    5 OP_GET_GLOBAL       1 '@println'
0014    | OP_CONSTANT         2 'Hello World'
0016    | OP_CALL             1
0018    | OP_POP
0019    6 OP_LOOP            19 -> 0
0022    | OP_POP
0023    | OP_NIL
0024    | OP_RETURN
