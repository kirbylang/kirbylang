== <script> ==
0000    1 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 18
0004    | OP_POP
0005    2 OP_GET_GLOBAL       0 '@println'
0007    | OP_CONSTANT         1 'done'
0009    | OP_CALL             1
0011    | OP_POP
0012    3 OP_JUMP            12 -> 19
0015    4 OP_LOOP            15 -> 0
0018    | OP_POP
0019    5 OP_NIL
0020    | OP_RETURN
