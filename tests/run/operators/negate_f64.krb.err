== <script> ==
0000    5 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    6 OP_NIL
0005    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 '2.5'
0004    | OP_NEGATE
0005    | OP_CALL             1
0007    | OP_POP
0008    2 OP_GET_GLOBAL       0 '@println'
0010    | OP_CONSTANT         2 '1'
0012    | OP_CONSTANT         3 '2'
0014    | OP_ADD
0015    | OP_NEGATE
0016    | OP_CALL             1
0018    | OP_POP
0019    4 OP_CONSTANT         4 '-3'
0021    5 OP_GET_GLOBAL       0 '@println'
0023    | OP_GET_LOCAL        1
0025    | OP_NEGATE
0026    | OP_CALL             1
0028    | OP_POP
0029    | OP_NIL
0030    | OP_RETURN
