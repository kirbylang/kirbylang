0028    | OP_GET_GLOBAL       2 '@strConcat'
0030    | OP_CONSTANT         3 'FAIL '
0032    | OP_GET_LOCAL        1
0034    | OP_CONSTANT         4 ': expected '
0036    | OP_GET_GLOBAL       5 '@numberToString'
