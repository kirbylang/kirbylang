0056    | OP_CONSTANT        11 '2.5'
0058    | OP_DIVIDE
0059    | OP_CONSTANT         3 '0'
0061    | OP_CALL             3
0063    | OP_POP
0064   14 OP_GET_GLOBAL       0 'check'
0066    | OP_CONSTANT        12 'ordinary division still works'
0068    | OP_CONSTANT        13 '10'
0070    | OP_CONSTANT        14 '4'
0072    | OP_DIVIDE
0073    | OP_CONSTANT        11 '2.5'
0075    | OP_CALL             3
0077    | OP_POP
0078   15 OP_NIL
0079    | OP_RETURN
== check ==
0000    2 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        3
0004    | OP_EQUAL
0005    | OP_JUMP_IF_FALSE    5 -> 25
0008    | OP_POP
0009    3 OP_GET_GLOBAL       0 '@println'
0011    | OP_CONSTANT         1 'PASS '
