== <script> ==
0000    8 OP_CLOSURE          1 <fn check>
0002    | OP_DEFINE_GLOBAL    0 'check'
0004   14 OP_CLOSURE          3 <fn main>
0006    | OP_DEFINE_GLOBAL    2 'main'
0008   15 OP_NIL
0009    | OP_RETURN
== check ==
0000    2 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        3
0004    | OP_EQUAL
0005    | OP_JUMP_IF_FALSE    5 -> 25
0008    | OP_POP
0009    3 OP_GET_GLOBAL       0 '@println'
0011    | OP_CONSTANT         1 'PASS '
0013    | OP_GET_LOCAL        1
0015    | OP_ADD
0016    | OP_CALL             1
0018    | OP_POP
0019    4 OP_NIL
0020    | OP_CLOSE_BLOCK_EXPR    0
0022    | OP_JUMP            22 -> 60
0025    | OP_POP
0026    5 OP_GET_GLOBAL       0 '@println'
0028    | OP_GET_GLOBAL       2 '@strConcat'
0030    | OP_CONSTANT         3 'FAIL '
0032    | OP_GET_LOCAL        1
0034    | OP_CONSTANT         4 ': expected '
0036    | OP_GET_GLOBAL       5 '@numberToString'
0038    | OP_GET_LOCAL        3
0040    | OP_CALL             1
0042    6 OP_CONSTANT         6 ' got '
0044    | OP_GET_GLOBAL       5 '@numberToString'
0046    | OP_GET_LOCAL        2
0048    | OP_CALL             1
0050    | OP_LIST             6
0052    | OP_CALL             1
0054    | OP_CALL             1
0056    | OP_POP
0057    7 OP_NIL
0058    | OP_CLOSE_BLOCK_EXPR    0
0060    | OP_RETURN
== main ==
0000   10 OP_GET_GLOBAL       0 'check'
0002    | OP_CONSTANT         1 'zero / positive'
0004    | OP_CONSTANT         2 '0'
0006    | OP_CONSTANT         3 '5'
0008    | OP_DIVIDE
0009    | OP_CONSTANT         2 '0'
0011    | OP_CALL             3
0013    | OP_POP
0014   11 OP_GET_GLOBAL       0 'check'
0016    | OP_CONSTANT         4 'zero / negative'
0018    | OP_CONSTANT         2 '0'
0020    | OP_CONSTANT         5 '-3'
0022    | OP_DIVIDE
0023    | OP_CONSTANT         2 '0'
0025    | OP_CALL             3
0027    | OP_POP
0028   12 OP_GET_GLOBAL       0 'check'
0030    | OP_CONSTANT         6 'negative zero-valued expr / positive'
0032    | OP_CONSTANT         7 '2'
0034    | OP_CONSTANT         7 '2'
0036    | OP_SUBTRACT
0037    | OP_CONSTANT         8 '7'
0039    | OP_DIVIDE
0040    | OP_CONSTANT         2 '0'
0042    | OP_CALL             3
0044    | OP_POP
0045   13 OP_GET_GLOBAL       0 'check'
0047    | OP_CONSTANT         9 'zero / positive, non-integer divisor'
0049    | OP_CONSTANT         2 '0'
0051    | OP_CONSTANT        10 '2.5'
0053    | OP_DIVIDE
0054    | OP_CONSTANT         2 '0'
0056    | OP_CALL             3
0058    | OP_POP
0059   14 OP_GET_GLOBAL       0 'check'
0061    | OP_CONSTANT        11 'ordinary division still works'
0063    | OP_CONSTANT        12 '10'
0065    | OP_CONSTANT        13 '4'
0067    | OP_DIVIDE
0068    | OP_CONSTANT        10 '2.5'
0070    | OP_CALL             3
0072    | OP_POP
0073    | OP_NIL
0074    | OP_RETURN
