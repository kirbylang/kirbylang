@println(false or true);
@println(false || true);

@println(true or false);
@println(true || false);

@println(true or true);
@println(true || true);

@println(false or false);
@println(false || false);

fun should_not_call (): bool {
    @println("Should not print");
    return false;
}

@println(true or should_not_call());
