fun main(): unit {
    // Infinity minus infinity is NaN
    let inf = @parseFloat("1e308") * 10.0;
    let nan = inf - inf;
    let one: f64 = 1.0;

    // NaN has no order, so every comparison with it is false
    @println(nan < one);
    @println(nan > one);
    @println(nan <= one);
    @println(nan >= one);
    @println(one <= nan);
    @println(one >= nan);
    @println(nan <= nan);
    @println(nan >= nan);

    @println(one <= one);
    @println(one >= one);
}
