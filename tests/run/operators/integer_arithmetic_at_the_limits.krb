let largest = 9223372036854775807;
let smallest = -9223372036854775808;
let negativeOne = -1;

@println(largest + 0);
@println(largest - largest);
@println(smallest + largest);
@println(smallest + 0);
@println(-largest);
@println(smallest % negativeOne);
@println(smallest / 1);
@println(largest * 1);
@println(smallest * 1);
@println(-largest - 1);

let byte: u8 = 254;
@println(byte + 1);
let zero: u8 = 0;
@println(zero * 255);

let largestU64 = 18446744073709551615u64;
@println(largestU64 - 1u64);
@println(largestU64 / 2u64);

let small: i8 = -128;
@println(small + 127);
@println(small * 1);
