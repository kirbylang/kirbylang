== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== map ==
0000    1 OP_GET_LOCAL        2
0002    | OP_GET_LOCAL        1
0004    | OP_CALL             1
0006    | OP_RETURN
== lambda ==
0000    3 OP_GET_LOCAL        1
0002    | OP_GET_LOCAL        1
0004    | OP_MULTIPLY
0005    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          1 <fn map>
0002    | OP_DEFINE_GLOBAL    0 'map'
0004    3 OP_GET_GLOBAL       2 'map'
0006    | OP_CONSTANT         3 '10.000000'
0008    | OP_CLOSURE          4 <fn lambda>
0010    | OP_CALL             2
0012    | OP_PRINT
0013    4 OP_NIL
0014    | OP_RETURN
