== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== lambda0x1 ==
0000    1 OP_GET_LOCAL        1
0002    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          0 <fn lambda0x1>
0002    | OP_CONSTANT         1 'Hello World'
