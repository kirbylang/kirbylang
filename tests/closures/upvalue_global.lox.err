0003    2 OP_NIL
0004    | OP_DEFINE_GLOBAL    1 'globalGet'
0006   12 OP_CLOSURE          3 <fn main>
0008    | OP_DEFINE_GLOBAL    2 'main'
0010   14 OP_GET_GLOBAL       4 'main'
0012    | OP_CALL             0
0014    | OP_POP
0015   15 OP_GET_GLOBAL       5 'globalSet'
0017    | OP_CALL             0
0019    | OP_POP
0020   16 OP_GET_GLOBAL       6 'globalGet'
0022    | OP_CALL             0
0024    | OP_POP
0025   17 OP_NIL
0026    | OP_RETURN
