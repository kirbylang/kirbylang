== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000   10 OP_CLOSURE          1 <fn nested>
0002    | OP_DEFINE_GLOBAL    0 'nested'
0004   16 OP_CLOSURE          3 <fn afterLocals>
0006    | OP_DEFINE_GLOBAL    2 'afterLocals'
0008   18 OP_GET_GLOBAL       4 'nested'
0010    | OP_CALL             0
0012    | OP_PRINT
0013   19 OP_GET_GLOBAL       5 'afterLocals'
0015    | OP_CALL             0
0017    | OP_PRINT
0018   20 OP_NIL
0019    | OP_RETURN
== nested ==
0000    4 OP_CONSTANT         0 '1.000000'
0002    5 OP_GET_LOCAL        1
0004    | OP_CONSTANT         1 '1.000000'
0006    | OP_ADD
0007    6 OP_CLOSE_BLOCK_EXPR    1
0009    7 OP_GET_LOCAL        1
0011    | OP_CONSTANT         2 '10.000000'
0013    | OP_MULTIPLY
0014    8 OP_CLOSE_BLOCK_EXPR    1
0016    9 OP_GET_LOCAL        1
0018    | OP_RETURN
== afterLocals ==
0000   13 OP_CONSTANT         0 '100.000000'
0002   14 OP_CONSTANT         1 '5.000000'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_LOCAL        2
0008    | OP_ADD
0009    | OP_CLOSE_BLOCK_EXPR    1
0011   15 OP_GET_LOCAL        1
