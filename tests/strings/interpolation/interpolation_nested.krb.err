== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'World'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    3 OP_GET_GLOBAL       2 '@strConcat'
0006    | OP_CONSTANT         3 'outer '
0008    | OP_GET_GLOBAL       4 '@strConcat'
0010    | OP_CONSTANT         5 'inner '
0012    | OP_GET_GLOBAL       6 'name'
0014    | OP_ARRAY            2
0016    | OP_CALL             1
0018    | OP_CONSTANT         7 ' outer'
0020    | OP_ARRAY            3
0022    | OP_CALL             1
0024    | OP_PRINT
0025    4 OP_NIL
0026    | OP_RETURN
