== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         0 'a'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    2 OP_CONSTANT         1 'b'
0006    | OP_DEFINE_GLOBAL    1 'b'
0008    4 OP_GET_GLOBAL       2 '@strConcat'
0010    | OP_GET_GLOBAL       0 'a'
0012    | OP_GET_GLOBAL       1 'b'
0014    | OP_ARRAY            2
0016    | OP_CALL             1
0018    | OP_PRINT
0019    5 OP_NIL
0020    | OP_RETURN
