== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'a'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    2 OP_CONSTANT         3 'b'
0006    | OP_DEFINE_GLOBAL    2 'b'
0008    4 OP_GET_GLOBAL       4 '@strConcat'
0010    | OP_GET_GLOBAL       5 'a'
0012    | OP_GET_GLOBAL       6 'b'
