== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 '3'
0002    | OP_DEFINE_GLOBAL    0 'count'
0004    3 OP_GET_GLOBAL       2 '@strConcat'
0006    | OP_CONSTANT         3 'count='
0008    | OP_GET_GLOBAL       4 '@numberToString'
0010    | OP_GET_GLOBAL       0 'count'
0012    | OP_CALL             1
0014    | OP_ARRAY            2
0016    | OP_CALL             1
0018    | OP_PRINT
0019    4 OP_GET_GLOBAL       2 '@strConcat'
0021    | OP_CONSTANT         5 'pi is roughly '
0023    | OP_GET_GLOBAL       4 '@numberToString'
0025    | OP_CONSTANT         6 '3.14159'
