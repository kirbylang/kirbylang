== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 '3'
0002    | OP_DEFINE_GLOBAL    0 'count'
0004    3 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       3 '@strConcat'
0008    | OP_CONSTANT         4 'count='
0010    | OP_GET_GLOBAL       5 '@numberToString'
0012    | OP_GET_GLOBAL       0 'count'
0014    | OP_CALL             1
0016    | OP_ARRAY            2
0018    | OP_CALL             1
0020    | OP_CALL             1
0022    | OP_POP
0023    4 OP_GET_GLOBAL       2 '@println'
0025    | OP_GET_GLOBAL       3 '@strConcat'
0027    | OP_CONSTANT         6 'pi is roughly '
0029    | OP_GET_GLOBAL       5 '@numberToString'
0031    | OP_CONSTANT         7 '3.14159'
0033    | OP_CALL             1
0035    | OP_ARRAY            2
0037    | OP_CALL             1
0039    | OP_CALL             1
0041    | OP_POP
0042    5 OP_NIL
0043    | OP_RETURN
