== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_TRUE
0001    | OP_DEFINE_GLOBAL    0 'ok'
0003    3 OP_GET_GLOBAL       1 '@println'
0005    | OP_GET_GLOBAL       2 '@strConcat'
0007    | OP_CONSTANT         3 'ok='
0009    | OP_GET_GLOBAL       4 '@boolToString'
