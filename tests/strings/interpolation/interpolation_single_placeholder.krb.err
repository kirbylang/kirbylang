== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'World'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    2 OP_CONSTANT         3 '42'
0006    | OP_DEFINE_GLOBAL    2 'n'
0008    4 OP_GET_GLOBAL       4 'name'
0010    | OP_PRINT
0011    5 OP_GET_GLOBAL       5 '@numberToString'
0013    | OP_GET_GLOBAL       6 'n'
0015    | OP_CALL             1
0017    | OP_PRINT
0018    6 OP_NIL
0019    | OP_RETURN
