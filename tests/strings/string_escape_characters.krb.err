== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'Hello
World'
0004    | OP_CALL             1
0006    | OP_POP
0007    3 OP_GET_GLOBAL       0 '@println'
0009    | OP_CONSTANT         2 'Hello
World'
0011    | OP_CALL             1
0013    | OP_POP
0014    5 OP_GET_GLOBAL       0 '@println'
0016    | OP_CONSTANT         3 '	Hello
	World'
0018    | OP_CALL             1
0020    | OP_POP
0021    7 OP_GET_GLOBAL       0 '@println'
0023    | OP_CONSTANT         4 'Hello "World"'
0025    | OP_CALL             1
0027    | OP_POP
0028    9 OP_GET_GLOBAL       0 '@println'
0030    | OP_CONSTANT         5 '\Hello\World\'
0032    | OP_CALL             1
0034    | OP_POP
0035   10 OP_NIL
0036    | OP_RETURN
