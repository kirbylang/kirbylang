== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLOSURE          1 <fn function>
0002    | OP_DEFINE_GLOBAL    0 'function'
0004    3 OP_GET_GLOBAL       2 'typeof'
0006    | OP_GET_GLOBAL       3 'function'
0008    | OP_CALL             1
0010    | OP_PRINT
0011    4 OP_NIL
0012    | OP_RETURN
== function ==
0000    1 OP_NIL
0001    | OP_RETURN
