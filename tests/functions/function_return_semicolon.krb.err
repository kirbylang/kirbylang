== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== function ==
0000    2 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    3 OP_CLOSURE          1 <fn function>
0002    | OP_DEFINE_GLOBAL    0 'function'
0004    5 OP_GET_GLOBAL       2 'function'
0006    | OP_PRINT
0007    7 OP_GET_GLOBAL       3 'function'
0009    | OP_CALL             0
0011    | OP_PRINT
0012    8 OP_NIL
0013    | OP_RETURN
