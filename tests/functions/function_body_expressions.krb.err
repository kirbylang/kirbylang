== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    3 OP_CLOSURE          1 <fn sum>
0002    | OP_DEFINE_GLOBAL    0 'sum'
0004    1 OP_CONSTANT         3 '10.000000'
0006    | OP_DEFINE_GLOBAL    2 'n'
0008    5 OP_GET_GLOBAL       4 'sum'
0010    | OP_CONSTANT         5 '50.000000'
0012    | OP_CALL             1
0014    | OP_PRINT
0015    6 OP_NIL
0016    | OP_RETURN
== sum ==
0000    3 OP_GET_LOCAL        1
0002    | OP_GET_GLOBAL       0 'n'
0004    | OP_ADD
0005    | OP_RETURN
