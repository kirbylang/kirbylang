== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== hello ==
0000    2 OP_NIL
0001    | OP_RETURN
== world ==
0000    3 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLASS            0 'Class'
0002    | OP_DEFINE_GLOBAL    0 'Class'
0004    | OP_GET_GLOBAL       1 'Class'
0006    2 OP_CLOSURE          3 <fn hello>
0008    | OP_METHOD           2 'hello'
0010    3 OP_CLOSURE          5 <fn world>
0012    | OP_METHOD           4 'world'
0014    4 OP_POP
0015    6 OP_GET_GLOBAL       7 'Class'
0017    | OP_CALL             0
0019    | OP_DEFINE_GLOBAL    6 'instance'
0021    8 OP_GET_GLOBAL       8 'instance'
0023    | OP_GET_PROPERTY     9 'hello'
0025    | OP_PRINT
0026    9 OP_GET_GLOBAL      10 'instance'
0028    | OP_GET_PROPERTY    11 'world'
0030    | OP_PRINT
0031   10 OP_NIL
0032    | OP_RETURN
