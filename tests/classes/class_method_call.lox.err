== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== greet ==
0000    3 OP_CONSTANT         0 'Hello '
0002    | OP_GET_LOCAL        1
0004    | OP_ADD
0005    | OP_PRINT
0006    4 OP_NIL
0007    | OP_RETURN
== <script> ==
0000    1 OP_CLASS            0 'Greeter'
0002    | OP_DEFINE_GLOBAL    0 'Greeter'
0004    | OP_GET_GLOBAL       1 'Greeter'
0006    4 OP_CLOSURE          3 <fn greet>
0008    | OP_METHOD           2 'greet'
0010    5 OP_POP
0011    7 OP_GET_GLOBAL       5 'Greeter'
0013    | OP_CALL             0
0015    | OP_DEFINE_GLOBAL    4 'greeter'
0017    9 OP_GET_GLOBAL       6 'greeter'
0019    | OP_CONSTANT         8 'World'
0021    | OP_INVOKE        (1 args)    7 'greet'
0024    | OP_POP
0025   10 OP_NIL
0026    | OP_RETURN
