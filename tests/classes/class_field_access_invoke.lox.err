== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== fn ==
0000    8 OP_CONSTANT         0 'Hello World'
0002    | OP_PRINT
0003    9 OP_NIL
0004    | OP_RETURN
== <script> ==
0000    1 OP_CLASS            0 'Class'
0002    | OP_DEFINE_GLOBAL    0 'Class'
0004    | OP_GET_GLOBAL       1 'Class'
0006    2 OP_NIL
0007    | OP_FIELD            2 'fn'
0009    3 OP_POP
0010    5 OP_GET_GLOBAL       4 'Class'
0012    | OP_CALL             0
0014    | OP_DEFINE_GLOBAL    3 'instance'
0016    9 OP_CLOSURE          6 <fn fn>
0018    | OP_DEFINE_GLOBAL    5 'fn'
0020   11 OP_GET_GLOBAL       7 'instance'
0022    | OP_GET_GLOBAL       9 'fn'
0024    | OP_SET_PROPERTY     8 'fn'
0026    | OP_POP
0027   13 OP_GET_GLOBAL      10 'instance'
0029    | OP_INVOKE        (0 args)   11 'fn'
0032    | OP_POP
0033   14 OP_NIL
0034    | OP_RETURN
