== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== innerClosure ==
0000    4 OP_GET_UPVALUE      0
0002    | OP_PRINT
0003    5 OP_NIL
0004    | OP_RETURN
== printThis ==
0000    5 OP_CLOSURE          0 <fn innerClosure>
0002      |                     local 0
0004    7 OP_GET_LOCAL        1
0006    | OP_RETURN
== <script> ==
0000    1 OP_CLASS            0 'Class'
0002    | OP_DEFINE_GLOBAL    0 'Class'
0004    | OP_GET_GLOBAL       1 'Class'
0006    8 OP_CLOSURE          3 <fn printThis>
0008    | OP_METHOD           2 'printThis'
0010    9 OP_POP
0011   11 OP_GET_GLOBAL       5 'Class'
0013    | OP_CALL             0
0015    | OP_DEFINE_GLOBAL    4 'instance'
0017   13 OP_GET_GLOBAL       7 'instance'
0019    | OP_INVOKE        (0 args)    8 'printThis'
0022    | OP_DEFINE_GLOBAL    6 'closure'
0024   15 OP_GET_GLOBAL       9 'closure'
0026    | OP_CALL             0
0028    | OP_POP
0029   16 OP_NIL
0030    | OP_RETURN
