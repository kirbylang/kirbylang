0013    | OP_PRINT
0014    7 OP_TRUE
0015    | OP_DEFINE_GLOBAL    6 'flag'
0017    8 OP_GET_GLOBAL       7 'flag'
0019    | OP_PRINT
0020    9 OP_NIL
0021    | OP_RETURN
