== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'John'
0002    | OP_DEFINE_GLOBAL    0 'name'
0004    2 OP_GET_GLOBAL       0 'name'
0006    | OP_PRINT
0007    4 OP_CONSTANT         3 '42'
0009    | OP_DEFINE_GLOBAL    2 'n'
0011    5 OP_GET_GLOBAL       2 'n'
0013    | OP_PRINT
0014    7 OP_TRUE
0015    | OP_DEFINE_GLOBAL    4 'flag'
0017    8 OP_GET_GLOBAL       4 'flag'
0019    | OP_PRINT
0020    9 OP_NIL
0021    | OP_RETURN
