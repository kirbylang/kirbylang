== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_TRUE
0001    | OP_DEFINE_GLOBAL    0 'cond'
0003    3 OP_GET_GLOBAL       0 'cond'
0005    | OP_JUMP_IF_FALSE    5 -> 25
0008    | OP_POP
0009    4 OP_GET_GLOBAL       0 'cond'
0011    | OP_NOT
0012    | OP_SET_GLOBAL       0 'cond'
0014    | OP_POP
0015    5 OP_GET_GLOBAL       1 '@println'
0017    | OP_CONSTANT         2 'Hello World'
0019    | OP_CALL             1
0021    | OP_POP
0022    6 OP_LOOP            22 -> 3
0025    | OP_POP
0026    7 OP_NIL
0027    | OP_RETURN
