== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000   10 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       2 'test'
0006    | OP_TRUE
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       3 'test'
0012    | OP_FALSE
0013    | OP_CALL             1
0015    | OP_POP
0016   11 OP_NIL
0017    | OP_RETURN
== test ==
0000    5 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 12
0005    | OP_POP
0006    6 OP_CONSTANT         0 'Hello'
0008    | OP_PRINT
0009    7 OP_JUMP             9 -> 16
0012    | OP_POP
0013    8 OP_CONSTANT         1 'World'
0015    | OP_PRINT
0016   10 OP_NIL
0017    | OP_RETURN
