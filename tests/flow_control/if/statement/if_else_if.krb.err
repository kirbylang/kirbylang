== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000   13 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       0 'test'
0006    | OP_TRUE
0007    | OP_FALSE
0008    | OP_CALL             2
0010    | OP_POP
0011    2 OP_GET_GLOBAL       0 'test'
0013    | OP_FALSE
0014    | OP_TRUE
0015    | OP_CALL             2
0017    | OP_POP
0018    3 OP_GET_GLOBAL       0 'test'
0020    | OP_FALSE
0021    | OP_FALSE
0022    | OP_CALL             2
0024    | OP_POP
0025   13 OP_NIL
0026    | OP_RETURN
== test ==
0000    6 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 16
0005    | OP_POP
0006    7 OP_GET_GLOBAL       0 '@println'
0008    | OP_CONSTANT         1 'Hello'
0010    | OP_CALL             1
0012    | OP_POP
0013    8 OP_JUMP            13 -> 41
0016    | OP_POP
0017    | OP_GET_LOCAL        2
0019    | OP_JUMP_IF_FALSE   19 -> 33
0022    | OP_POP
0023    9 OP_GET_GLOBAL       0 '@println'
0025    | OP_CONSTANT         2 'World'
0027    | OP_CALL             1
0029    | OP_POP
0030   10 OP_JUMP            30 -> 41
0033    | OP_POP
0034   11 OP_GET_GLOBAL       0 '@println'
0036    | OP_CONSTANT         3 'Goodbye'
0038    | OP_CALL             1
0040    | OP_POP
0041   13 OP_NIL
0042    | OP_RETURN
