== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000   14 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       0 'test'
0006    | OP_TRUE
0007    | OP_CALL             1
0009    | OP_POP
0010    2 OP_GET_GLOBAL       0 'test'
0012    | OP_FALSE
0013    | OP_CALL             1
0015    | OP_POP
0016   16 OP_NIL
0017    | OP_RETURN
== test ==
0000    6 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 18
0004    | OP_POP
0005    7 OP_GET_GLOBAL       0 '@println'
0007    | OP_CONSTANT         1 'Hello'
0009    | OP_CALL             1
0011    | OP_POP
0012    8 OP_NIL
0013    | OP_CLOSE_BLOCK_EXPR    0
0015    | OP_JUMP            15 -> 20
0018    | OP_POP
0019    | OP_NIL
0020    | OP_POP
0021   10 OP_CONSTANT         2 'World'
0023   11 OP_CLOSE_BLOCK_EXPR    0
0025   13 OP_GET_GLOBAL       0 '@println'
0027    | OP_GET_LOCAL        2
0029    | OP_CALL             1
0031    | OP_POP
0032   14 OP_NIL
0033    | OP_RETURN
