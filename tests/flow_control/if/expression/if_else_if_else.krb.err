== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    6 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       2 '@println'
0006    | OP_GET_GLOBAL       0 'test'
0008    | OP_TRUE
0009    | OP_FALSE
0010    | OP_CALL             2
0012    | OP_CALL             1
0014    | OP_POP
0015    2 OP_GET_GLOBAL       2 '@println'
0017    | OP_GET_GLOBAL       0 'test'
0019    | OP_FALSE
0020    | OP_TRUE
0021    | OP_CALL             2
0023    | OP_CALL             1
0025    | OP_POP
0026    3 OP_GET_GLOBAL       2 '@println'
0028    | OP_GET_GLOBAL       0 'test'
0030    | OP_FALSE
0031    | OP_FALSE
0032    | OP_CALL             2
0034    | OP_CALL             1
0036    | OP_POP
0037    7 OP_NIL
0038    | OP_RETURN
== test ==
0000    6 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    | OP_CONSTANT         0 'Hello'
0008    | OP_JUMP             8 -> 28
0011    | OP_POP
0012    | OP_GET_LOCAL        2
0014    | OP_JUMP_IF_FALSE   14 -> 23
0017    | OP_POP
0018    | OP_CONSTANT         1 'World'
0020    | OP_JUMP            20 -> 28
0023    | OP_POP
0024    | OP_CONSTANT         2 'Goodbye'
0026    | OP_CLOSE_BLOCK_EXPR    0
0028    | OP_RETURN
