== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    6 OP_CLOSURE          1 <fn test>
0002    | OP_DEFINE_GLOBAL    0 'test'
0004    1 OP_GET_GLOBAL       2 'test'
0006    | OP_TRUE
0007    | OP_FALSE
0008    | OP_CALL             2
0010    | OP_PRINT
0011    2 OP_GET_GLOBAL       3 'test'
0013    | OP_FALSE
0014    | OP_TRUE
0015    | OP_CALL             2
0017    | OP_PRINT
0018    3 OP_GET_GLOBAL       4 'test'
0020    | OP_FALSE
0021    | OP_FALSE
0022    | OP_CALL             2
0024    | OP_PRINT
0025    7 OP_NIL
0026    | OP_RETURN
== test ==
0000    6 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    | OP_CONSTANT         0 'Hello'
0008    | OP_JUMP             8 -> 25
0011    | OP_POP
0012    | OP_GET_LOCAL        2
0014    | OP_JUMP_IF_FALSE   14 -> 23
0017    | OP_POP
0018    | OP_CONSTANT         1 'World'
0020    | OP_JUMP            20 -> 25
0023    | OP_POP
0024    | OP_NIL
0025    | OP_RETURN
