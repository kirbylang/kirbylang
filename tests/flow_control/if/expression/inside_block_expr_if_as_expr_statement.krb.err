== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    2 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 18
0004    | OP_POP
0005    3 OP_GET_GLOBAL       1 '@println'
0007    | OP_CONSTANT         2 'hi'
0009    | OP_CALL             1
0011    | OP_POP
0012    4 OP_NIL
0013    | OP_CLOSE_BLOCK_EXPR    0
0015    | OP_JUMP            15 -> 20
0018    | OP_POP
0019    | OP_NIL
0020    | OP_POP
0021    6 OP_CONSTANT         3 '5'
0023    7 OP_CLOSE_BLOCK_EXPR    0
0025    | OP_DEFINE_GLOBAL    0 'x'
0027    8 OP_GET_GLOBAL       1 '@println'
0029    | OP_GET_GLOBAL       0 'x'
0031    | OP_CALL             1
0033    | OP_POP
0034    9 OP_NIL
0035    | OP_RETURN
