== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== ifelseifelse ==
0000    3 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 11
0005    | OP_POP
0006    4 OP_CONSTANT         0 'Hello'
0008    | OP_JUMP             8 -> 26
0011    | OP_POP
0012    5 OP_GET_LOCAL        2
0014    | OP_JUMP_IF_FALSE   14 -> 23
0017    | OP_POP
0018    6 OP_CONSTANT         1 'World'
0020    | OP_JUMP            20 -> 26
0023    | OP_POP
0024    8 OP_CONSTANT         2 'Goodbye'
0026    | OP_PRINT
0027    9 OP_NIL
0028    | OP_RETURN
== <script> ==
0000    9 OP_CLOSURE          1 <fn ifelseifelse>
0002    | OP_DEFINE_GLOBAL    0 'ifelseifelse'
0004   11 OP_GET_GLOBAL       2 'ifelseifelse'
0006    | OP_TRUE
0007    | OP_FALSE
0008    | OP_CALL             2
0010    | OP_POP
0011   12 OP_GET_GLOBAL       3 'ifelseifelse'
0013    | OP_FALSE
0014    | OP_TRUE
0015    | OP_CALL             2
0017    | OP_POP
0018   13 OP_GET_GLOBAL       4 'ifelseifelse'
0020    | OP_FALSE
0021    | OP_FALSE
0022    | OP_CALL             2
0024    | OP_POP
0025   14 OP_NIL
0026    | OP_RETURN
