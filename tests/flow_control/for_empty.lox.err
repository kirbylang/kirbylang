== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 14
0004    | OP_POP
0005    2 OP_CONSTANT         0 'done'
0007    | OP_PRINT
