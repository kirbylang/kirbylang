0028    | OP_CONSTANT        10 '2.000000'
0030    | OP_EQUAL
0031    | OP_JUMP_IF_FALSE   31 -> 42
0034    | OP_POP
0035    | OP_POP
0036    | OP_LOOP            36 -> 4
0039    | OP_JUMP            39 -> 43
0042    | OP_POP
0043    8 OP_GET_LOCAL        1
0045    | OP_PRINT
0046    9 OP_POP
0047   10 OP_LOOP            47 -> 4
0050    | OP_POP
