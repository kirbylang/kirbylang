== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 '0.000000'
0002    | OP_DEFINE_GLOBAL    0 'i'
0004    2 OP_GET_GLOBAL       2 'i'
0006    | OP_CONSTANT         3 '4.000000'
0008    | OP_LESS
0009    | OP_JUMP_IF_FALSE    9 -> 50
0012    | OP_POP
0013    3 OP_GET_GLOBAL       5 'i'
0015    | OP_CONSTANT         6 '1.000000'
0017    | OP_ADD
0018    | OP_SET_GLOBAL       4 'i'
0020    | OP_POP
0021    6 OP_GET_GLOBAL       7 'i'
0023    | OP_CONSTANT         8 '100.000000'
0025    | OP_MULTIPLY
