== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         0 '0'
0002    | OP_GET_LOCAL        1
0004    | OP_CONSTANT         1 '3'
0006    | OP_LESS
0007    | OP_JUMP_IF_FALSE    7 -> 38
0010    | OP_POP
0011    | OP_JUMP            11 -> 25
0014    | OP_GET_LOCAL        1
0016    | OP_CONSTANT         2 '1'
0018    | OP_ADD
0019    | OP_SET_LOCAL        1
0021    | OP_POP
0022    | OP_LOOP            22 -> 2
0025    | OP_CONSTANT         3 'a'
0027    | OP_GET_GLOBAL       4 '@println'
0029    | OP_GET_LOCAL        2
0031    | OP_CALL             1
0033    | OP_POP
0034    | OP_POP
0035    | OP_LOOP            35 -> 14
0038    | OP_POP
0039    | OP_POP
0040    2 OP_GET_GLOBAL       4 '@println'
0042    | OP_CONSTANT         5 'done'
0044    | OP_CALL             1
0046    | OP_POP
0047    3 OP_NIL
0048    | OP_RETURN
