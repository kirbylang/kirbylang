0030    8 OP_CLOSE_BLOCK_EXPR    0
0032    | OP_PRINT
0033    9 OP_NIL
0034    | OP_RETURN
== <script> ==
0000    9 OP_CLOSURE          1 <fn ifelseifelse>
0002    | OP_DEFINE_GLOBAL    0 'ifelseifelse'
