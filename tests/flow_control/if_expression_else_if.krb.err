== ifelseifelse ==
0000    2 OP_GET_LOCAL        1
0002    | OP_JUMP_IF_FALSE    2 -> 13
0005    | OP_POP
0006    3 OP_CONSTANT         0 'Hello'
0008    4 OP_CLOSE_BLOCK_EXPR    0
0010    | OP_JUMP            10 -> 32
0013    | OP_POP
0014    | OP_GET_LOCAL        2
0016    | OP_JUMP_IF_FALSE   16 -> 27
0019    | OP_POP
0020    5 OP_CONSTANT         1 'World'
0022    6 OP_CLOSE_BLOCK_EXPR    0
0024    | OP_JUMP            24 -> 32
0027    | OP_POP
