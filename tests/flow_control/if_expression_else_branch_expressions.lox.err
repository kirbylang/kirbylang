== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 10
0004    | OP_POP
0005    | OP_CONSTANT         0 'Hello'
0007    | OP_JUMP             7 -> 13
0010    | OP_POP
0011    | OP_CONSTANT         1 'World'
0013    | OP_PRINT
0014    3 OP_FALSE
0015    | OP_JUMP_IF_FALSE   15 -> 24
0018    | OP_POP
0019    | OP_CONSTANT         2 'Hello'
0021    | OP_JUMP            21 -> 27
0024    | OP_POP
0025    | OP_CONSTANT         3 'World'
0027    | OP_PRINT
0028    | OP_NIL
0029    | OP_RETURN
