struct Box {
    pub var value: f64;
}

impl Display for Box {
    fun toString(self): string = "Box(" + @numberToString(self.value) + ")";
}

fun show(box: Box): unit {
    @println(box);
}

let boxes = [Box { value: 1 }, Box { value: 2 }];

show(Box { value: 3 });
@println(boxes[1]);
@println({ let b = Box { value: 4 }; b });
