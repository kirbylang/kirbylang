== <script> ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_GET_GLOBAL       1 '@argc'
0004    | OP_CALL             0
0006    | OP_CALL             1
0008    | OP_POP
0009    2 OP_GET_GLOBAL       0 '@println'
0011    | OP_GET_GLOBAL       2 '@argv'
0013    | OP_CONSTANT         3 '1'
0015    | OP_CALL             1
0017    | OP_CALL             1
0019    | OP_POP
0020    3 OP_GET_GLOBAL       0 '@println'
0022    | OP_GET_GLOBAL       2 '@argv'
0024    | OP_CONSTANT         4 '2'
0026    | OP_CALL             1
0028    | OP_CALL             1
0030    | OP_POP
0031    4 OP_GET_GLOBAL       0 '@println'
0033    | OP_GET_GLOBAL       2 '@argv'
0035    | OP_CONSTANT         5 '3'
0037    | OP_CALL             1
0039    | OP_CALL             1
0041    | OP_POP
0042    | OP_NIL
0043    | OP_RETURN
