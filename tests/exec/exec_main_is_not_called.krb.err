== <script> ==
0000    1 OP_CLOSURE          1 <fn main>
0002    | OP_DEFINE_GLOBAL    0 'main'
0004    3 OP_GET_GLOBAL       2 '@println'
0006    | OP_CONSTANT         3 'top'
0008    | OP_CALL             1
0010    | OP_POP
0011    | OP_NIL
0012    | OP_RETURN
== main ==
0000    1 OP_GET_GLOBAL       0 '@println'
0002    | OP_CONSTANT         1 'main ran'
0004    | OP_CALL             1
0006    | OP_POP
0007    | OP_NIL
0008    | OP_RETURN
