== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'global'
0002    | OP_DEFINE_GLOBAL    0 'a'
0004    4 OP_CONSTANT         2 'local'
0006    5 OP_GET_LOCAL        1
0008    6 OP_CLOSE_BLOCK_EXPR    1
0010    | OP_PRINT
0011    8 OP_GET_GLOBAL       3 '@println'
0013    | OP_GET_GLOBAL       0 'a'
0015    | OP_CALL             1
0017    | OP_POP
0018    9 OP_NIL
0019    | OP_RETURN
