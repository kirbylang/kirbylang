fun makeCounter() {
    struct Counter {
        var count = 0;
    }

    impl Counter {
        fun increment(self) {
            self.count = self.count + 1;
            return self.count;
        }

        fun new() {
            return Counter();
        }
    }

    return Counter.new();
}

var counter = makeCounter();

print counter.increment();
print counter.increment();
