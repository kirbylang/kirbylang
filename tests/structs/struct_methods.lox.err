== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== hello ==
0000    4 OP_NIL
0001    | OP_RETURN
== world ==
0000    5 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Struct'
0002    | OP_DEFINE_GLOBAL    0 'Struct'
0004    | OP_GET_GLOBAL       1 'Struct'
0006    | OP_POP
0007    3 OP_GET_GLOBAL       2 'Struct'
0009    4 OP_CLOSURE          4 <fn hello>
0011    | OP_METHOD           3 'hello'
0013    5 OP_CLOSURE          6 <fn world>
0015    | OP_METHOD           5 'world'
0017    6 OP_POP
0018    8 OP_GET_GLOBAL       8 'Struct'
0020    | OP_STRUCT_INIT      0
0022    | OP_DEFINE_GLOBAL    7 'instance'
0024   10 OP_GET_GLOBAL       9 'instance'
0026    | OP_GET_PROPERTY    10 'hello'
0028    | OP_PRINT
0029   11 OP_GET_GLOBAL      11 'instance'
0031    | OP_GET_PROPERTY    12 'world'
0033    | OP_PRINT
0034   12 OP_NIL
0035    | OP_RETURN
