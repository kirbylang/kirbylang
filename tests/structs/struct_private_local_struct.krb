// Each call to makeCounter() creates a fresh struct. Access is tracked per
// closure, so the methods from call 1 must not lose access when call 2 runs.
fun makeCounter() {
    struct Counter {
        var count = 0;
    }

    impl Counter {
        pub fun new() = Counter {};

        pub fun increment(self) {
            self.count = self.count + 1;
            self.count
        }
    }

    return Counter.new();
}

var a = makeCounter();
var b = makeCounter();

print a.increment();
print a.increment();
print b.increment();
print a.increment();
