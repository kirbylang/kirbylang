struct Account {
    var _balance: f64;
}

impl Account {
    pub fun new(): Account = Account { _balance: 100 };

    pub fun deposit(self, amount: f64): Account {
        self._balance = self._balance + amount;
        self
    }

    pub fun balance(self): f64 = self._balance;
}

print Account.new().deposit(50).balance();
