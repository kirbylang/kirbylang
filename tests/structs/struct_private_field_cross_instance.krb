struct Point {
    var x: f64;
}

impl Point {
    pub fun at(x: f64): Point = Point { x: x };

    // Visibility is per-struct, not per-instance: `other` is a different
    // object but the same struct.
    pub fun sum(self, other: Point): f64 = self.x + other.x;
}

print Point.at(3).sum(Point.at(4));
