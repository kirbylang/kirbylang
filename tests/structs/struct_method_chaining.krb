struct Chain {
    var value;
}

impl Chain {
    pub fun new(value) {
        var chain = Chain();

        chain.value = value;

        return chain;
    }

    pub fun plus(self, n) {
        return Chain.new(self.value + n);
    }

    pub fun get(self) {
        return self.value;
    }
}

print Chain.new(1).plus(2).plus(3).get();
