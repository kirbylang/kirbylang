0015    | OP_CLOSURE          6 <fn lambda0x1>
0017    7 OP_STRUCT_INIT      1
0019    | OP_DEFINE_GLOBAL    3 'h'
0021    9 OP_GET_GLOBAL       7 'h'
0023    | OP_INVOKE        (0 args)    8 'callback'
0026    | OP_PRINT
0027   10 OP_NIL
0028    | OP_RETURN
== lambda0x1 ==
0000    6 OP_CONSTANT         0 'called'
0002    | OP_RETURN
