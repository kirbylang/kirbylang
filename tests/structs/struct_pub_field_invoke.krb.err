== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Holder'
0002    | OP_DEFINE_GLOBAL    0 'Holder'
0004    | OP_GET_GLOBAL       1 'Holder'
0006    2 OP_NIL
0007    | OP_FIELD            2 'callback' public
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       4 'Holder'
