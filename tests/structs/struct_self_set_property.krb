struct Struct {
     var value: string;
}

impl Struct {
    pub fun set(self, value: string): unit {
        self.value = value;
    }

    pub fun get(self): string = self.value;
}

impl Default for Struct {
    fun default(): Self = Self { value: "" };
}

var instance = Struct.default();

instance.set("Hello");

print instance.get();

instance.set("World");

print instance.get();
