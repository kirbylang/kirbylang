struct Counter {
    pub var count: f64;
}

impl Counter {
    pub fun increment(self): unit {
        self.count = self.count + 1;
    }
}

impl Counter {
    pub fun get(self): f64 {
        return self.count;
    }
}

var counter = Counter { count: 0 };

counter.increment();
counter.increment();

print counter.get();
