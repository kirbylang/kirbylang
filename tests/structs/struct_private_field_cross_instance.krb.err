== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       1 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            2 'x' private
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       3 'Point'
0013    6 OP_CLOSURE          5 <fn at>
0015    | OP_METHOD           4 'at'
0017   10 OP_CLOSURE          7 <fn sum>
0019    | OP_METHOD           6 'sum'
0021   11 OP_POP
0022   13 OP_GET_GLOBAL       8 'Point'
0024    | OP_CONSTANT        10 '3.000000'
0026    | OP_INVOKE        (1 args)    9 'at'
0029    | OP_GET_GLOBAL      12 'Point'
0031    | OP_CONSTANT        14 '4.000000'
0033    | OP_INVOKE        (1 args)   13 'at'
0036    | OP_INVOKE        (1 args)   11 'sum'
0039    | OP_PRINT
0040   14 OP_NIL
0041    | OP_RETURN
== at ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== sum ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 'x'
0004    | OP_GET_LOCAL        1
0006    | OP_GET_PROPERTY     1 'x'
0008    | OP_ADD
0009    | OP_RETURN
