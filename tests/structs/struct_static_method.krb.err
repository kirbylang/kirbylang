== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 'x' public
0010    3 OP_NIL
0011    | OP_FIELD            2 'y' public
0014    4 OP_POP
0015    6 OP_GET_GLOBAL       0 'Point'
0017    7 OP_CLOSURE          4 <fn new>
0019    | OP_METHOD           3 'new'
0021    9 OP_CLOSURE          6 <fn origin>
0023    | OP_METHOD           5 'origin'
0025   10 OP_POP
0026   12 OP_GET_GLOBAL       0 'Point'
0028    | OP_INVOKE        (0 args)    5 'origin'
0031    | OP_DEFINE_GLOBAL    7 'point'
0033   14 OP_GET_GLOBAL       7 'point'
