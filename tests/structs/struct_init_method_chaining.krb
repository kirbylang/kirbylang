struct StringBuilder {
    pub var string = "";
}

impl StringBuilder {
    pub fun add(self, string) {
        self.string = self.string + string;

        self
    }

    pub fun to_string(self) {
        return self.string;
    }
}

var builder = StringBuilder { string: "" }
    .add("Hello")
    .add(" ")
    .add("World");

print builder.to_string();
