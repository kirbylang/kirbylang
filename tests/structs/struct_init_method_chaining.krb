struct StringBuilder {
    pub var string: string;
}

impl StringBuilder {
    pub fun add(self, string: string): StringBuilder {
        self.string = self.string + string;

        self
    }

    pub fun to_string(self): string {
        return self.string;
    }
}

var builder = StringBuilder { string: "" }
    .add("Hello")
    .add(" ")
    .add("World");

print builder.to_string();
