struct Box {
    var value: f64;
}

trait Unbox {
    fun get(self): f64;
}

impl Unbox for Box {
    fun get(self): f64 = self.value;
}

impl Box {
    pub fun new(value: f64): Self = Self { value: value };

    pub fun get(self): string = numberToString(self.value);
}

let box = Box.new(100);
var n: f64 = box.get();

print n;
