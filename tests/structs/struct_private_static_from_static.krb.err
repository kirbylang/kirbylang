== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Point'
0002    | OP_DEFINE_GLOBAL    0 'Point'
0004    | OP_GET_GLOBAL       0 'Point'
0006    2 OP_NIL
0007    | OP_FIELD            1 '_x' private
0010    3 OP_POP
0011    5 OP_GET_GLOBAL       0 'Point'
0013    6 OP_CLOSURE          3 <fn make>
0015    | OP_METHOD           2 'make'
0017    8 OP_CLOSURE          5 <fn origin>
0019    | OP_METHOD           4 'origin'
0021   10 OP_CLOSURE          7 <fn x>
0023    | OP_METHOD           6 'x'
0025   11 OP_POP
0026   13 OP_GET_GLOBAL       0 'Point'
0028    | OP_INVOKE        (0 args)    4 'origin'
0031    | OP_INVOKE        (0 args)    6 'x'
0034    | OP_PRINT
0035   14 OP_NIL
0036    | OP_RETURN
== make ==
0000    6 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         1 '_x'
0004    | OP_GET_LOCAL        1
0006    | OP_STRUCT_INIT      1
0008    | OP_RETURN
== origin ==
0000    8 OP_GET_GLOBAL       0 'Point'
0002    | OP_CONSTANT         2 '0'
0004    | OP_INVOKE        (1 args)    1 'make'
0007    | OP_RETURN
== x ==
0000   10 OP_GET_LOCAL        0
0002    | OP_GET_PROPERTY     0 '_x'
0004    | OP_RETURN
