== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== makePoint ==
0000    2 OP_STRUCT           0 'Point'
0002    | OP_GET_LOCAL        2
0004    3 OP_NIL
0005    | OP_FIELD            1 'x'
0007    4 OP_CONSTANT         3 '0.000000'
0009    | OP_FIELD            2 'y'
0011    5 OP_POP
0012    7 OP_GET_LOCAL        2
0014    | OP_CONSTANT         4 'x'
0016    | OP_GET_LOCAL        1
0018    | OP_STRUCT_INIT      1
0020    | OP_RETURN
== <script> ==
0000    8 OP_CLOSURE          1 <fn makePoint>
0002    | OP_DEFINE_GLOBAL    0 'makePoint'
0004   10 OP_GET_GLOBAL       3 'makePoint'
0006    | OP_CONSTANT         4 '7.000000'
0008    | OP_CALL             1
0010    | OP_DEFINE_GLOBAL    2 'point'
0012   12 OP_GET_GLOBAL       5 'point'
0014    | OP_GET_PROPERTY     6 'x'
0016    | OP_PRINT
0017   13 OP_GET_GLOBAL       7 'point'
0019    | OP_GET_PROPERTY     8 'y'
0021    | OP_PRINT
0022   14 OP_NIL
0023    | OP_RETURN
