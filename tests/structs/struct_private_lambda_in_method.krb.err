== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== lambda0x1 ==
0000    8 OP_GET_UPVALUE      0
0002    | OP_GET_PROPERTY     0 'count'
0004    | OP_RETURN
== read ==
0000    8 OP_CLOSURE          0 <fn lambda0x1>
0002      |                     local 0
0004   10 OP_GET_LOCAL        1
0006    | OP_CALL             0
0008    | OP_RETURN
== <script> ==
0000    1 OP_STRUCT           0 'Counter'
0002    | OP_DEFINE_GLOBAL    0 'Counter'
0004    | OP_GET_GLOBAL       1 'Counter'
0006    2 OP_CONSTANT         3 '7.000000'
0008    | OP_FIELD            2 'count' priv
0011    3 OP_POP
0012    5 OP_GET_GLOBAL       4 'Counter'
0014   11 OP_CLOSURE          6 <fn read>
0016    | OP_METHOD           5 'read'
0018   12 OP_POP
0019   14 OP_GET_GLOBAL       7 'Counter'
0021    | OP_STRUCT_INIT      0
0023    | OP_INVOKE        (0 args)    8 'read'
0026    | OP_PRINT
0027   15 OP_NIL
0028    | OP_RETURN
