== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@strToUpper'
0002    | OP_CONSTANT         1 'Hello, World 123!'
0004    | OP_CALL             1
0006    | OP_PRINT
0007    2 OP_GET_GLOBAL       2 '@strToUpper'
0009    | OP_CONSTANT         3 'already UPPER'
0011    | OP_CALL             1
0013    | OP_PRINT
0014    3 OP_GET_GLOBAL       4 '@strToUpper'
0016    | OP_CONSTANT         5 ''
0018    | OP_CALL             1
0020    | OP_PRINT
0021    4 OP_GET_GLOBAL       6 '@strToUpper'
0023    | OP_CONSTANT         7 'café'
0025    | OP_CALL             1
0027    | OP_PRINT
0028    5 OP_NIL
0029    | OP_RETURN
