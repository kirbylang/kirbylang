0023    | OP_CONSTANT         7 '10'
0025    | OP_CALL             1
0027    | OP_POP
0028    5 OP_GET_GLOBAL       8 '@println'
0030    | OP_CONSTANT         9 '0.1'
0032    | OP_CONSTANT        10 '0.2'
0034    | OP_ADD
0035    | OP_CALL             1
0037    | OP_POP
0038    6 OP_GET_GLOBAL      11 '@println'
0040    | OP_TRUE
0041    | OP_CALL             1
0043    | OP_POP
0044    7 OP_GET_GLOBAL      12 '@println'
0046    | OP_NIL
0047    | OP_CALL             1
0049    | OP_POP
0050    8 OP_GET_GLOBAL      13 '@println'
0052    | OP_CONSTANT        14 '1'
0054    | OP_CONSTANT        15 '2.5'
0056    | OP_CONSTANT        16 '3'
0058    | OP_ARRAY            3
0060    | OP_CALL             1
0062    | OP_POP
0063    9 OP_GET_GLOBAL      17 '@println'
0065    | OP_CONSTANT        18 'one'
0067    | OP_CONSTANT        19 'two'
0069    | OP_ARRAY            2
0071    | OP_CALL             1
0073    | OP_POP
0074   10 OP_GET_GLOBAL      20 '@print'
0076    | OP_CONSTANT        21 'no newline at the end'
