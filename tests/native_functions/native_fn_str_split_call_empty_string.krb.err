== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@len'
0002    | OP_GET_GLOBAL       1 '@strSplit'
0004    | OP_CONSTANT         2 ''
0006    | OP_CONSTANT         3 ','
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_PRINT
0013    2 OP_GET_GLOBAL       4 '@strSplit'
0015    | OP_CONSTANT         5 ''
0017    | OP_CONSTANT         6 ','
0019    | OP_CALL             2
0021    | OP_CONSTANT         7 '0'
0023    | OP_GET_INDEX
0024    | OP_CONSTANT         8 ''
0026    | OP_EQUAL
0027    | OP_PRINT
0028    3 OP_NIL
0029    | OP_RETURN
