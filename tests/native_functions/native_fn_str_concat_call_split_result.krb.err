== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       0 '@strConcat'
0002    | OP_GET_GLOBAL       1 '@strSplit'
0004    | OP_CONSTANT         2 'a,b,c'
0006    | OP_CONSTANT         3 ','
0008    | OP_CALL             2
0010    | OP_CALL             1
0012    | OP_PRINT
0013    2 OP_NIL
0014    | OP_RETURN
