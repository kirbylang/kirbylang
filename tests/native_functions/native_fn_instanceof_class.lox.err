== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CLASS            0 'Class'
0002    | OP_DEFINE_GLOBAL    0 'Class'
0004    | OP_GET_GLOBAL       1 'Class'
0006    | OP_POP
0007    3 OP_GET_GLOBAL       2 'instanceOf'
0009    | OP_GET_GLOBAL       3 'Class'
0011    | OP_GET_GLOBAL       4 'Class'
