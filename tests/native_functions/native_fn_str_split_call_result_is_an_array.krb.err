== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       1 '@strSplit'
0002    | OP_CONSTANT         2 'a b c'
0004    | OP_CONSTANT         3 ' '
0006    | OP_CALL             2
0008    | OP_DEFINE_GLOBAL    0 'parts'
0010    2 OP_GET_GLOBAL       4 '@arrJoin'
0012    | OP_GET_GLOBAL       5 'parts'
0014    | OP_CONSTANT         6 '-'
0016    | OP_CALL             2
0018    | OP_PRINT
0019    3 OP_GET_GLOBAL       7 'parts'
0021    | OP_CONSTANT         8 '0.000000'
0023    | OP_GET_INDEX
0024    | OP_PRINT
0025    4 OP_NIL
0026    | OP_RETURN
