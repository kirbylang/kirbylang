== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_GET_GLOBAL       1 '@strSplit'
0002    | OP_CONSTANT         2 'p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11'
0004    | OP_CONSTANT         3 ','
0006    | OP_CALL             2
0008    | OP_DEFINE_GLOBAL    0 'parts'
0010    2 OP_GET_GLOBAL       4 '@len'
0012    | OP_GET_GLOBAL       5 'parts'
0014    | OP_CALL             1
0016    | OP_PRINT
0017    3 OP_GET_GLOBAL       6 '@arrJoin'
0019    | OP_GET_GLOBAL       7 'parts'
0021    | OP_CONSTANT         8 '+'
0023    | OP_CALL             2
0025    | OP_PRINT
0026    4 OP_NIL
0027    | OP_RETURN
