== <script> ==
0000    1 OP_NIL
0001    | OP_RETURN
== <script> ==
0000    1 OP_CONSTANT         1 'Hello'
0002    | OP_CONSTANT         2 ', '
0004    | OP_CONSTANT         3 'World'
0006    | OP_ARRAY            3
0008    | OP_DEFINE_GLOBAL    0 'parts'
0010    3 OP_GET_GLOBAL       4 '@strConcat'
0012    | OP_GET_GLOBAL       0 'parts'
0014    | OP_CALL             1
0016    | OP_PRINT
0017    4 OP_NIL
0018    | OP_RETURN
