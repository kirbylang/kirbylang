#!/usr/bin/env krb -f


if (@argc() != 5) {
  @println("Usage: krb -f examples/cat.krb <file>");
  @exit(1);
}

var fileText = {
  var path = @argv(4);

  if (!@fileExists(path)) {
    @eprintln("File doesn't exist '" + path + "'");
    @exit(1);
  }

  @readFileToString(path)
};

@println(fileText);
