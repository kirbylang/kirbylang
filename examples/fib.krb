#!/usr/bin/env krb -f

fun fib(n: f64): f64 {
  if (n < 2) return n;

  fib(n - 2) + fib(n - 1)
}

@println("Fibonacci");

let arg = @argv(4) ?? @prompt("n: ");
let start = @clock();

let n = @parseNumber(arg);
let result = fib(n);

let end = @clock();
let time_taken = end - start;

@println("Result: " + @numberToString(result));
@println("Time Taken: " + @numberToString(time_taken));
