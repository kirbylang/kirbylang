#!/usr/bin/env krb run

fun fib(n: f64): f64 {
  if (n < 2) return n;

  fib(n - 2) + fib(n - 1)
}

@println("Fibonacci");

let arg: string = @argv(4) ?? @prompt("n: ");
let start = @clock();

print $"{arg}\n";

let n = @parseNumber(arg);

let end = @clock();
let time_taken = end - start;

print $"Result:\n{fib(n)}\n";

print $"Time Taken: {@clock() - start}";
