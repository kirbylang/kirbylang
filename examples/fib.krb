#!/usr/bin/env krb run

fun fib(n: i64): i64 {
  if (n < 2) return n;

  fib(n - 2) + fib(n - 1)
}

@println("Fibonacci");

let arg: string = @argv(1) ?? @prompt("n: ");
let start = @clock();

@println($"{arg}\n");

let n = @parseInt(arg);

let end = @clock();
let time_taken = end - start;

@println($"Result:\n{fib(n)}\n");

@println($"Time Taken: {@clock() - start}");
