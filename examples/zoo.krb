#!/usr/bin/env krb -f

struct Zoo {
  var aardvark;
  var baboon;
  var cat;
  var donkey;
  var elephant;
  var fox;
}

impl Zoo {
  fun init() = Zoo {
    aardvark: 1,
    baboon: 1,
    cat: 1,
    donkey: 1,
    elephant: 1,
    fox: 1,
  };

  fun ant(self) = self.aardvark;
  fun banana(self) = self.baboon;
  fun tuna(self) = self.cat;
  fun hay(self) = self.donkey;
  fun grass(self) = self.elephant;
  fun mouse(self) = self.fox;
}

var zoo = Zoo.init();
var start = clock();

var sum = 0;

while (sum < 100000000) {
  sum = sum + zoo.ant()
            + zoo.banana()
            + zoo.tuna()
            + zoo.hay()
            + zoo.grass()
            + zoo.mouse();
}

print clock() - start;
print sum;
