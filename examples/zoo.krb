#!/usr/bin/env krb -f

struct Zoo {
  var aardvark: u8;
  var baboon: u8;
  var cat: u8;
  var donkey: u8;
  var elephant: u8;
  var fox: u8;
}

impl Zoo {
  pub fun init(): Zoo = Zoo {
    aardvark: 1,
    baboon: 1,
    cat: 1,
    donkey: 1,
    elephant: 1,
    fox: 1,
  };

  pub fun ant(self): f64 = self.aardvark;
  pub fun banana(self): f64 = self.baboon;
  pub fun tuna(self): f64 = self.cat;
  pub fun hay(self): f64 = self.donkey;
  pub fun grass(self): f64 = self.elephant;
  pub fun mouse(self): f64 = self.fox;
}

var zoo = Zoo.init();
var start = clock();

var sum = 0;

while (sum < 100000000) {
  sum = sum + zoo.ant()
            + zoo.banana()
            + zoo.tuna()
            + zoo.hay()
            + zoo.grass()
            + zoo.mouse();
}

print clock() - start;
print sum;
