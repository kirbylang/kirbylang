#!/usr/bin/env krb run

struct Zoo {
  var aardvark: i64;
  var baboon: i64;
  var cat: i64;
  var donkey: i64;
  var elephant: i64;
  var fox: i64;
}

impl Zoo {
  pub fun init(): Zoo = Zoo {
    aardvark: 1,
    baboon: 1,
    cat: 1,
    donkey: 1,
    elephant: 1,
    fox: 1,
  };

  pub fun ant(self): i64 = self.aardvark;
  pub fun banana(self): i64 = self.baboon;
  pub fun tuna(self): i64 = self.cat;
  pub fun hay(self): i64 = self.donkey;
  pub fun grass(self): i64 = self.elephant;
  pub fun mouse(self): i64 = self.fox;
}

var zoo = Zoo.init();
var start = @clock();

var sum = 0;

while (sum < 100000000) {
  sum = sum + zoo.ant()
            + zoo.banana()
            + zoo.tuna()
            + zoo.hay()
            + zoo.grass()
            + zoo.mouse();
}

@println(@clock() - start);
@println(sum);
