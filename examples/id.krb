fun main(): unit {
    let square = fun (n: i64) { n * n };

    let value: i64 = Id.new(100)
        .map(square)
        .flat_map(Id.new)
        .get();

    @println(value);
}

struct Id[T] {
    value: T;
}

impl Id[T] {
    // Create a new instance from a value
    pub fun new(value: T): Self[T] =
        Self { value: value };

    // Get the underlying value
    pub fun get(self): T =
        self.value;
    
    // Apply a function over the value to get a new instance
    pub fun map[U](self, fn: fun (T) => U): Id[U] =
        Self.new(fn(self.value));

    // Apply a function returning a new instance over the value
    pub fun flat_map[U](self, fn: fun (T) => Id[U]): Id[U] =
        fn(self.value);
}

main();
