#!/usr/bin/env krb -f

struct StringBuilder {
    var value: string;
}

impl StringBuilder {
    pub fun new(init: string): Self = Self { value: init };

    pub fun add(self, add: string): Self {
        self.value = self.value + add;

        self
    }
}

impl Default for StringBuilder {
    fun default(): Self = Self.new("");
}

impl Display for StringBuilder {
    fun toString(self): string = self.value;
}

var builder = StringBuilder.default()
    .add("Hello")
    .add(" ")
    .add("World");

print builder.toString();
