#!/usr/bin/env krb -f

struct StringBuilder {
    var parts: Array[string];
}

impl StringBuilder {
    pub fun add(self, part: string): Self {
        arrPush(self.parts, part);

        self
    }
}

impl Default for StringBuilder {
    fun default(): Self = Self { parts: [] };
}

impl Display for StringBuilder {
    fun toString(self): string = arrJoin(self.parts, "");
}

let builder = StringBuilder.default()
    .add("Hello")
    .add(" ")
    .add("World");

print builder.toString();
