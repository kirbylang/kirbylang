#!/usr/bin/env krb -f

struct StringBuilder {
    var string: string;
}

impl StringBuilder {
    pub fun new(): StringBuilder = StringBuilder { string: "" };

    pub fun new_with_init(init: string): StringBuilder =
        StringBuilder { string: init };

    pub fun add(self, string: string): StringBuilder {
        self.string = self.string + string;

        self
    }

    pub fun to_string(self): string = self.string;
}

var builder: StringBuilder = StringBuilder.new()
    .add("Hello")
    .add(" ")
    .add("World");

print builder.to_string();
