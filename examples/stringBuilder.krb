#!/usr/bin/env krb -f

struct StringBuilder {
    var string;
}

impl StringBuilder {
    pub fun new() = StringBuilder { string: "" };

    pub fun new_with_init(init) =
        StringBuilder { string: init };

    pub fun add(self, string) {
        self.string = self.string + string;

        self
    }

    pub fun to_string(self) = self.string;
}

var builder = StringBuilder.new()
    .add("Hello")
    .add(" ")
    .add("World");

print builder.to_string();
