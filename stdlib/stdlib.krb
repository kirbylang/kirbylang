// UTC Date Time
struct Date {
    // Unix timestamp, in whole seconds
    let timestamp: i64;

    let year: i64;
    let month: i64;
    let day: i64;
    let hour: i64;
    let minute: i64;
    let second: i64;
}

impl Date {
    // Create date from a unix timestamp
    pub fun new(timestamp: i64): Self {
        var days = Self.floor_div(timestamp, 86400);
        let sod = timestamp - days * 86400;

        let hour = sod / 3600;
        let minute = (sod % 3600) / 60;
        let second = sod % 60;

        var year = 1970;

        while (true) {
            let ydays = if (Self.is_leap(year)) 366 else 365;

            if (days < ydays) {
                break;
            }

            days = days - ydays;
            year = year + 1;
        }

        var month = 1;

        while (true) {
            let mdays = Self.days_in_month(year, month);

            if (days < mdays) {
                break;
            }

            days = days - mdays;
            month = month + 1;
        }

        Self {
            timestamp: timestamp,
            year: year,
            month: month,
            day: days + 1,
            hour: hour,
            minute: minute,
            second: second,
        }
    }
    
    pub fun now(): Self =
        Self.new(@now());

    pub fun from_parts(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64): Self {
        @assert(year >= 1 and year <= 9999, $"Year must be between 1-9999: {@numberToString(year)}");
        
        let days_in_month = Self.days_in_month(year, month);

        @assert(day >= 1 and day <= days_in_month, $"Day must be between 1-{days_in_month}: {@numberToString(day)}");
        @assert(hour >= 0 and hour <= 23, $"Hour must be between 0-23: {@numberToString(hour)}");
        @assert(minute >= 0 and minute <= 59, $"Minute must be between 0-59: {@numberToString(minute)}");
        @assert(second >= 0 and second <= 59, $"Second must be between 0-59: {@numberToString(second)}");

        Self.new(Self.parts_to_timestamp(year, month, day, hour, minute, second))
    }
    
    pub fun from(value: string): Self {
        let parts: Array = @strSplit(value, " ");
        
        @assert(@arrLen(parts) == 2, $"invalid input string. expected 2 parts but got {@numberToString(@arrLen(parts))}");
        
        let date_part: string = parts[0];
        let time_part: string = parts[1];

        @println($"DEBUG: date_part: {date_part}; time_part: {time_part}");

        let date_parts = @strSplit(date_part, "-");

        @assert(@arrLen(date_parts) == 3, $"invalid input string. expected 3 date parts but got {@numberToString(@arrLen(date_parts))}");

        let year_str: string = date_parts[0];
        let year = @parseInt(year_str);

        let month_str: string = date_parts[1];
        let month = @parseInt(month_str);

        let day_str: string = date_parts[2];
        let day = @parseInt(day_str);

        let time_parts = @strSplit(time_part, ":");

        let time_parts_str: string = @arrJoin(time_parts, ", ");

        @assert(@arrLen(time_parts) == 3,
            $"invalid input string. expected 3 time parts but got {@numberToString(@arrLen(time_parts))}: '{time_parts_str}'");

        let hour_str: string = time_parts[0];
        let hour = @parseInt(hour_str);

        let minute_str: string = time_parts[1];
        let minute = @parseInt(minute_str);

        let second_str: string = time_parts[2];
        let second = @parseInt(second_str);
        
        Self.from_parts(year, month, day, hour, minute, second)
    }

    pub fun get_timestamp(self): i64 = self.timestamp;
    pub fun get_year(self): i64 = self.year;
    pub fun get_month(self): i64 = self.month;
    pub fun get_day(self): i64 = self.day;
    pub fun get_hour(self): i64 = self.hour;
    pub fun get_minute(self): i64 = self.minute;
    pub fun get_second(self): i64 = self.second;

    fun is_leap(year: i64): bool {
        year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
    }

    fun is_valid_month(month: i64): bool = month >= 1 and month <= 12;

    fun days_in_month(year: i64, month: i64): i64 {
        @assert(Self.is_valid_month(month), $"Month must be between 1-12: {@numberToString(month)}");

        let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        
        if (month == 2 and Self.is_leap(year)) {
            return 29;
        }

        lengths[month - 1]
    }

    fun parts_to_timestamp(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64): i64 {
        let days = Self.days_from_civil(year, month, day);

        days * 86400 + hour * 3600 + minute * 60 + second
    }

    // Days since 1970-01-01 for a year of 1 or more
    fun days_from_civil(year: i64, month: i64, day: i64): i64 {
        year = year - if (month <= 2) 1 else 0;
        
        let era = year / 400;

        // Year Of Era [0, 399]
        let yoe = year - era * 400; 
        
        // Day Of Year [0, 365]
        let doy = {
            let month_adjustment = if (month > 2) month - 3 else month + 9;
            
            (153 * month_adjustment + 2) / 5 + day - 1
        };
        
        // Day Of Era [0, 146096]
        let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        
        era * 146097 + doe - 719468
    }

    // Division that rounds down, so a timestamp before 1970 lands on the day
    // before rather than rounding toward 1970
    fun floor_div(a: i64, b: i64): i64 {
        let quotient = a / b;

        if (a % b != 0 and (a < 0) != (b < 0)) quotient - 1 else quotient
    }

    fun pad_zeros(num: i64, length: i64): string {
        var str = @numberToString(num);

        while (@strLen(str) < length) {
            str = "0" + str;
        }

        str
    }
}

impl Display for Date {
    fun toString(self): string { 
        let month = Date.pad_zeros(self.month, 2);
        let day = Date.pad_zeros(self.day, 2);
        let hour = Date.pad_zeros(self.hour, 2);
        let minute = Date.pad_zeros(self.minute, 2);
        let second = Date.pad_zeros(self.second, 2);

        $"{self.year}-{month}-{day} {hour}:{minute}:{second}"
    }
}

impl Ord for Date {
    fun cmp(self, other: Self): i64 = self.timestamp - other.timestamp;
}


impl Eq for Date {
    fun equals(self, other: Self): bool = self.timestamp == other.timestamp;
}
