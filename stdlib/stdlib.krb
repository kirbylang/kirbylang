struct Date {
    let timestamp: f64;
    let year: f64;
    let month: f64;
    let day: f64;
    let hour: f64;
    let minute: f64;
    let second: f64;
}

impl Date {
    pub fun new(timestamp: f64): Self =
        Self.timestamp_to_date(@floor(timestamp));
    
    pub fun now(): Self =
        Self.timestamp_to_date(@now());

    pub fun from_parts(year: f64, month: f64, day: f64, hour: f64, minute: f64, second: f64): Self {
        Self.new(Self.date_to_timestamp(year, month, day, hour, minute, second))
    }
    
    pub fun from(value: string): Self {
        let parts: Array = @strSplit(value, " ");
        
        @assert(@len(parts) == 2, $"invalid input string. expected 2 parts but got {@numberToString(@len(parts))}");
        
        let date_part: string = parts[0];
        let time_part: string = parts[1];

        @println($"DEBUG: date_part: {date_part}; time_part: {time_part}");

        let date_parts = @strSplit(date_part, "-");

        @assert(@len(date_parts) == 3, $"invalid input string. expected 3 date parts but got {@numberToString(@len(date_parts))}");

        let year_str: string = date_parts[0];
        let year: f64 = @parseNumber(year_str);

        let month_str = date_parts[1];
        let month: f64 = @parseNumber(month_str);

        let day_str: string = date_parts[2];
        let day: f64 =@parseNumber(day_str);

        let time_parts = @strSplit(time_part, ":");

        let time_parts_str: string = @arrJoin(time_parts, ", ");

        @assert(@len(time_parts) == 3,
            $"invalid input string. expected 3 time parts but got {@numberToString(@len(time_parts))}: '{time_parts_str}'");

        let hour_str: string = time_parts[0];
        let hour: f64 = @parseNumber(hour_str);

        let minute_str: string = time_parts[1];
        let minute: f64 = @parseNumber(minute_str);

        let second_str: string = time_parts[2];
        let second: f64 = @parseNumber(second_str);
        
        Self {
            timestamp: Self.date_to_timestamp(year, month, day, hour, minute, second),
            year: year,
            month: month,
            day: day,
            hour: hour,
            minute: minute,
            second: second,
        }
    }

    pub fun get_year(self): f64 = self.year;
    pub fun get_month(self): f64 = self.month;
    pub fun get_day(self): f64 = self.day;
    pub fun get_hour(self): f64 = self.hour;
    pub fun get_minute(self): f64 = self.minute;
    pub fun get_second(self): f64 = self.second;

    fun is_leap(year: f64): bool {
        year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
    }

    fun days_in_month(year: f64, month: f64): f64 {
        let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        
        if (month == 2 and Self.is_leap(year)) {
            return 29;
        }

        return lengths[month - 1];
    }

    fun timestamp_to_date(ts: f64): Self {
        var days = ts / 86400;
        let sod  = ts % 86400;

        let hour   = sod / 3600;
        let minute = (sod % 3600) / 60;
        let second = sod % 60;

        var year = 1970;

        while (true) {
            let ydays = if (Self.is_leap(year)) 366 else 365;

            if (days < ydays) {
                break;
            }

            days = days - ydays;
            year = year + 1;
        }

        var month = 1;

        while (true) {
            let mdays = Self.days_in_month(year, month);

            if (days < mdays) {
                break;
            }

            days = days - mdays;
            month = month + 1;
        }

        let day = days + 1;

        return Self {
            timestamp: ts,
            year: year,
            month: @floor(month),
            day: @floor(day),
            hour: @floor(hour),
            minute: @floor(minute),
            second: @floor(second),
        };
    }

    fun date_to_timestamp(year: f64, month: f64, day: f64, hour: f64, minute: f64, second: f64): f64 {
        let days = Self.date_from_civil(year, month, day);

        days * 86400 + hour * 3600 + minute * 60 + second
    }

    fun date_from_civil(year: f64, month: f64, day: f64): f64 {
        year = year - if (month <= 2) 1 else 0;
        
        let era = @floor(
            if (year >= 0) year / 400
            else (year - 399) / 400
        );

        // Year Of Era [0, 399]
        let yoe = year - era * 400; 
        
        // Day Of Year [0, 365]
        let doy = {
            let month_adjustment = if (month > 2) month - 3 else month + 9;
            
            @floor((153 * month_adjustment + 2) / 5) + day - 1 
        };
        
        // Day Of Era [0, 146096]
        let doe = yoe * 365 + @floor(yoe / 4) - @floor(yoe / 100) + doy;             
        
        era * 146097 + doe - 719468
    }

    fun pad_zeros(num: f64, length: f64): string {
        var str = @numberToString(num);

        while (@len(str) < length) {
            str = "0" + str;
        }

        str
    }
}

impl Display for Date {
    fun toString(self): string { 
        let month = Date.pad_zeros(self.month, 2);
        let day = Date.pad_zeros(self.day, 2);
        let hour = Date.pad_zeros(self.hour, 2);
        let minute = Date.pad_zeros(self.minute, 2);
        let second = Date.pad_zeros(self.second, 2);

        $"{self.year}-{month}-{day} {hour}:{minute}:{second}"
    }
}

impl Ord for Date {
    fun cmp(self, other: Self): f64 = self.timestamp - other.timestamp;
}


impl Eq for Date {
    fun equals(self, other: Self): bool = self.timestamp == other.timestamp;
}
