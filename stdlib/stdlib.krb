impl Display for f32 {
    fun toString(self): string = @numberToString(self);
}

impl Eq for f32 {
    fun equals(self, other: Self): bool = self == other;
}

impl Ord for f32 {
    // `NaN` sorts below every number, and level with `NaN`. Only `NaN` is not
    // equal to itself.
    fun cmp(self, other: Self): i64 =
        if (self < other) -1
        else if (self > other) 1
        else if (self == self) (if (other == other) 0 else 1)
        else if (other == other) -1
        else 0;
}

impl Default for f32 {
    fun default(): Self = 0.0f32;
}

impl Add for f32 {
    fun add(self, other: Self): Self = self + other;
}

impl Sub for f32 {
