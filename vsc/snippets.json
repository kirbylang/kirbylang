    "description": "Write a string to a file at a path"
  },
  "Native: @numberToString": {
    "prefix": "@numberToString",
    "body": [
      "@numberToString(${1:value})$0"
    ],
    "description": "Convert a number to a string"
  },
  "Native: @fileExists": {
    "prefix": "@fileExists",
    "body": [
      "@fileExists(${1:path})$0"
    ],
    "description": "Check whether a file or path exists"
  },
  "Native: @getenv": {
    "prefix": "@getenv",
    "body": [
      "@getenv(${1:name})$0"
