{
  "scopeName": "source.krb",
  "patterns": [
    { "include": "#comments" },
    { "include": "#shebang" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#struct-declaration" },
    { "include": "#impl-declaration" },
    { "include": "#trait-declaration" },
    { "include": "#native-declaration" },
    { "include": "#function-declaration" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#natives" },
    { "include": "#primitive-types" },
    { "include": "#struct-initializer" },
    { "include": "#field-name" },
    { "include": "#method-call" },
    { "include": "#property" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.krb",
      "match": "//.*$"
    },
    "shebang": {
      "name": "comment.line.double-slash.krb",
      "match": "#!.*$"
    },
    "strings": {
      "name": "string.quoted.double.krb",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.krb",
          "match": "\\\\[nrt\"\\\\]"
        },
        {
          "name": "invalid.illegal.unknown-escape.krb",
          "match": "\\\\."
        }
      ]
    },
    "interpolated-strings": {
      "name": "string.quoted.double.interpolated.krb",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.krb",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "constant.character.escape.krb",
          "match": "\\\\[nrt\"\\\\]"
        },
        {
          "name": "invalid.illegal.unknown-escape.krb",
          "match": "\\\\."
        },
        {
          "name": "invalid.illegal.single-brace.krb",
          "match": "}"
        },
        {
          "name": "meta.embedded.placeholder.krb",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.krb" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.krb" }
          },
          "contentName": "source.krb",
          "patterns": [
            { "include": "#placeholder-braces" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "placeholder-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#placeholder-braces" },
        { "include": "$self" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.krb",
      "match": "\\b\\d+(\\.\\d+)?([fF](32|64)|[iIuU](8|16|32|64))?\\b"
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.struct.krb" },
        "2": { "name": "entity.name.type.struct.krb" }
      }
    },
    "impl-declaration": {
      "patterns": [
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(for)\\s+(string|bool|unit|[iu](?:8|16|32|64)|f(?:32|64))\\b",
          "captures": {
            "1": { "name": "keyword.declaration.impl.krb" },
            "2": { "name": "entity.name.type.trait.krb" },
            "3": { "name": "keyword.other.for.krb" },
            "4": { "name": "support.type.primitive.krb" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.krb" },
            "2": { "name": "entity.name.type.trait.krb" },
            "3": { "name": "keyword.other.for.krb" },
            "4": { "name": "entity.name.type.struct.krb" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(for)(?=\\s*\\[)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.krb" },
            "2": { "name": "entity.name.type.trait.krb" },
            "3": { "name": "keyword.other.for.krb" }
          }
        },
        {
          "match": "\\b(impl)\\s+(string|bool|unit|[iu](?:8|16|32|64)|f(?:32|64))\\b",
          "captures": {
            "1": { "name": "keyword.declaration.impl.krb" },
            "2": { "name": "support.type.primitive.krb" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.krb" },
            "2": { "name": "entity.name.type.struct.krb" }
          }
        },
        {
          "match": "\\b(impl)(?=\\s*\\[)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.krb" }
          }
        }
      ]
    },
    "trait-declaration": {
      "match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.trait.krb" },
        "2": { "name": "entity.name.type.trait.krb" }
      }
    },
    "function-declaration": {
      "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.krb" },
        "2": { "name": "entity.name.function.krb" }
      }
    },
    "native-declaration": {
      "begin": "\\b(native)\\s+(fun)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.krb" },
        "2": { "name": "keyword.declaration.krb" }
      },
      "end": ";",
      "patterns": [{ "include": "#native-signature" }]
    },
    "native-signature": {
      "patterns": [
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [{ "include": "#native-signature" }]
        },
        {
          "name": "support.type.primitive.krb",
          "match": "(?<!@)\\b(number|integer)\\b(?!\\s*:)"
        },
        { "include": "$self" }
      ]
    },
    "primitive-types": {
      "name": "support.type.primitive.krb",
      "match": "(?<![.@])\\b(string|bool|unit|[iu](8|16|32|64)|f(32|64))\\b(?!\\s*[:(])"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.krb",
          "match": "\\b(if|else|for|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.krb",
          "match": "\\b(var|let|pub|fun|struct|impl|type|native)\\b"
        },
        {
          "name": "keyword.operator.logical.krb",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.other.cast.krb",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.other.print.krb",
          "match": "\\bprint\\b"
        },
        {
          "name": "variable.language.self.krb",
          "match": "\\bself\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.krb",
      "match": "\\b(true|false|nil|Self)\\b"
    },
    "natives": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*\\b)",
      "captures": {
        "1": { "name": "markup.bold.prefix.native.krb" },
        "2": { "name": "entity.name.function.native.krb" }
      }
    },
    "struct-initializer": {
      "name": "entity.name.type.struct.krb",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\{)"
    },
    "field-name": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "variable.other.property.krb" },
        "2": { "name": "punctuation.separator.key-value.krb" }
      }
    },
    "method-call": {
      "name": "entity.name.function.method.krb",
      "match": "(?<=[A-Za-z0-9_\\]\\)\"}]\\s*\\.\\s*)\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
    },
    "property": {
      "name": "variable.name.property.krb",
      "match": "(?<=[A-Za-z_][A-Za-z0-9_]*\\s*\\.\\s*)\\b[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*\\()"
    },
    "function-call": {
      "name": "entity.name.function.krb",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.krb",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.krb",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.nullish.krb",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.assignment.krb",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.krb",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    }
  }
}
